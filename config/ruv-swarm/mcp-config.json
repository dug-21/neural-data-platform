{
  "mcp": {
    "mode": "tcp",
    "port": 8080,
    "host": "0.0.0.0",
    "auth": {
      "enabled": false,
      "token": "your-secret-token"
    },
    "tls": {
      "enabled": false,
      "cert": "/app/certs/server.crt",
      "key": "/app/certs/server.key"
    }
  },
  "swarm": {
    "maxAgents": 20,
    "maxSwarms": 5,
    "memoryLimit": "2GB",
    "persistence": {
      "enabled": true,
      "path": "/app/data/swarms.db"
    }
  },
  "monitoring": {
    "enabled": true,
    "metrics": {
      "port": 9090,
      "path": "/metrics"
    }
  }
}
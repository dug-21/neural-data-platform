{
  "uid": "ndp-weather-reliability",
  "title": "Weather Source Reliability (NWS vs OWM)",
  "tags": ["ndp", "weather", "comparison", "exploration"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Source Stats",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "NWS Record Count (24h)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT COUNT(*) as \"value\" FROM read_parquet('/data/data/nws-observations/**/*.parquet') WHERE timestamp >= (EXTRACT(EPOCH FROM NOW() - INTERVAL '24 hours') * 1000000)::BIGINT",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "green", "value": 500}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OWM Record Count (24h)",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT COUNT(*) as \"value\" FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= (EXTRACT(EPOCH FROM NOW() - INTERVAL '24 hours') * 1000000)::BIGINT",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "green", "value": 500}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "NWS Last Update",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT to_timestamp(MAX(timestamp)/1000000) as \"time\" FROM read_parquet('/data/data/nws-observations/**/*.parquet')",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": -3600},
              {"color": "red", "value": -7200}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "OWM Last Update",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT to_timestamp(MAX(timestamp)/1000000) as \"time\" FROM read_parquet('/data/data/outdoor-weather/**/*.parquet')",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": -3600},
              {"color": "red", "value": -7200}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Temperature Comparison (NWS vs OWM)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH nws AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'temperature' THEN value END) as temp FROM read_parquet('/data/data/nws-observations/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1), owm AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'temperature' THEN value END) as temp FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1) SELECT COALESCE(n.bucket, o.bucket) as time, n.temp as \"NWS Temperature\", o.temp as \"OWM Temperature\" FROM nws n FULL OUTER JOIN owm o ON n.bucket = o.bucket ORDER BY time",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull", "min", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "celsius",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "NWS Temperature"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "OWM Temperature"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperature Divergence (Absolute Difference)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH nws AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'temperature' THEN value END) as temp FROM read_parquet('/data/data/nws-observations/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1), owm AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'temperature' THEN value END) as temp FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1) SELECT COALESCE(n.bucket, o.bucket) as time, ABS(n.temp - o.temp) as \"Divergence °C\" FROM nws n FULL OUTER JOIN owm o ON n.bucket = o.bucket WHERE n.temp IS NOT NULL AND o.temp IS NOT NULL ORDER BY time",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "celsius",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "orange", "value": 2},
              {"color": "red", "value": 3}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Divergence °C"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Humidity Comparison",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH nws AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'relative_humidity' THEN value END) as humidity FROM read_parquet('/data/data/nws-observations/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1), owm AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'humidity' THEN value END) as humidity FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1) SELECT COALESCE(n.bucket, o.bucket) as time, n.humidity as \"NWS Humidity\", o.humidity as \"OWM Humidity\" FROM nws n FULL OUTER JOIN owm o ON n.bucket = o.bucket ORDER BY time",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "NWS Humidity"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "OWM Humidity"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Wind Speed Comparison (km/h)",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH nws AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'wind_speed' THEN value END) as wind_speed FROM read_parquet('/data/data/nws-observations/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1), owm AS (SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as bucket, AVG(CASE WHEN metric = 'wind_speed' THEN value * 3.6 END) as wind_speed FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1) SELECT COALESCE(n.bucket, o.bucket) as time, n.wind_speed as \"NWS Wind Speed (km/h)\", o.wind_speed as \"OWM Wind Speed (km/h)\" FROM nws n FULL OUTER JOIN owm o ON n.bucket = o.bucket ORDER BY time",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "velocitykmh",
          "decimals": 1,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "NWS Wind Speed (km/h)"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "OWM Wind Speed (km/h)"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "heatmap",
      "title": "Data Availability Heatmap",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH hourly_data AS (SELECT time_bucket(INTERVAL '1 hour', to_timestamp(timestamp/1000000)) as hour, 'NWS' as source, COUNT(*) as record_count FROM read_parquet('/data/data/nws-observations/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 UNION ALL SELECT time_bucket(INTERVAL '1 hour', to_timestamp(timestamp/1000000)) as hour, 'OWM' as source, COUNT(*) as record_count FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1) SELECT hour as time, source, record_count as \"Records\" FROM hourly_data ORDER BY hour, source",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "calculation": {},
        "cellGap": 2,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-9
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "short"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      }
    }
  ]
}

{
  "uid": "ndp-outdoor-air-quality",
  "title": "Outdoor Air Quality Monitoring",
  "tags": ["ndp", "outdoor", "air-quality"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 2,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Current AQI",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT AVG(value) as value FROM (SELECT value FROM read_parquet('/data/data/outdoor-air-quality/**/*.parquet') WHERE metric = 'aqi' ORDER BY timestamp DESC LIMIT 100)",
          "refId": "A"
        }
      ],
      "options": {"showThresholdLabels": true, "showThresholdMarkers": true, "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"min": 0, "max": 500, "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 51}, {"color": "orange", "value": 101}, {"color": "red", "value": 151}, {"color": "purple", "value": 201}, {"color": "dark-red", "value": 301}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current PM2.5",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT AVG(value) as value FROM (SELECT value FROM read_parquet('/data/data/outdoor-air-quality/**/*.parquet') WHERE metric = 'pm2_5' ORDER BY timestamp DESC LIMIT 100)",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "conc", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 12}, {"color": "orange", "value": 35}, {"color": "red", "value": 55}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current PM10",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT AVG(value) as value FROM (SELECT value FROM read_parquet('/data/data/outdoor-air-quality/**/*.parquet') WHERE metric = 'pm10' ORDER BY timestamp DESC LIMIT 100)",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "conc", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 100}]}}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AQI Trend",
      "gridPos": {"x": 8, "y": 4, "w": 16, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(value) as \"US AQI\" FROM read_parquet('/data/data/outdoor-air-quality/**/*.parquet') WHERE metric = 'aqi' AND timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 20}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 51}, {"color": "orange", "value": 101}, {"color": "red", "value": 151}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PM2.5 Levels",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(value) as \"Outdoor PM2.5\" FROM read_parquet('/data/data/outdoor-air-quality/**/*.parquet') WHERE metric = 'pm2_5' AND timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"unit": "conc", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 20}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 12}, {"color": "orange", "value": 35}, {"color": "red", "value": 55}]}}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pollutant Breakdown",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'pm2_5' THEN value END) as \"PM2.5\", AVG(CASE WHEN metric = 'pm10' THEN value END) as \"PM10\", AVG(CASE WHEN metric = 'no2' THEN value END) as \"NO2\", AVG(CASE WHEN metric = 'o3' THEN value END) as \"O3\", AVG(CASE WHEN metric = 'co' THEN value END) as \"CO\", AVG(CASE WHEN metric = 'so2' THEN value END) as \"SO2\" FROM read_parquet('/data/data/outdoor-air-quality/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"unit": "conc", "custom": {"drawStyle": "line", "lineWidth": 1}}}
    }
  ]
}

{
  "uid": "ndp-outdoor-air-quality",
  "title": "Outdoor Air Quality Monitoring",
  "tags": ["ndp", "outdoor", "air-quality"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Current AQI",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    avg_us_aqi AS \"value\",\n    time AS \"time\"\nFROM readings_hourly\nWHERE stream_id = 'outdoor-air-quality'\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 500,
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 51},
              {"color": "orange", "value": 101},
              {"color": "red", "value": 151},
              {"color": "purple", "value": 201},
              {"color": "dark-red", "value": 301}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current PM2.5",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    avg_pm2_5 AS \"value\",\n    time AS \"time\"\nFROM readings_hourly\nWHERE stream_id = 'outdoor-air-quality'\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µg/m³",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 12},
              {"color": "orange", "value": 35},
              {"color": "red", "value": 55}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current PM10",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    avg_pm10 AS \"value\",\n    time AS \"time\"\nFROM readings_hourly\nWHERE stream_id = 'outdoor-air-quality'\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µg/m³",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AQI Trend",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    time,\n    avg_us_aqi AS \"US AQI\"\nFROM readings_hourly\nWHERE\n    stream_id = 'outdoor-air-quality'\n    AND time >= $__timeFrom * 1000\n    AND time <= $__timeTo * 1000\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 51},
              {"color": "orange", "value": 101},
              {"color": "red", "value": 151}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PM2.5 Levels",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    time,\n    avg_pm2_5 AS \"Outdoor PM2.5 (µg/m³)\"\nFROM readings_hourly\nWHERE\n    stream_id = 'outdoor-air-quality'\n    AND time >= $__timeFrom * 1000\n    AND time <= $__timeTo * 1000\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "µg/m³",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 12},
              {"color": "orange", "value": 35},
              {"color": "red", "value": 55}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pollutant Breakdown",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    time,\n    avg_pm2_5 AS \"PM2.5\",\n    avg_pm10 AS \"PM10\",\n    avg_no2 AS \"NO2\",\n    avg_o3 AS \"O3\",\n    avg_co AS \"CO\",\n    avg_so2 AS \"SO2\"\nFROM readings_hourly\nWHERE\n    stream_id = 'outdoor-air-quality'\n    AND time >= $__timeFrom * 1000\n    AND time <= $__timeTo * 1000\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "µg/m³"
        }
      }
    }
  ]
}

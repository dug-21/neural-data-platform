    {
      "id": 19,
      "type": "table",
      "title": "Refresh Status (CA Jobs)",
      "description": "Continuous aggregate refresh job status from TimescaleDB",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 4},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Continuous aggregate refresh job status\nSELECT\n    COALESCE(\n        (SELECT ht.hypertable_name\n         FROM timescaledb_information.continuous_aggregates ca\n         JOIN timescaledb_information.hypertables ht\n           ON ht.hypertable_schema = ca.materialization_hypertable_schema\n          AND ht.hypertable_name = ca.materialization_hypertable_name\n         WHERE ht.hypertable_id::text = j.config->>'hypertable_id'),\n        j.config->>'hypertable_id'\n    ) AS \"Table\",\n    j.schedule_interval AS \"Interval\",\n    js.last_run_status AS \"Last Status\",\n    js.last_successful_finish AS \"Last Success\",\n    js.total_runs AS \"Total Runs\"\nFROM timescaledb_information.job_stats js\nJOIN timescaledb_information.jobs j ON js.job_id = j.job_id\nWHERE j.proc_name = 'policy_refresh_continuous_aggregate'\nORDER BY \"Table\"",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {"show": false}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {"type": "auto"}
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Last Status"},
            "properties": [
              {"id": "custom.align", "value": "center"},
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"Success": {"text": "Success", "color": "green"}}},
                  {"type": "value", "options": {"Failed": {"text": "Failed", "color": "red"}}}
                ]
              },
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Last Success"},
            "properties": [
              {"id": "unit", "value": "dateTimeAsIso"}
            ]
          }
        ]
      }
    },

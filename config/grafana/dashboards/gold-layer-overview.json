{
  "uid": "ndp-gold-layer-overview",
  "title": "Gold Layer Overview",
  "description": "Visibility into all Gold layer continuous aggregates, unified events, and objectives",
  "tags": ["ndp", "gold", "events", "objectives", "phase-e"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "stream",
        "type": "query",
        "label": "Stream",
        "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
        "query": "SELECT DISTINCT stream_id FROM gold.events_unified ORDER BY stream_id",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "entity",
        "type": "query",
        "label": "Entity",
        "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
        "query": "SELECT DISTINCT entity_id FROM gold.events_unified WHERE stream_id LIKE '$stream' ORDER BY entity_id",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "event_type",
        "type": "custom",
        "label": "Event Type",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {"text": "All", "value": "$__all", "selected": true},
          {"text": "State Transition", "value": "state_transition", "selected": false},
          {"text": "Threshold Crossing", "value": "threshold_crossing", "selected": false}
        ],
        "query": "state_transition,threshold_crossing",
        "includeAll": true,
        "allValue": "%"
      },
      {
        "name": "objective",
        "type": "query",
        "label": "Objective",
        "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
        "query": "SELECT DISTINCT details->>'objective_id' AS objective FROM gold.events_unified WHERE event_type = 'threshold_crossing' AND details->>'objective_id' IS NOT NULL ORDER BY 1",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Unified Events",
        "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "rawQuery": "SELECT\n    event_time AS time,\n    event_type AS title,\n    CASE event_type\n        WHEN 'state_transition' THEN\n            details->>'from_state' || ' -> ' || details->>'to_state'\n        WHEN 'threshold_crossing' THEN\n            details->>'metric' || ' ' || details->>'direction' || ' ' ||\n            (details->>'threshold')::text\n    END AS text,\n    CASE event_type\n        WHEN 'state_transition' THEN 'State'\n        WHEN 'threshold_crossing' THEN 'Threshold'\n    END AS tags\nFROM gold.events_unified\nWHERE event_time >= $__timeFrom() AND event_time <= $__timeTo()\n    AND stream_id LIKE '$stream'\n    AND entity_id LIKE '$entity'\n    AND event_type LIKE '$event_type'\nORDER BY event_time"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Air Quality Metrics (Gold Aggregates)",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "collapsed": false
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Indoor PM2.5",
      "description": "PM2.5 mean from gold.air_quality_hourly with EPA threshold at 12 ug/m3",
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 8},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Indoor PM2.5 from Gold layer hourly aggregate\n-- Threshold line at 12 ug/m3 (EPA Good/Moderate boundary)\nSELECT\n    bucket AS time,\n    pm25_mean AS \"PM2.5\",\n    pm25_max AS \"Max\",\n    pm25_min AS \"Min\"\nFROM gold.air_quality_hourly\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "conc",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 12},
              {"color": "orange", "value": 35},
              {"color": "red", "value": 55}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "PM2.5"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Max"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Min"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Indoor CO2",
      "description": "CO2 mean from gold.air_quality_hourly with threshold at 800 ppm",
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 8},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Indoor CO2 from Gold layer hourly aggregate\n-- Threshold line at 800 ppm (healthy_co2 objective)\nSELECT\n    bucket AS time,\n    co2_mean AS \"CO2\",\n    co2_max AS \"Max\",\n    co2_min AS \"Min\"\nFROM gold.air_quality_hourly\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 800},
              {"color": "red", "value": 1200}
            ]
          },
          "min": 400
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "CO2"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Max"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Min"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature & Humidity",
      "description": "Dual-axis: Temperature (left) and Humidity (right) from gold.air_quality_hourly",
      "gridPos": {"x": 12, "y": 1, "w": 6, "h": 8},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Temperature and Humidity from Gold layer\n-- Dual-axis visualization\nSELECT\n    bucket AS time,\n    temp_mean AS \"Temperature\",\n    humidity_mean AS \"Humidity\"\nFROM gold.air_quality_hourly\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Temperature"},
            "properties": [
              {"id": "unit", "value": "celsius"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}},
              {"id": "custom.axisPlacement", "value": "left"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Humidity"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "min", "value": 0},
              {"id": "max", "value": 100}
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sample Quality",
      "description": "Sample count and data completeness from gold.air_quality_hourly",
      "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Sample count and completeness for latest hour\n-- Expected: ~60 samples per hour (1 per minute)\nSELECT\n    sample_count AS \"Samples\",\n    ROUND((sample_count::numeric / 60.0) * 100, 1) AS \"Completeness %\"\nFROM gold.air_quality_hourly\nORDER BY bucket DESC\nLIMIT 1",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^Samples$/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 30},
              {"color": "green", "value": 50}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Data Completeness",
      "description": "Percentage of expected samples received",
      "gridPos": {"x": 18, "y": 5, "w": 6, "h": 4},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Data completeness percentage\n-- 60 samples/hour expected\nSELECT\n    ROUND((sample_count::numeric / 60.0) * 100, 1) AS value\nFROM gold.air_quality_hourly\nORDER BY bucket DESC\nLIMIT 1",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "green", "value": 80}
            ]
          }
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Cross-Stream Alignment",
      "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1},
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Aligned Streams",
      "description": "Indoor + outdoor + weather data aligned on common time axis",
      "gridPos": {"x": 0, "y": 10, "w": 8, "h": 8},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Multi-stream aligned view from Gold layer\n-- Shows indoor, outdoor PM2.5 and temperature on aligned time axis\nSELECT\n    bucket AS time,\n    indoor_pm25_mean AS \"Indoor PM2.5\",\n    outdoor_pm25_mean AS \"Outdoor PM2.5\",\n    outdoor_temp_mean AS \"Outdoor Temp\",\n    indoor_co2_mean / 100 AS \"CO2 (div 100)\"  -- Scaled for overlay\nFROM gold.indoor_air_quality_aligned\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Indoor PM2.5"},
            "properties": [
              {"id": "unit", "value": "conc"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Outdoor PM2.5"},
            "properties": [
              {"id": "unit", "value": "conc"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Outdoor Temp"},
            "properties": [
              {"id": "unit", "value": "celsius"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}},
              {"id": "custom.axisPlacement", "value": "right"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "CO2 (div 100)"},
            "properties": [
              {"id": "unit", "value": "none"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [5, 5]}}
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Indoor vs Outdoor PM2.5",
      "description": "Compare indoor and outdoor PM2.5 levels with I/O ratio",
      "gridPos": {"x": 8, "y": 10, "w": 8, "h": 8},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Indoor vs Outdoor PM2.5 comparison from Gold aligned view\nSELECT\n    bucket AS time,\n    indoor_pm25_mean AS \"Indoor PM2.5\",\n    outdoor_pm25_mean AS \"Outdoor PM2.5\",\n    CASE\n        WHEN outdoor_pm25_mean > 0 THEN\n            ROUND((indoor_pm25_mean / outdoor_pm25_mean)::numeric, 2)\n        ELSE NULL\n    END AS \"I/O Ratio\"\nFROM gold.indoor_air_quality_aligned\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "conc",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 12}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Indoor PM2.5"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Outdoor PM2.5"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "I/O Ratio"},
            "properties": [
              {"id": "unit", "value": "none"},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.drawStyle", "value": "line"},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [5, 5]}},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Weather Context",
      "description": "Temperature, humidity, and pressure from gold.outdoor_weather_hourly",
      "gridPos": {"x": 16, "y": 10, "w": 8, "h": 4},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Weather context from Gold layer outdoor weather aggregate\nSELECT\n    bucket AS time,\n    temp_mean AS \"Temperature\",\n    humidity_mean AS \"Humidity\",\n    pressure_mean / 10 AS \"Pressure (div 10)\"  -- Scaled for overlay\nFROM gold.outdoor_weather_hourly\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Temperature"},
            "properties": [
              {"id": "unit", "value": "celsius"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Humidity"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}},
              {"id": "custom.axisPlacement", "value": "right"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Pressure (div 10)"},
            "properties": [
              {"id": "unit", "value": "none"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [3, 3]}}
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "State Timeline",
      "description": "Binary state visualization from gold.home_assistant_state_hourly",
      "gridPos": {"x": 16, "y": 14, "w": 8, "h": 4},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- State timeline from Gold layer Home Assistant aggregate\n-- Shows last known state per hour\nSELECT\n    bucket AS time,\n    entity_id,\n    CASE last_state\n        WHEN 'on' THEN 1\n        WHEN 'off' THEN 0\n        ELSE NULL\n    END AS state\nFROM gold.home_assistant_state_hourly\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "showValue": "auto",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "center"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Off", "color": "dark-green", "index": 0}}},
            {"type": "value", "options": {"1": {"text": "On", "color": "yellow", "index": 1}}}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "dark-green", "value": null},
              {"color": "yellow", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Events & Objectives",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 1},
      "collapsed": false
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Unified Events Timeline",
      "description": "State transitions and threshold crossings by hour from gold.events_hourly",
      "gridPos": {"x": 0, "y": 19, "w": 8, "h": 8},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Event counts by hour from Gold layer events aggregate\nSELECT\n    bucket AS time,\n    state_transition_count AS \"State Transitions\",\n    threshold_crossing_count AS \"Threshold Crossings\"\nFROM gold.events_hourly\nWHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\nORDER BY bucket",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",

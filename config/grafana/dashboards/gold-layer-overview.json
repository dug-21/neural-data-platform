      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Gold layer table sizes\nSELECT\n    SUM(pg_total_relation_size(format('gold.%I', table_name)::regclass)) AS value\nFROM information_schema.tables\nWHERE table_schema = 'gold'\n    AND table_type = 'VIEW'",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",

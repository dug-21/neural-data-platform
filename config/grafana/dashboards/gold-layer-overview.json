    {
      "id": 16,
      "type": "barchart",
      "title": "Sample Counts per Stream",
      "description": "Hourly sample counts from Gold layer aggregates",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 8},
      "datasource": {"type": "postgres", "uid": "ndp-timescaledb"},
      "targets": [
        {
          "rawSql": "-- Sample counts per stream per hour\nWITH stream_samples AS (\n    SELECT\n        bucket AS time,\n        'Air Quality' AS stream,\n        sample_count\n    FROM gold.air_quality_hourly\n    WHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\n    UNION ALL\n    SELECT\n        bucket AS time,\n        'Outdoor Weather' AS stream,\n        sample_count\n    FROM gold.outdoor_weather_hourly\n    WHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\n    UNION ALL\n    SELECT\n        bucket AS time,\n        'Home Assistant' AS stream,\n        sample_count\n    FROM gold.home_assistant_state_hourly\n    WHERE bucket >= $__timeFrom() AND bucket <= $__timeTo()\n)\nSELECT\n    time,\n    stream,\n    sample_count\nFROM stream_samples\nORDER BY time, stream",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },

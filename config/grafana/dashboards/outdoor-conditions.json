{
  "uid": "ndp-outdoor-conditions",
  "title": "Outdoor Weather Conditions",
  "tags": ["ndp", "outdoor", "weather"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 2,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current Temperature",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT AVG(value) as value FROM (SELECT value FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE metric = 'temperature' ORDER BY timestamp DESC LIMIT 100)",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Feels Like",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT AVG(value) as value FROM (SELECT value FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE metric = 'feels_like' ORDER BY timestamp DESC LIMIT 100)",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Wind Speed",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT AVG(value) as value FROM (SELECT value FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE metric = 'wind_speed' ORDER BY timestamp DESC LIMIT 100)",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "velocityms", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Humidity",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT AVG(value) as value FROM (SELECT value FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE metric = 'humidity' ORDER BY timestamp DESC LIMIT 100)",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 0}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperature Trend",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'temperature' THEN value END) as \"Temperature\", AVG(CASE WHEN metric = 'feels_like' THEN value END) as \"Feels Like\" FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"unit": "celsius", "custom": {"drawStyle": "line", "lineWidth": 2}}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Wind & Pressure",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'wind_speed' THEN value END) as \"Wind Speed\", AVG(CASE WHEN metric = 'pressure' THEN value END) as \"Pressure\" FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": [{"matcher": {"id": "byName", "options": "Wind Speed"}, "properties": [{"id": "unit", "value": "velocityms"}, {"id": "custom.axisPlacement", "value": "left"}]}, {"matcher": {"id": "byName", "options": "Pressure"}, "properties": [{"id": "unit", "value": "pressurehpa"}, {"id": "custom.axisPlacement", "value": "right"}]}]}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cloud Cover",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'clouds' THEN value END) as \"Cloud Cover\" FROM read_parquet('/data/data/outdoor-weather/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 30}}}
    }
  ]
}

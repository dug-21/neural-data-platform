{
  "uid": "ndp-outdoor-conditions",
  "title": "Outdoor Weather Conditions",
  "tags": ["ndp", "outdoor", "weather"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current Temperature",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    avg_temperature AS \"value\",\n    time AS \"time\"\nFROM readings_hourly\nWHERE stream_id = 'outdoor-weather'\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Feels Like",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    avg_apparent_temperature AS \"value\",\n    time AS \"time\"\nFROM readings_hourly\nWHERE stream_id = 'outdoor-weather'\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "orange", "value": null}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Wind Speed",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    avg_wind_speed AS \"value\",\n    time AS \"time\"\nFROM readings_hourly\nWHERE stream_id = 'outdoor-weather'\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocityms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "orange", "value": 10},
              {"color": "red", "value": 15}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Humidity",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    avg_humidity AS \"value\",\n    time AS \"time\"\nFROM readings_hourly\nWHERE stream_id = 'outdoor-weather'\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperature Trend",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    time,\n    avg_temperature AS \"Temperature (°C)\",\n    avg_apparent_temperature AS \"Feels Like (°C)\"\nFROM readings_hourly\nWHERE\n    stream_id = 'outdoor-weather'\n    AND time >= $__timeFrom * 1000\n    AND time <= $__timeTo * 1000\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Temperature (°C)"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"fill": "solid"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Feels Like (°C)"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Wind & Pressure",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    time,\n    avg_wind_speed AS \"Wind Speed (m/s)\",\n    avg_pressure AS \"Pressure (hPa)\"\nFROM readings_hourly\nWHERE\n    stream_id = 'outdoor-weather'\n    AND time >= $__timeFrom * 1000\n    AND time <= $__timeTo * 1000\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Wind Speed (m/s)"},
            "properties": [
              {"id": "unit", "value": "velocityms"},
              {"id": "custom.axisPlacement", "value": "left"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Pressure (hPa)"},
            "properties": [
              {"id": "unit", "value": "pressurehpa"},
              {"id": "custom.axisPlacement", "value": "right"}
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cloud Cover",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT\n    time,\n    avg_cloud_cover AS \"Cloud Cover (%)\"\nFROM readings_hourly\nWHERE\n    stream_id = 'outdoor-weather'\n    AND time >= $__timeFrom * 1000\n    AND time <= $__timeTo * 1000\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "percent"
        }
      }
    }
  ]
}

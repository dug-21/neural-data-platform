{
  "uid": "ndp-outdoor-conditions",
  "title": "Outdoor Weather Conditions",
  "tags": ["ndp", "outdoor", "weather"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current Temperature",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT avg_temperature AS \"value\", epoch(bucket) AS \"time\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' ORDER BY bucket DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Feels Like",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT avg_apparent_temperature AS \"value\", epoch(bucket) AS \"time\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' ORDER BY bucket DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Wind Speed",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT avg_wind_speed AS \"value\", epoch(bucket) AS \"time\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' ORDER BY bucket DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "velocityms", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Humidity",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT avg_humidity AS \"value\", epoch(bucket) AS \"time\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' ORDER BY bucket DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "options": {"graphMode": "area", "colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 0}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperature Trend",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT epoch(bucket) AS time, avg_temperature AS \"Temperature\", avg_apparent_temperature AS \"Feels Like\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) ORDER BY bucket",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"unit": "celsius", "custom": {"drawStyle": "line", "lineWidth": 2}}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Wind & Pressure",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT epoch(bucket) AS time, avg_wind_speed AS \"Wind Speed\", avg_pressure AS \"Pressure\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) ORDER BY bucket",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": [{"matcher": {"id": "byName", "options": "Wind Speed"}, "properties": [{"id": "unit", "value": "velocityms"}, {"id": "custom.axisPlacement", "value": "left"}]}, {"matcher": {"id": "byName", "options": "Pressure"}, "properties": [{"id": "unit", "value": "pressurehpa"}, {"id": "custom.axisPlacement", "value": "right"}]}]}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cloud Cover",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT epoch(bucket) AS time, avg_cloud_cover AS \"Cloud Cover\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) ORDER BY bucket",
          "refId": "A"
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 30}}}
    }
  ]
}

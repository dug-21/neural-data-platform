{
  "uid": "ndp-anomaly-detection",
  "title": "Anomaly Detection & Data Profiling",
  "tags": ["ndp", "anomaly", "data-quality", "exploration"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Invalid PM2.5 Values",
      "description": "Count of PM2.5 values outside valid range (0-500 µg/m³)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT COUNT(*) as value FROM read_parquet('/data/data/**/*.parquet') WHERE metric = 'pm02' AND (value < 0 OR value > 500) AND timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Invalid Temperature Values",
      "description": "Count of temperature values outside valid range (-50 to 60°C)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT COUNT(*) as value FROM read_parquet('/data/data/**/*.parquet') WHERE metric IN ('atmp', 'temperature') AND (value < -50 OR value > 60) AND timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Invalid Humidity Values",
      "description": "Count of humidity values outside valid range (0-100%)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT COUNT(*) as value FROM read_parquet('/data/data/**/*.parquet') WHERE metric IN ('rhum', 'humidity') AND (value < 0 OR value > 100) AND timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Missing/Null Values",
      "description": "Count of missing or null readings across all metrics",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT COUNT(*) as value FROM read_parquet('/data/data/**/*.parquet') WHERE value IS NULL AND timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 100}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PM2.5 with EPA Thresholds",
      "description": "PM2.5 levels with EPA air quality thresholds (Good: <12, Moderate: 12-35, Unhealthy: 35-55, Very Unhealthy: >55)",
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'pm02' THEN value END) as \"PM2.5\" FROM read_parquet('/data/data/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "conc",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 12},
              {"color": "orange", "value": 35},
              {"color": "red", "value": 55}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "PM2.5"},
            "properties": [
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "area"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CO2 with Indoor Air Quality Thresholds",
      "description": "CO2 levels with indoor air quality thresholds (Good: <1000, Poor: 1000-2000, Bad: >2000)",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT time_bucket(INTERVAL '10 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'rco2' THEN value END) as \"CO2\" FROM read_parquet('/data/data/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1000},
              {"color": "red", "value": 2000}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "CO2"},
            "properties": [
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "area"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Spike Detection - PM2.5 Rate of Change",
      "description": "Detects sudden spikes in PM2.5 by showing absolute rate of change between consecutive readings",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "WITH pm25_data AS (SELECT time_bucket(INTERVAL '5 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'pm02' THEN value END) as pm25 FROM read_parquet('/data/data/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1) SELECT time, pm25 as \"PM2.5\", ABS(pm25 - LAG(pm25, 1) OVER (ORDER BY time)) as \"Rate of Change\" FROM pm25_data WHERE pm25 IS NOT NULL ORDER BY time",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "PM2.5"},
            "properties": [
              {"id": "unit", "value": "conc"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}},
              {"id": "custom.axisPlacement", "value": "left"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Rate of Change"},
            "properties": [
              {"id": "unit", "value": "conc"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.lineWidth", "value": 2},
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "transparent", "value": null},
                    {"color": "red", "value": 10}
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spike Detection - CO2 Rate of Change",
      "description": "Detects sudden spikes in CO2 by showing absolute rate of change between consecutive readings",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "WITH co2_data AS (SELECT time_bucket(INTERVAL '5 minutes', to_timestamp(timestamp/1000000)) as time, AVG(CASE WHEN metric = 'rco2' THEN value END) as co2 FROM read_parquet('/data/data/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 GROUP BY 1 ORDER BY 1) SELECT time, co2 as \"CO2\", ABS(co2 - LAG(co2, 1) OVER (ORDER BY time)) as \"Rate of Change\" FROM co2_data WHERE co2 IS NOT NULL ORDER BY time",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "CO2"},
            "properties": [
              {"id": "unit", "value": "ppm"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}},
              {"id": "custom.axisPlacement", "value": "left"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Rate of Change"},
            "properties": [
              {"id": "unit", "value": "ppm"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.lineWidth", "value": 2},
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "transparent", "value": null},
                    {"color": "orange", "value": 100}
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "histogram",
      "title": "PM2.5 Value Distribution",
      "description": "Histogram showing distribution of PM2.5 values to identify common ranges and outliers",
      "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT value FROM read_parquet('/data/data/**/*.parquet') WHERE metric = 'pm02' AND value >= 0 AND value <= 500 AND timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "conc",
          "custom": {
            "hideFrom": {"tooltip": false, "viz": false, "legend": false}
          }
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Metric Statistics",
      "description": "Statistical summary of all metrics: min, max, avg, stddev, and count to identify high variance",
      "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "motherduck-duckdb-datasource", "uid": "duckdb-ndp"},
          "rawSql": "SELECT metric, COUNT(*) as count, ROUND(MIN(value), 2) as min, ROUND(MAX(value), 2) as max, ROUND(AVG(value), 2) as avg, ROUND(STDDEV(value), 2) as stddev, ROUND(STDDEV(value) / NULLIF(AVG(value), 0), 3) as coefficient_of_variation FROM read_parquet('/data/data/**/*.parquet') WHERE timestamp >= ${__from}::BIGINT * 1000 AND timestamp <= ${__to}::BIGINT * 1000 AND value IS NOT NULL GROUP BY metric ORDER BY stddev DESC",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "stddev", "desc": true}]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "metric"},
            "properties": [
              {"id": "custom.width", "value": 150}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "count"},
            "properties": [
              {"id": "unit", "value": "short"},
              {"id": "custom.width", "value": 100}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "stddev"},
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "gradient-gauge"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 5},
                    {"color": "red", "value": 20}
                  ]
                }
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "coefficient_of_variation"},
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "gradient-gauge"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 0.2},
                    {"color": "red", "value": 0.5}
                  ]
                }
              },
              {"id": "custom.width", "value": 180}
            ]
          }
        ]
      }
    }
  ]
}

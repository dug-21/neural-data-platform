{
  "uid": "ndp-comparison",
  "title": "Indoor vs Outdoor Comparison",
  "tags": ["ndp", "comparison"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperature Delta",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH indoor AS (SELECT avg_temperature AS temp FROM readings_hourly WHERE stream_id = 'air-quality' ORDER BY bucket DESC LIMIT 1), outdoor AS (SELECT avg_temperature AS temp FROM readings_hourly WHERE stream_id = 'outdoor-weather' ORDER BY bucket DESC LIMIT 1) SELECT (indoor.temp - outdoor.temp) AS \"value\" FROM indoor, outdoor",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PM2.5 Delta",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH indoor AS (SELECT avg_pm25 AS pm25 FROM readings_hourly WHERE stream_id = 'air-quality' ORDER BY bucket DESC LIMIT 1), outdoor AS (SELECT avg_pm2_5 AS pm25 FROM readings_hourly WHERE stream_id = 'outdoor-air-quality' ORDER BY bucket DESC LIMIT 1) SELECT (indoor.pm25 - outdoor.pm25) AS \"value\" FROM indoor, outdoor",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "conc",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Humidity Delta",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "WITH indoor AS (SELECT avg_humidity AS humidity FROM readings_hourly WHERE stream_id = 'air-quality' ORDER BY bucket DESC LIMIT 1), outdoor AS (SELECT avg_humidity AS humidity FROM readings_hourly WHERE stream_id = 'outdoor-weather' ORDER BY bucket DESC LIMIT 1) SELECT (indoor.humidity - outdoor.humidity) AS \"value\" FROM indoor, outdoor",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temperature Comparison",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT epoch(bucket) AS time, avg_temperature AS \"Indoor Temperature\" FROM readings_hourly WHERE stream_id = 'air-quality' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) UNION ALL SELECT epoch(bucket) AS time, avg_temperature AS \"Outdoor Temperature\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Indoor Temperature"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Outdoor Temperature"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PM2.5 Comparison",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT epoch(bucket) AS time, avg_pm25 AS \"Indoor PM2.5\" FROM readings_hourly WHERE stream_id = 'air-quality' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) UNION ALL SELECT epoch(bucket) AS time, avg_pm2_5 AS \"Outdoor PM2.5\" FROM readings_hourly WHERE stream_id = 'outdoor-air-quality' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "conc",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 12},
              {"color": "orange", "value": 35},
              {"color": "red", "value": 55}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Indoor PM2.5"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Outdoor PM2.5"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Humidity Comparison",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb-ndp"
          },
          "rawSql": "SELECT epoch(bucket) AS time, avg_humidity AS \"Indoor Humidity\" FROM readings_hourly WHERE stream_id = 'air-quality' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) UNION ALL SELECT epoch(bucket) AS time, avg_humidity AS \"Outdoor Humidity\" FROM readings_hourly WHERE stream_id = 'outdoor-weather' AND bucket >= to_timestamp($__timeFrom / 1000) AND bucket <= to_timestamp($__timeTo / 1000) ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",

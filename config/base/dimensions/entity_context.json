{
  "dimension_id": "entity_context",
  "description": "Entity context for Home Assistant sensor enrichment",
  "version": "1.0.0",
  "target": {
    "table": "entity_context",
    "schema": "silver"
  },
  "source": {
    "type": "csv",
    "path": "data/dimensions/entity_context.csv",
    "delimiter": ",",
    "encoding": "utf-8",
    "has_header": true,
    "skip_blank_lines": true,
    "comment_char": "#"
  },
  "schema": {
    "primary_key": ["ndp_id"],
    "fields": [
      {
        "name": "ndp_id",
        "type": "text",
        "nullable": false,
        "description": "Neural Data Platform entity identifier (matches fact tables)"
      },
      {
        "name": "category",
        "type": "text",
        "nullable": false,
        "description": "Entity classification (temperature, humidity, door, window, etc.)",
        "validation": {
          "min_length": 1
        }
      },
      {
        "name": "friendly_name",
        "type": "text",
        "nullable": false,
        "description": "Human-readable display name for dashboards",
        "validation": {
          "min_length": 1
        }
      },
      {
        "name": "location_path",
        "type": "text",
        "nullable": true,
        "description": "Hierarchical location path (home/living_room)"
      },
      {
        "name": "correlates_with",
        "type": "text",
        "nullable": true,
        "description": "Comma-separated list of correlated entity ndp_ids"
      },
      {
        "name": "orientation",
        "type": "text",
        "nullable": true,
        "description": "Compass direction for physical entities",
        "validation": {
          "allowed_values": [
            "north",
            "south",
            "east",
            "west",
            "northeast",
            "northwest",
            "southeast",
            "southwest"
          ]
        }
      }
    ],
    "indexes": [
      {
        "name": "idx_entity_context_category",
        "columns": ["category"],
        "unique": false
      },
      {
        "name": "idx_entity_context_location",
        "columns": ["location_path"],
        "unique": false
      }
    ]
  },
  "load": {
    "strategy": "truncate_and_load",
    "batch_size": 1000,
    "transaction": {
      "mode": "atomic"
    },
    "validation": {
      "require_all_columns": true,
      "reject_extra_columns": false,
      "max_errors": 0
    },
    "verification": {
      "check_row_count": true,
      "check_primary_key": true
    }
  },
  "transforms": {
    "correlates_with": {
      "type": "csv_to_array",
      "delimiter": ",",
      "trim_whitespace": true
    }
  },
  "schedule": {
    "enabled": false
  },
  "metadata": {
    "category": "dimension",
    "domain": "entity",
    "owner": "dp-013",
    "documentation_url": "docs/dimensions/entity_context.md",
    "tags": [
      "dimension",
      "entity-context",
      "enrichment",
      "home-assistant"
    ]
  }
}

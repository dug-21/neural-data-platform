{
  "stream_id": "home-assistant-state",
  "description": "Window/door state events from Home Assistant via MQTT",
  "version": "1.0.0",
  "enabled": true,
  "retention_days": 365,
  "compression_after_days": 7,
  "partitioning_strategy": "daily",
  "fields": [
    {
      "type": "string",
      "description": "Binary state: on (open) or off (closed)",
      "nullable": false,
      "name": "state"
    },
    {
      "type": "string",
      "description": "Home Assistant entity ID for traceability",
      "nullable": true,
      "name": "source_entity_id"
    }
  ],
  "sources": [
    {
      "type": "mqtt",
      "enabled": true,
      "ndp_id_topic_segment": 2,
      "context": {
        "source_type": {
          "provider": "home_assistant",
          "purpose": "binary_sensor_state"
        },
        "location": {
          "coordinates": [
            29.95838,
            -81.30878
          ],
          "type": "indoor",
          "path": "/home"
        },
        "environment": "indoor"
      },
      "broker_url": "mosquitto",
      "port": 1883,
      "client_id": "ndp-home-assistant-state",
      "topic_pattern": "homeassistant/binary_sensor/+/state",
      "qos": 1,
      "reconnect_delay_secs": 1,
      "max_reconnect_delay_secs": 30,
      "buffer_capacity": 100,
      "parser": {
        "parser_type": "flat_json",
        "location_id_field": "_topic",
        "default_location_id": "unknown",
        "default_tags": {
          "source": "mqtt",
          "stream_id": "home-assistant-state",
          "provider": "home_assistant"
        }
      }
    }
  ],
  "storage": {
    "batch_size": 10,
    "batch_timeout_secs": 60,
    "buffer_capacity": 100
  },
  "silver_etl": {
    "enabled": true,
    "target_table": "silver.state_events",
    "description": "Window/door state change events from Home Assistant",
    "grain": "One row per state change event",
    "timestamp": {
      "source_field": "timestamp",
      "target_field": "event_time",
      "transform": "microseconds_to_timestamp"
    },
    "identity_fields": [
      {
        "source": "ndp_id",
        "target": "ndp_id"
      }
    ],
    "field_mappings": [
      {
        "source_path": "raw_payload._raw_text",
        "target_column": "state",
        "type": "text",
        "description": "Binary state (on/off)",
        "nullable": false,
        "dq_rules": [
          {
            "rule": "enum_check",
            "allowed_values": [
              "on",
              "off"
            ],
            "action": "flag"
          }
        ]
      },
      {
        "source_path": "ndp_id",
        "target_column": "source_entity_id",
        "type": "text",
        "description": "Home Assistant entity ID (ndp_id from topic, e.g., door_backslider)",
        "nullable": true
      }
    ],
    "dq_rules": [
      {
        "rule": "null_check",
        "field": "ndp_id",
        "action": "reject"
      },
      {
        "rule": "freshness_check",
        "field": "event_time",
        "max_future": "5 minutes",
        "action": "flag"
      }
    ],
    "dq_output": {
      "enabled": true,
      "target_column": "dq_flags",
      "include_rules": true,
      "include_values": false
    },
    "deduplication": {
      "enabled": true,
      "key_columns": [
        "event_time",
        "ndp_id"
      ],
      "strategy": "upsert"
    },
    "incremental": {
      "enabled": true,
      "watermark_column": "event_time",
      "lag_interval": "1 minute"
    }
  },
  "pipeline_health": {
    "freshness_thresholds": {
      "fresh": "18 hours",
      "stale": "36 hours",
      "critical": "72 hours"
    }
  },
  "config_version": 2
}

{
  "stream_id": "air-quality",
  "description": "AirGradient sensor readings from MQTT",
  "version": "1.0.0",
  "enabled": true,
  "retention_days": 365,
  "compression_after_days": 7,
  "partitioning_strategy": "daily",
  "fields": [
    {
      "type": "float",
      "unit": "µg/m³",
      "description": "Particulate Matter 2.5 micrometers",
      "nullable": false,
      "name": "pm25",
      "range": [
        0,
        1000
      ]
    },
    {
      "type": "float",
      "unit": "µg/m³",
      "description": "Particulate Matter 10 micrometers",
      "nullable": true,
      "name": "pm10",
      "range": [
        0,
        1000
      ]
    },
    {
      "type": "int",
      "unit": "ppm",
      "description": "Carbon Dioxide concentration",
      "nullable": true,
      "name": "co2",
      "range": [
        400,
        10000
      ]
    },
    {
      "type": "float",
      "unit": "celsius",
      "description": "Ambient temperature",
      "nullable": true,
      "name": "temperature",
      "range": [
        -40,
        85
      ]
    },
    {
      "type": "float",
      "unit": "percent",
      "description": "Relative humidity",
      "nullable": true,
      "name": "humidity",
      "range": [
        0,
        100
      ]
    },
    {
      "type": "int",
      "unit": "ppb",
      "description": "Total Volatile Organic Compounds",
      "nullable": true,
      "name": "tvoc",
      "range": [
        0,
        60000
      ]
    },
    {
      "type": "int",
      "unit": "ppb",
      "description": "Nitrogen Oxides",
      "nullable": true,
      "name": "nox",
      "range": [
        1,
        500
      ]
    }
  ],
  "sources": [
    {
      "type": "mqtt",
      "enabled": true,
      "ndp_id": "aq_airgradient_1",
      "context": {
        "device_type": "airgradient",
        "location": {
          "coordinates": [
            29.95838,
            -81.30878
          ],
          "type": "indoor",
          "path": "/beachhouse/livingroom"
        },
        "environment": "indoor"
      },
      "broker_url": "mosquitto",
      "port": 1883,
      "client_id": "air-quality-app",
      "topic_pattern": "airgradient/readings/+",
      "qos": 1,
      "reconnect_delay_secs": 1,
      "max_reconnect_delay_secs": 30,
      "buffer_capacity": 1000,
      "parser": {
        "parser_type": "flat_json",
        "location_id_field": "serialno",
        "skip_fields": [
          "serialno",
          "firmware",
          "model",
          "ledMode"
        ],
        "default_tags": {
          "source": "mqtt",
          "stream_id": "air-quality"
        }
      }
    }
  ],
  "mqtt": {
    "enabled": true,
    "broker_url": "mosquitto",
    "port": 1883,
    "client_id": "air-quality-app",
    "topic_pattern": "airgradient/readings/+",
    "qos": 1,
    "reconnect_delay_secs": 1,
    "max_reconnect_delay_secs": 30,
    "buffer_capacity": 1000
  },
  "storage": {
    "batch_size": 100,
    "batch_timeout_secs": 5,
    "buffer_capacity": 1000
  },
  "entity_schemas": [
    {
      "schema_name": "airgradient",
      "description": "AirGradient indoor air quality sensors (AG One, AG Pro)",
      "device_class": "air_quality",
      "attributes": [
        {
          "name": "pm25",
          "type": "float",
          "unit": "ug/m3",
          "description": "Particulate Matter 2.5 micrometers",
          "nullable": false,
          "range": [
            0,
            1000
          ]
        },
        {
          "name": "pm10",
          "type": "float",
          "unit": "ug/m3",
          "description": "Particulate Matter 10 micrometers",
          "nullable": true,
          "range": [
            0,
            1000
          ]
        },
        {
          "name": "co2",
          "type": "int",
          "unit": "ppm",
          "description": "Carbon Dioxide concentration",
          "nullable": true,
          "range": [
            400,
            10000
          ]
        },
        {
          "name": "temperature",
          "type": "float",
          "unit": "celsius",
          "description": "Ambient temperature",
          "nullable": true,
          "range": [
            -40,
            85
          ]
        },
        {
          "name": "humidity",
          "type": "float",
          "unit": "percent",
          "description": "Relative humidity",
          "nullable": true,
          "range": [
            0,
            100
          ]
        },
        {
          "name": "tvoc",
          "type": "int",
          "unit": "ppb",
          "description": "Total Volatile Organic Compounds",
          "nullable": true,
          "range": [
            0,
            60000
          ]
        },
        {
          "name": "nox",
          "type": "int",
          "unit": "ppb",
          "description": "Nitrogen Oxides index",
          "nullable": true,
          "range": [
            1,
            500
          ]
        }
      ]
    }
  ],
  "silver_etl": {
    "enabled": true,
    "target_table": "silver.air_quality_observations",
    "description": "Indoor air quality measurements from AirGradient sensors",
    "grain": "One row per sensor reading (~1 minute intervals)",
    "timestamp": {
      "source_field": "timestamp",
      "target_field": "observation_time",
      "transform": "microseconds_to_timestamp"
    },
    "identity_fields": [
      {
        "source": "ndp_id",
        "target": "ndp_id"
      }
    ],
    "field_mappings": [
      {
        "source_path": "raw_payload.pm02Compensated",
        "target_column": "pm25",
        "type": "double_precision",
        "unit": "ug/m3",
        "description": "PM2.5 particulate matter concentration (humidity-compensated)",
        "nullable": false,
        "dq_rules": [
          {
            "rule": "range_check",
            "min": 0,
            "max": 1000,
            "action": "flag"
          }
        ]
      },
      {
        "source_path": "raw_payload.pm10",
        "target_column": "pm10",
        "type": "double_precision",
        "unit": "ug/m3",
        "description": "PM10 particulate matter concentration",
        "nullable": true,
        "dq_rules": [
          {
            "rule": "range_check",
            "min": 0,
            "max": 2000,
            "action": "flag"
          }
        ]
      },
      {
        "source_path": "raw_payload.rco2",
        "target_column": "co2",
        "type": "smallint",
        "unit": "ppm",
        "description": "Carbon dioxide concentration",
        "nullable": true,
        "dq_rules": [
          {
            "rule": "range_check",
            "min": 380,
            "max": 10000,
            "action": "flag"
          }
        ]
      },
      {
        "source_path": "raw_payload.atmpCompensated",
        "target_column": "temperature_c",
        "type": "double_precision",
        "unit": "Celsius",
        "description": "Ambient temperature (sensor-compensated)",
        "nullable": true,
        "dq_rules": [
          {
            "rule": "range_check",
            "min": -40,
            "max": 85,
            "action": "flag"
          }
        ]
      },
      {
        "source_path": "raw_payload.rhumCompensated",
        "target_column": "humidity_pct",
        "type": "double_precision",
        "unit": "%",
        "description": "Relative humidity (compensated)",
        "nullable": true,
        "dq_rules": [
          {
            "rule": "range_check",
            "min": 0,
            "max": 100,
            "action": "clamp",
            "clamp_to_bounds": true
          }
        ]
      },
      {
        "source_path": "raw_payload.tvocIndex",
        "target_column": "tvoc_index",
        "type": "smallint",
        "unit": "index",
        "description": "Total VOC index (1-500 scale)",
        "nullable": true,
        "dq_rules": [
          {
            "rule": "range_check",
            "min": 1,
            "max": 500,
            "action": "clamp",
            "clamp_to_bounds": true
          }
        ]
      },
      {
        "source_path": "raw_payload.noxIndex",
        "target_column": "nox_index",
        "type": "smallint",
        "unit": "index",
        "description": "NOx index (1-500 scale)",
        "nullable": true,
        "dq_rules": [
          {
            "rule": "range_check",
            "min": 1,
            "max": 500,
            "action": "clamp",
            "clamp_to_bounds": true
          }
        ]
      }
    ],
    "dq_rules": [
      {
        "rule": "cross_field_check",
        "name": "pm10_gte_pm25",
        "expression": "pm10 IS NULL OR pm25 IS NULL OR pm10 >= pm25",
        "message": "pm10_less_than_pm25",
        "action": "flag"
      },
      {
        "rule": "freshness_check",
        "field": "observation_time",
        "max_age": "2 hours",
        "max_future": "5 minutes",
        "reference": "ingestion_time",
        "action": "flag"
      },
      {
        "rule": "rate_of_change",
        "field": "pm25",
        "max_change_per_minute": 100,
        "partition_by": [
          "ndp_id"
        ],
        "action": "flag"
      },
      {
        "rule": "rate_of_change",
        "field": "temperature_c",
        "max_change_per_minute": 3,
        "partition_by": [
          "ndp_id"
        ],
        "action": "flag"
      },
      {
        "rule": "completeness_check",
        "level": "batch",
        "field": "pm25",
        "min_completeness": 0.95,
        "action": "warn"
      }
    ],
    "dq_output": {
      "enabled": true,
      "target_column": "dq_flags",
      "include_rules": true,
      "include_values": false,
      "transparency": {
        "enabled": true,
        "table": "silver.dq_transparency",
        "include_sample_payload": true,
        "max_samples_per_rule": 10
      }
    },
    "deduplication": {
      "enabled": true,
      "key_columns": [
        "observation_time",
        "ndp_id"
      ],
      "strategy": "upsert"
    },
    "incremental": {
      "enabled": true,
      "watermark_column": "observation_time",
      "lag_interval": "5 minutes"
    }
  },
  "config_version": "1.1"
}

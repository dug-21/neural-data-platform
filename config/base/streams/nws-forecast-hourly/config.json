{
  "stream_id": "nws-forecast-hourly",
  "stream_type": "forecast",
  "description": "Hourly weather forecast from NWS gridpoint forecast",
  "version": "1.0.0",
  "enabled": true,
  "retention_days": 30,
  "compression_after_days": 7,
  "partitioning_strategy": "daily",
  "fields": [
    {
      "name": "temperature",
      "type": "float",
      "nullable": false,
      "unit": "fahrenheit",
      "range": [
        -50,
        130
      ],
      "description": "Forecast temperature"
    },
    {
      "name": "dewpoint",
      "type": "float",
      "nullable": true,
      "unit": "celsius",
      "range": [
        -50,
        60
      ],
      "description": "Forecast dew point"
    },
    {
      "name": "relative_humidity",
      "type": "float",
      "nullable": true,
      "unit": "percent",
      "range": [
        0,
        100
      ],
      "description": "Forecast relative humidity"
    },
    {
      "name": "wind_speed",
      "type": "float",
      "nullable": true,
      "unit": "mph",
      "range": [
        0,
        200
      ],
      "description": "Forecast wind speed"
    },
    {
      "name": "wind_direction",
      "type": "float",
      "nullable": true,
      "unit": "degrees",
      "range": [
        0,
        360
      ],
      "description": "Forecast wind direction"
    },
    {
      "name": "short_forecast",
      "type": "string",
      "nullable": true,
      "description": "Brief forecast description"
    },
    {
      "name": "detailed_forecast",
      "type": "string",
      "nullable": true,
      "description": "Multi-sentence forecast narrative"
    },
    {
      "name": "probability_of_precipitation",
      "type": "float",
      "nullable": true,
      "unit": "percent",
      "range": [
        0,
        100
      ],
      "description": "Precipitation probability"
    },
    {
      "name": "forecast_issue_time",
      "type": "float",
      "nullable": true,
      "unit": "epoch_seconds",
      "description": "Forecast issue timestamp as epoch seconds"
    }
  ],
  "sources": [
    {
      "type": "http_poll",
      "enabled": true,
      "ndp_id": "weather-nws-001",
      "context": {
        "source_type": {
          "provider": "nws",
          "purpose": "forecast_hourly",
          "grid_office": "JAX",
          "station": "ksgj"
        },
        "location": {
          "coordinates": [
            29.95838,
            -81.30878
          ],
          "type": "outdoor",
          "path": "beachhouse"
        }
      },
      "poll_interval_secs": 3600,
      "timeout_secs": 30,
      "retry_attempts": 3,
      "retry_delay_secs": 5,
      "buffer_capacity": 2500,
      "parser_name": "nws_forecast_hourly",
      "endpoints": [
        {
          "endpoint_id": "nws_jax_80_50_forecast",
          "location_id": "ksgj",
          "grid_office": "JAX",
          "grid_x": 80,
          "grid_y": 50,
          "url": "https://api.weather.gov/gridpoints/JAX/80,50/forecast/hourly",
          "auth_type": "none",
          "headers": {
            "User-Agent": "(neural-data-platform/1.0, something1@gmail.com)",
            "Accept": "application/geo+json"
          }
        }
      ],
      "parser": {
        "parser_type": "array_iterator",
        "location_id_field": "properties.gridId",
        "default_location_id": "ksgj",
        "default_tags": {
          "source": "nws",
          "api": "forecast_hourly",
          "stream_id": "nws-forecast-hourly",
          "grid_office": "JAX",
          "grid_x": "80",
          "grid_y": "50"
        },
        "array_config": {
          "array_path": "properties.periods",
          "timestamp_field": "startTime",
          "metadata_tags": [
            {
              "path": "properties.generatedAt",
              "tag_name": "forecast_generated_at"
            },
            {
              "path": "properties.updateTime",
              "tag_name": "forecast_update_time"
            }
          ],
          "metadata_metrics": [
            {
              "path": "properties.updateTime",
              "metric_name": "forecast_issue_time",
              "value_type": "timestamp",
              "unit": "epoch_seconds"
            }
          ],
          "element_mappings": [
            {
              "path": "temperature",
              "metric_name": "temperature",
              "unit": "fahrenheit",
              "optional": false
            },
            {
              "path": "dewpoint.value",
              "metric_name": "dewpoint",
              "unit": "celsius",
              "optional": true
            },
            {
              "path": "relativeHumidity.value",
              "metric_name": "relative_humidity",
              "unit": "percent",
              "optional": true
            },
            {
              "path": "windSpeed",
              "metric_name": "wind_speed",
              "unit": "mph",
              "optional": true,
              "string_parse": {
                "pattern": "^(\\d+)\\s*(?:to\\s*(\\d+)\\s*)?mph$",
                "capture_group": 1
              }
            },
            {
              "path": "windDirection",
              "metric_name": "wind_direction",
              "unit": "degrees",
              "optional": true,
              "enum_map": {
                "N": 0,
                "NNE": 22.5,
                "NE": 45,
                "ENE": 67.5,
                "E": 90,
                "ESE": 112.5,
                "SE": 135,
                "SSE": 157.5,
                "S": 180,
                "SSW": 202.5,
                "SW": 225,
                "WSW": 247.5,
                "W": 270,
                "WNW": 292.5,
                "NW": 315,
                "NNW": 337.5
              }
            },
            {
              "path": "shortForecast",
              "metric_name": "short_forecast",
              "optional": true
            },
            {
              "path": "detailedForecast",
              "metric_name": "detailed_forecast",
              "optional": true
            },
            {
              "path": "probabilityOfPrecipitation.value",
              "metric_name": "probability_of_precipitation",
              "unit": "percent",
              "optional": true
            }
          ]
        }
      }
    }
  ],
  "storage": {
    "batch_size": 156,
    "batch_timeout_secs": 60,
    "buffer_capacity": 200
  },
  "silver_etl": {
    "enabled": true,
    "target_table": "silver.nws_forecast_hourly",
    "timestamp": {
      "source_field": "timestamp",
      "target_field": "observation_time",
      "transform": "iso8601"
    },
    "identity_fields": [
      {
        "source": "ndp_id",
        "target": "ndp_id"
      }
    ],
    "deduplication": {
      "enabled": true,
      "strategy": "upsert",
      "key_columns": ["observation_time", "ndp_id"]
    },
    "field_mappings": [
      {
        "source_path": "temperature",
        "target_column": "temperature_f",
        "type": "double_precision",
        "nullable": false,
        "description": "Forecast temperature in Fahrenheit"
      },
      {
        "source_path": "dewpoint",
        "target_column": "dewpoint_c",
        "type": "double_precision",
        "nullable": true,
        "description": "Forecast dew point in Celsius"
      },
      {
        "source_path": "relative_humidity",
        "target_column": "relative_humidity",
        "type": "double_precision",
        "nullable": true,
        "description": "Relative humidity percentage"
      },
      {
        "source_path": "wind_speed",
        "target_column": "wind_speed_mph",
        "type": "double_precision",
        "nullable": true,
        "description": "Wind speed in mph"
      },
      {
        "source_path": "wind_direction",
        "target_column": "wind_direction_deg",
        "type": "double_precision",
        "nullable": true,
        "description": "Wind direction in degrees"
      },
      {
        "source_path": "probability_of_precipitation",
        "target_column": "probability_of_precipitation",
        "type": "double_precision",
        "nullable": true,
        "description": "Precipitation probability percentage"
      },
      {
        "source_path": "forecast_issue_time",
        "target_column": "forecast_issue_time",
        "type": "double_precision",
        "nullable": true,
        "description": "Forecast issue timestamp as epoch seconds"
      },
      {
        "source_path": "short_forecast",
        "target_column": "short_forecast",
        "type": "text",
        "nullable": true,
        "description": "Brief forecast description (e.g., Partly Cloudy)"
      },
      {
        "source_path": "detailed_forecast",
        "target_column": "detailed_forecast",
        "type": "text",
        "nullable": true,
        "description": "Multi-sentence forecast narrative"
      }
    ],
    "dq_rules": [],
    "dq_output": {
      "enabled": false
    }
  },
  "config_version": 2
}

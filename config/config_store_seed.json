{
  "version": "1.0.0",
  "created_at": "2025-01-23T00:00:00.000000Z",
  "description": "Initial configuration seed data for Neural Trader config-store",
  "migration_instructions": {
    "secrets": "Secrets should be provided via environment variables, not stored in config-store",
    "variable_substitution": "Variables in ${VAR} format will be replaced at runtime from environment",
    "namespace_access": "Use ConfigStore::get_namespace() to access configurations",
    "hot_reload": "Configuration changes will be automatically detected and applied"
  },
  "namespaces": {
    "neural-platform/shared/eventbus": {
      "connection": "redis://redis:6379",
      "consumer_groups": [
        "data-ingestion-group",
        "model-execution-group",
        "action-execution-group"
      ],
      "streams": {
        "market_data": "trading:market-data",
        "system_events": "trading:system",
        "ml_events": "trading:ml-events",
        "risk_events": "trading:risk",
        "portfolio_events": "trading:portfolio"
      },
      "dead_letter_queue": "trading:dlq",
      "message_ttl_seconds": 86400,
      "max_len": 10000,
      "buffer_settings": {
        "batch_size": 100,
        "flush_interval_ms": 1000,
        "compression": "gzip"
      }
    },
    "neural-platform/shared/ml-ops": {
      "model_registry": "/opt/models",
      "training_schedule": "0 2 * * *",
      "performance_thresholds": {
        "accuracy": 0.85,
        "precision": 0.80,
        "recall": 0.80,
        "f1_score": 0.80,
        "latency_ms": 100,
        "throughput_rps": 1000,
        "memory_usage_mb": 2048
      },
      "auto_retrain_threshold": 0.8,
      "model_versioning": true,
      "backup_retention_days": 30,
      "model_formats": ["onnx", "pytorch", "tensorflow"],
      "gpu_acceleration": true,
      "distributed_training": false
    },
    "neural-platform/shared/monitoring": {
      "prometheus_url": "http://prometheus:9090",
      "grafana_url": "http://grafana:3000",
      "log_level": "info",
      "metrics_retention_days": 90,
      "alert_manager_url": "http://alertmanager:9093",
      "jaeger_url": "http://jaeger:14268",
      "health_check_interval": 30,
      "metric_collection": {
        "system_metrics": true,
        "business_metrics": true,
        "ml_metrics": true,
        "custom_metrics": true
      },
      "alerting": {
        "critical_latency_ms": 1000,
        "error_rate_threshold": 0.01,
        "memory_usage_threshold": 0.85,
        "disk_usage_threshold": 0.90
      }
    },
    "neural-trading/data-ingestion": {
      "sources": {
        "primary": {
          "provider": "alpaca",
          "api_url": "${ALPACA_API_URL:-https://paper-api.alpaca.markets}",
          "websocket_url": "${ALPACA_WS_URL:-wss://stream.data.alpaca.markets/v2/iex}",
          "symbols": ["AAPL", "GOOGL", "MSFT", "AMZN", "NVDA", "TSLA", "META", "NFLX"],
          "rate_limits": {
            "requests_per_minute": 200,
            "websocket_connections": 5,
            "burst_limit": 50,
            "concurrent_requests": 10
          },
          "retry_policy": {
            "max_attempts": 3,
            "backoff_multiplier": 2.0,
            "initial_delay_ms": 1000,
            "max_delay_ms": 30000,
            "jitter": true
          },
          "connection_settings": {
            "timeout_seconds": 30,
            "keep_alive": true,
            "pool_size": 10
          }
        },
        "fallback": {
          "provider": "polygon",
          "api_url": "${POLYGON_API_URL:-https://api.polygon.io}",
          "websocket_url": "${POLYGON_WS_URL:-wss://socket.polygon.io}",
          "symbols": ["AAPL", "GOOGL", "MSFT", "AMZN", "NVDA", "TSLA", "META", "NFLX"],
          "rate_limits": {
            "requests_per_minute": 100,
            "websocket_connections": 2
          }
        },
        "auxiliary": {
          "provider": "finnhub",
          "api_url": "${FINNHUB_API_URL:-https://finnhub.io/api/v1}",
          "websocket_url": "${FINNHUB_WS_URL:-wss://ws.finnhub.io}",
          "data_types": ["news", "sentiment", "company_profile"]
        }
      },
      "validation": {
        "price_range": {
          "min_price": 0.01,
          "max_price": 10000.0
        },
        "timestamp_tolerance_ms": 300000,
        "required_fields": ["symbol", "price", "timestamp", "volume"],
        "data_quality_threshold": 0.95,
        "anomaly_detection": {
          "enable": true,
          "price_change_threshold": 0.10,
          "volume_spike_threshold": 5.0
        }
      },
      "processing": {
        "batch_size": 1000,
        "flush_interval_ms": 5000,
        "enable_compression": true,
        "parallelism": 4,
        "buffer_size": 50000,
        "partitioning": {
          "by_symbol": true,
          "by_timestamp": true
        }
      },
      "storage": {
        "enable_raw_data": true,
        "enable_aggregated_data": true,
        "retention_days": 365,
        "compression_algorithm": "lz4"
      }
    },
    "neural-trading/model-execution": {
      "models": {
        "trading_mlp": {
          "input_size": 20,
          "hidden_layers": [64, 32, 16],
          "output_size": 3,
          "learning_rate": 0.001,
          "batch_size": 32,
          "dropout_rate": 0.2,
          "activation": "relu",
          "optimizer": "adam",
          "weight_initialization": "xavier"
        },
        "lstm_predictor": {
          "sequence_length": 60,
          "hidden_size": 128,
          "num_layers": 2,
          "learning_rate": 0.0001,
          "batch_size": 64,
          "dropout_rate": 0.3,
          "bidirectional": false
        },
        "transformer_model": {
          "d_model": 256,
          "nhead": 8,
          "num_layers": 6,
          "sequence_length": 100,
          "learning_rate": 0.0001
        }
      },
      "inference": {
        "max_concurrent_requests": 100,
        "timeout_ms": 5000,
        "enable_gpu": true,
        "model_cache_size": 10,
        "batch_inference": true,
        "dynamic_batching": {
          "max_batch_size": 32,
          "max_delay_ms": 100
        }
      },
      "training": {
        "enable_autonomous": false,
        "sample_threshold": 1000,
        "validation_split": 0.2,
        "test_split": 0.1,
        "early_stopping_patience": 10,
        "checkpoint_interval": 100,
        "distributed_training": false,
        "hyperparameter_tuning": {
          "enable": false,
          "optimization_metric": "accuracy",
          "max_trials": 50
        }
      },
      "feature_engineering": {
        "technical_indicators": [
          "sma_20", "ema_12", "ema_26", "rsi_14", "macd", "bollinger_bands"
        ],
        "normalization": "z_score",
        "feature_selection": "recursive_elimination"
      }
    },
    "neural-trading/action-layer": {
      "risk_controls": {
        "max_position_size": 0.05,
        "max_daily_loss": 0.02,
        "stop_loss_percentage": 0.05,
        "max_drawdown": 0.15,
        "position_concentration_limit": 0.25,
        "sector_exposure_limit": 0.40,
        "correlation_limit": 0.70,
        "var_limit": 0.03
      },
      "execution": {
        "order_timeout_seconds": 30,
        "retry_attempts": 3,
        "slippage_tolerance": 0.001,
        "enable_smart_routing": true,
        "order_types": ["market", "limit", "stop_loss", "stop_limit"],
        "execution_algorithms": {
          "vwap": true,
          "twap": true,
          "implementation_shortfall": false
        }
      },
      "portfolio": {
        "rebalancing_frequency": "daily",
        "min_cash_reserve": 0.1,
        "max_sectors_exposure": 0.4,
        "target_volatility": 0.15,
        "optimization_method": "mean_variance",
        "constraints": {
          "long_only": true,
          "min_weight": 0.01,
          "max_weight": 0.20
        }
      },
      "paper_trading": {
        "enable": "${ENABLE_PAPER_TRADING:-true}",
        "starting_capital": 100000,
        "commission_per_share": 0.005,
        "min_commission": 1.0,
        "market_impact": 0.001
      }
    }
  },
  "environment_mappings": {
    "secrets": [
      "ALPACA_API_KEY",
      "ALPACA_API_SECRET", 
      "POLYGON_API_KEY",
      "FINNHUB_API_KEY",
      "ALPHA_VANTAGE_API_KEY",
      "REDDIT_CLIENT_ID",
      "REDDIT_CLIENT_SECRET",
      "POSTGRES_PASSWORD",
      "GRAFANA_ADMIN_PASSWORD",
      "JWT_SECRET"
    ],
    "runtime_variables": [
      "ALPACA_API_URL",
      "ALPACA_WS_URL", 
      "POLYGON_API_URL",
      "POLYGON_WS_URL",
      "FINNHUB_API_URL",
      "FINNHUB_WS_URL",
      "ENABLE_PAPER_TRADING",
      "LOG_LEVEL",
      "RUST_LOG"
    ]
  },
  "schema_versions": {
    "neural-platform/shared/eventbus": "v1.0.0",
    "neural-platform/shared/ml-ops": "v1.0.0", 
    "neural-platform/shared/monitoring": "v1.0.0",
    "neural-trading/data-ingestion": "v1.0.0",
    "neural-trading/model-execution": "v1.0.0",
    "neural-trading/action-layer": "v1.0.0"
  },
  "validation_rules": {
    "required_fields": {
      "neural-platform/shared/eventbus": ["connection", "consumer_groups", "streams"],
      "neural-trading/data-ingestion": ["sources", "validation", "processing"],
      "neural-trading/model-execution": ["models", "inference", "training"],
      "neural-trading/action-layer": ["risk_controls", "execution", "portfolio"]
    },
    "type_constraints": {
      "rate_limits.requests_per_minute": "integer",
      "performance_thresholds.accuracy": "float",
      "risk_controls.max_position_size": "float"
    }
  }
}
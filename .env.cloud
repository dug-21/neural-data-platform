# Cloud Services Configuration
# ============================

# Option A: Use free tier services
# --------------------------------

# Supabase (PostgreSQL) - https://supabase.com/
DATABASE_URL=postgresql://[user]:[password]@[host]:5432/postgres

# Upstash Redis - https://upstash.com/
REDIS_URL=redis://[user]:[password]@[host]:6379

# Option B: Use managed services
# ------------------------------

# Amazon RDS for PostgreSQL
DATABASE_URL=postgresql://[user]:[password]@[instance].rds.amazonaws.com:5432/neural_trader

# Amazon ElastiCache for Redis  
REDIS_URL=redis://[cluster].cache.amazonaws.com:6379

# Option C: Use database-as-a-service
# -----------------------------------

# Neon (PostgreSQL) - https://neon.tech/
DATABASE_URL=postgresql://[user]:[password]@[project].neon.tech/neural_trader

# Railway Redis - https://railway.app/
REDIS_URL=redis://default:[password]@[host].railway.app:6379
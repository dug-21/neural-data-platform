# Neural Trader V2 - CI/CD Pipeline Makefile
# Phase 5 Implementation

# Variables
COMPOSE_FILE := docker-compose.v2.yml
ENV_FILE := .env.$(CONFIG_ENV)
CONFIG_ENV ?= dev
MODULE ?= all
TEST_TYPE ?= all
BUILD_ID ?= latest

# Color output
RED := \033[0;31m
GREEN := \033[0;32m
YELLOW := \033[1;33m
NC := \033[0m # No Color

# Default target
.DEFAULT_GOAL := help

# =============================================================================
# Help
# =============================================================================

.PHONY: help
help: ## Show this help message
	@echo "Neural Trader V2 - Phase 5 CI/CD Pipeline"
	@echo "========================================="
	@echo ""
	@echo "Usage: make [target] [VARIABLE=value]"
	@echo ""
	@echo "Variables:"
	@echo "  CONFIG_ENV    Environment (dev|test|prod) [current: $(CONFIG_ENV)]"
	@echo "  MODULE        Module name for targeted operations [current: $(MODULE)]"
	@echo "  TEST_TYPE     Test type (unit|integration|e2e|all) [current: $(TEST_TYPE)]"
	@echo ""
	@echo "Targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'

# =============================================================================
# Week 1: Foundation Tasks
# =============================================================================

.PHONY: week1-setup
week1-setup: ## Complete Week 1 setup (Docker, configs, infrastructure)
	@echo "$(GREEN)Starting Week 1 Foundation Setup...$(NC)"
	@$(MAKE) docker-build-all
	@$(MAKE) config-setup
	@$(MAKE) infra-setup
	@echo "$(GREEN)Week 1 setup complete!$(NC)"

.PHONY: docker-build-all
docker-build-all: ## Build all Docker images
	@echo "$(GREEN)Building all Docker images...$(NC)"
	docker-compose -f $(COMPOSE_FILE) build --parallel

.PHONY: docker-build
docker-build: ## Build specific service Docker image (use MODULE=service-name)
	@echo "$(GREEN)Building Docker image for $(MODULE)...$(NC)"
	docker-compose -f $(COMPOSE_FILE) build $(MODULE)

.PHONY: config-setup
config-setup: ## Set up configuration files
	@echo "$(GREEN)Setting up configuration files...$(NC)"
	@if [ ! -f .env.dev ]; then cp .env.dev.template .env.dev; fi
	@if [ ! -f .env.test ]; then cp .env.test.template .env.test; fi
	@echo "$(YELLOW)Please update .env files with actual values$(NC)"

.PHONY: infra-setup
infra-setup: ## Start infrastructure services (Redis, TimescaleDB)
	@echo "$(GREEN)Starting infrastructure services...$(NC)"
	docker-compose -f $(COMPOSE_FILE) up -d redis timescaledb
	@echo "Waiting for services to be healthy..."
	@sleep 10
	docker-compose -f $(COMPOSE_FILE) ps

.PHONY: infra-stop
infra-stop: ## Stop infrastructure services
	@echo "$(YELLOW)Stopping infrastructure services...$(NC)"
	docker-compose -f $(COMPOSE_FILE) stop redis timescaledb

.PHONY: db-init
db-init: ## Initialize database schema
	@echo "$(GREEN)Initializing database...$(NC)"
	docker-compose -f $(COMPOSE_FILE) exec -T timescaledb psql -U postgres -d neural_trader < scripts/v2/init-db.sql

# =============================================================================
# Service Management
# =============================================================================

.PHONY: up
up: ## Start all services
	@echo "$(GREEN)Starting all services...$(NC)"
	docker-compose -f $(COMPOSE_FILE) --env-file $(ENV_FILE) up -d
	@$(MAKE) health-check

.PHONY: up-service
up-service: ## Start specific service (use MODULE=service-name)
	@echo "$(GREEN)Starting $(MODULE)...$(NC)"
	docker-compose -f $(COMPOSE_FILE) --env-file $(ENV_FILE) up -d $(MODULE)

.PHONY: down
down: ## Stop all services
	@echo "$(YELLOW)Stopping all services...$(NC)"
	docker-compose -f $(COMPOSE_FILE) down

.PHONY: restart
restart: ## Restart all services
	@echo "$(YELLOW)Restarting services...$(NC)"
	@$(MAKE) down
	@$(MAKE) up

.PHONY: logs
logs: ## Show logs for all services
	docker-compose -f $(COMPOSE_FILE) logs -f

.PHONY: logs-service
logs-service: ## Show logs for specific service (use MODULE=service-name)
	docker-compose -f $(COMPOSE_FILE) logs -f $(MODULE)

.PHONY: ps
ps: ## Show service status
	docker-compose -f $(COMPOSE_FILE) ps

# =============================================================================
# Testing
# =============================================================================

.PHONY: test-module
test-module: ## Run module-specific tests (3-min target)
	@echo "$(GREEN)Running module tests for $(MODULE)...$(NC)"
	@start_time=$$(date +%s); \
	docker-compose -f $(COMPOSE_FILE) run --rm test-runner module $(MODULE); \
	end_time=$$(date +%s); \
	duration=$$((end_time - start_time)); \
	if [ $$duration -le 180 ]; then \
		echo "$(GREEN)✓ Module tests completed in $$duration seconds (target: < 180s)$(NC)"; \
	else \
		echo "$(YELLOW)⚠ Module tests took $$duration seconds (target: < 180s)$(NC)"; \
	fi

.PHONY: test-platform
test-platform: ## Run platform-wide tests (16-min target)
	@echo "$(GREEN)Running platform tests...$(NC)"
	@start_time=$$(date +%s); \
	docker-compose -f $(COMPOSE_FILE) run --rm test-runner platform; \
	end_time=$$(date +%s); \
	duration=$$((end_time - start_time)); \
	if [ $$duration -le 960 ]; then \
		echo "$(GREEN)✓ Platform tests completed in $$duration seconds (target: < 960s)$(NC)"; \
	else \
		echo "$(YELLOW)⚠ Platform tests took $$duration seconds (target: < 960s)$(NC)"; \
	fi

.PHONY: test
test: ## Run tests (use TEST_TYPE variable)
	@echo "$(GREEN)Running $(TEST_TYPE) tests...$(NC)"
	docker-compose -f $(COMPOSE_FILE) run --rm test-runner $(TEST_TYPE)

# =============================================================================
# Health Checks
# =============================================================================

.PHONY: health-check
health-check: ## Check health of all services
	@echo "$(GREEN)Checking service health...$(NC)"
	@docker-compose -f $(COMPOSE_FILE) ps | grep -E "Up|healthy" || echo "$(RED)Some services are not healthy$(NC)"
	@echo ""
	@echo "Detailed health status:"
	@for service in config-store data-ingestion data-staging neural-ml-ops neural-trading; do \
		echo -n "$$service: "; \
		docker-compose -f $(COMPOSE_FILE) exec -T $$service echo "healthy" 2>/dev/null || echo "not responding"; \
	done

.PHONY: wait-healthy
wait-healthy: ## Wait for all services to be healthy
	@echo "$(GREEN)Waiting for services to be healthy...$(NC)"
	@scripts/v2/wait-for-dependencies.sh all

# =============================================================================
# GitOps Operations
# =============================================================================

.PHONY: config-validate
config-validate: ## Validate configuration files
	@echo "$(GREEN)Validating configurations...$(NC)"
	@for file in configs/base/*/config.yaml; do \
		echo "Validating $$file..."; \
		python -c "import yaml; yaml.safe_load(open('$$file'))" || exit 1; \
	done
	@echo "$(GREEN)All configurations valid!$(NC)"

.PHONY: config-reload
config-reload: ## Reload configurations in services
	@echo "$(GREEN)Reloading configurations...$(NC)"
	docker-compose -f $(COMPOSE_FILE) exec config-store kill -HUP 1

# =============================================================================
# Monitoring
# =============================================================================

.PHONY: monitoring-up
monitoring-up: ## Start monitoring stack (Prometheus, Grafana)
	@echo "$(GREEN)Starting monitoring stack...$(NC)"
	docker-compose -f $(COMPOSE_FILE) --profile monitoring up -d
	@echo "Grafana: http://localhost:3000 (admin/admin)"
	@echo "Prometheus: http://localhost:9090"

.PHONY: monitoring-down
monitoring-down: ## Stop monitoring stack
	docker-compose -f $(COMPOSE_FILE) --profile monitoring down

# =============================================================================
# Cleanup
# =============================================================================

.PHONY: clean
clean: ## Clean up containers and volumes
	@echo "$(YELLOW)Cleaning up...$(NC)"
	docker-compose -f $(COMPOSE_FILE) down -v
	docker system prune -f

.PHONY: clean-all
clean-all: clean ## Deep clean including images
	@echo "$(RED)Removing all images...$(NC)"
	docker-compose -f $(COMPOSE_FILE) down --rmi all

# =============================================================================
# Development Helpers
# =============================================================================

.PHONY: shell
shell: ## Open shell in service container (use MODULE=service-name)
	docker-compose -f $(COMPOSE_FILE) exec $(MODULE) /bin/bash

.PHONY: db-shell
db-shell: ## Open PostgreSQL shell
	docker-compose -f $(COMPOSE_FILE) exec timescaledb psql -U postgres -d neural_trader

.PHONY: redis-cli
redis-cli: ## Open Redis CLI
	docker-compose -f $(COMPOSE_FILE) exec redis redis-cli

# =============================================================================
# Week 1 Validation
# =============================================================================

.PHONY: validate-week1
validate-week1: ## Validate Week 1 implementation
	@echo "$(GREEN)Validating Week 1 Implementation...$(NC)"
	@echo ""
	@echo "Checking Docker setup..."
	@ls -la docker/v2/Dockerfile.* | wc -l | grep -q 6 && echo "$(GREEN)✓ All Dockerfiles created$(NC)" || echo "$(RED)✗ Missing Dockerfiles$(NC)"
	@echo ""
	@echo "Checking docker-compose.v2.yml..."
	@test -f docker-compose.v2.yml && echo "$(GREEN)✓ docker-compose.v2.yml exists$(NC)" || echo "$(RED)✗ docker-compose.v2.yml missing$(NC)"
	@echo ""
	@echo "Checking environment templates..."
	@test -f .env.dev.template && echo "$(GREEN)✓ .env.dev.template exists$(NC)" || echo "$(RED)✗ .env.dev.template missing$(NC)"
	@test -f .env.test.template && echo "$(GREEN)✓ .env.test.template exists$(NC)" || echo "$(RED)✗ .env.test.template missing$(NC)"
	@test -f .env.prod.template && echo "$(GREEN)✓ .env.prod.template exists$(NC)" || echo "$(RED)✗ .env.prod.template missing$(NC)"
	@echo ""
	@echo "Checking scripts..."
	@test -x scripts/v2/wait-for-dependencies.sh && echo "$(GREEN)✓ wait-for-dependencies.sh executable$(NC)" || echo "$(RED)✗ wait-for-dependencies.sh not executable$(NC)"
	@test -x scripts/v2/run-tests.sh && echo "$(GREEN)✓ run-tests.sh executable$(NC)" || echo "$(RED)✗ run-tests.sh not executable$(NC)"
	@test -f scripts/v2/init-db.sql && echo "$(GREEN)✓ init-db.sql exists$(NC)" || echo "$(RED)✗ init-db.sql missing$(NC)"
	@echo ""
	@echo "Checking configurations..."
	@test -d configs/base && echo "$(GREEN)✓ configs/base directory exists$(NC)" || echo "$(RED)✗ configs/base missing$(NC)"
	@test -d configs/overlays && echo "$(GREEN)✓ configs/overlays directory exists$(NC)" || echo "$(RED)✗ configs/overlays missing$(NC)"
	@test -d configs/schemas && echo "$(GREEN)✓ configs/schemas directory exists$(NC)" || echo "$(RED)✗ configs/schemas missing$(NC)"
	@echo ""
	@echo "$(GREEN)Week 1 validation complete!$(NC)"

.PHONY: quick-start
quick-start: ## Quick start for development
	@echo "$(GREEN)Quick starting Neural Trader V2...$(NC)"
	@$(MAKE) config-setup
	@$(MAKE) infra-setup
	@sleep 5
	@$(MAKE) db-init
	@echo "$(GREEN)Infrastructure ready! Run 'make up' to start services.$(NC)"
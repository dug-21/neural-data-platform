# Optimized Multi-stage build for Neural Trader - Fixed for Docker Desktop
# Uses BuildKit features for efficient caching and smaller images

# syntax=docker/dockerfile:1.4

# Base builder stage
FROM rustlang/rust:nightly AS base

# Install build dependencies without APT cache mount for compatibility
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    cmake \
    g++ \
    clang \
    libclang-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Cache Cargo dependencies
# Copy only dependency files first
COPY Cargo.docker.toml ./Cargo.toml
COPY Cargo.lock ./

# Copy vendor directory for ruv-fann
COPY vendor vendor/

# Create dummy main.rs to build dependencies
RUN mkdir -p src && echo "fn main() {}" > src/main.rs

# Build dependencies with cache mount
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release && \
    rm -rf src

# Now copy actual source code
COPY . .

# Touch main.rs to ensure it's newer than the dummy
RUN touch src/main.rs

# Build the application with cache
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --bin neural-trader && \
    # Copy the binary out of the cache mount
    cp target/release/neural-trader /tmp/neural-trader

# Development stage - smaller and optimized
FROM rustlang/rust:nightly-slim AS development

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    libpq5 \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy the built binary from base stage
COPY --from=base /tmp/neural-trader /app/neural-trader

# Copy configuration and other necessary files
COPY config config/

# Create non-root user
RUN useradd -m -u 1000 trader && chown -R trader:trader /app

# Switch to non-root user
USER trader

# Expose port
EXPOSE 3030

# Run the binary
ENTRYPOINT ["/app/neural-trader"]

# Production stage
FROM debian:bookworm-slim AS production

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    libpq5 \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy the built binary from base stage
COPY --from=base /tmp/neural-trader /app/neural-trader

# Copy configuration and other necessary files
COPY config config/

# Create non-root user
RUN useradd -m -u 1000 trader && chown -R trader:trader /app

# Switch to non-root user
USER trader

# Expose port
EXPOSE 3030

# Run the binary
ENTRYPOINT ["/app/neural-trader"]
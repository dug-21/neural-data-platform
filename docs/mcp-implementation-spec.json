{
  "mcp_server_spec": {
    "name": "universal-discovery-platform",
    "version": "1.0.0",
    "description": "Universal Discovery Platform MCP Server for pattern recognition and market analysis",
    "tools": {
      "discover_market_connections": {
        "name": "discover_market_connections",
        "description": "Find hidden correlations and connections between different markets, assets, or data sources using AI pattern recognition",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural language query for Claude AI (e.g., 'Find connections between crypto markets and traditional finance')"
            },
            "assets": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Specific assets to analyze (e.g., ['BTC', 'ETH', 'SPY', 'QQQ'])"
            },
            "timeframe": {
              "type": "string",
              "enum": ["1D", "1W", "1M", "3M", "6M", "1Y", "2Y", "5Y"],
              "default": "6M",
              "description": "Analysis timeframe"
            },
            "correlation_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["pearson", "spearman", "kendall", "mutual_info", "maximal_info"]
              },
              "default": ["pearson", "spearman"],
              "description": "Types of correlation to calculate"
            },
            "confidence_threshold": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.0,
              "default": 0.75,
              "description": "Minimum confidence for connections"
            },
            "include_lagged": {
              "type": "boolean",
              "default": true,
              "description": "Include time-lagged correlations"
            },
            "max_lag_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30,
              "description": "Maximum lag to consider"
            },
            "discovery_mode": {
              "type": "string",
              "enum": ["guided", "exhaustive", "targeted"],
              "default": "guided",
              "description": "Discovery approach"
            }
          }
        },
        "permissions": ["discovery_access"],
        "rate_limit": {
          "requests_per_hour": 100,
          "burst_limit": 10
        }
      },
      
      "test_hypothesis": {
        "name": "test_hypothesis", 
        "description": "Test specific hypotheses using historical data and statistical analysis with backtesting and validation metrics",
        "inputSchema": {
          "type": "object",
          "required": ["hypothesis", "test_period"],
          "properties": {
            "hypothesis": {
              "type": "string",
              "description": "Hypothesis to test in natural language (e.g., 'RSI oversold signals provide positive returns within 7 days')"
            },
            "test_period": {
              "type": "string",
              "description": "Historical period for testing (e.g., '2Y', '5Y')"
            },
            "parameters": {
              "type": "object",
              "description": "Specific parameters for the hypothesis",
              "additionalProperties": true
            },
            "validation_method": {
              "type": "string",
              "enum": ["backtest", "walk_forward", "bootstrap", "monte_carlo"],
              "default": "backtest",
              "description": "Validation method to use"
            },
            "significance_level": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.1,
              "default": 0.05,
              "description": "Statistical significance level"
            }
          }
        },
        "permissions": ["hypothesis_testing"],
        "rate_limit": {
          "requests_per_hour": 100,
          "burst_limit": 5
        }
      },

      "analyze_correlation": {
        "name": "analyze_correlation",
        "description": "Perform deep correlation analysis between multiple data sources using various statistical methods",
        "inputSchema": {
          "type": "object",
          "required": ["datasets"],
          "properties": {
            "datasets": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Datasets to analyze for correlations"
            },
            "methods": {
              "type": "array", 
              "items": {
                "type": "string",
                "enum": ["pearson", "spearman", "kendall", "mutual_info", "distance_correlation"]
              },
              "default": ["pearson", "spearman"],
              "description": "Correlation methods to use"
            },
            "time_window": {
              "type": "integer",
              "description": "Rolling window size for time-series analysis"
            },
            "include_partial_correlations": {
              "type": "boolean",
              "default": false,
              "description": "Include partial correlation analysis"
            },
            "regime_analysis": {
              "type": "boolean", 
              "default": false,
              "description": "Analyze correlations in different market regimes"
            }
          }
        },
        "permissions": ["correlation_analysis"],
        "rate_limit": {
          "requests_per_hour": 100,
          "burst_limit": 10
        }
      },

      "find_patterns": {
        "name": "find_patterns",
        "description": "Use machine learning to identify recurring patterns, anomalies, and predictive signals across data streams",
        "inputSchema": {
          "type": "object",
          "required": ["data_sources"],
          "properties": {
            "data_sources": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Data sources to analyze for patterns"
            },
            "pattern_types": {
              "type": "array",
              "items": {
                "type": "string", 
                "enum": ["technical", "seasonal", "event_driven", "anomaly", "behavioral"]
              },
              "description": "Types of patterns to search for"
            },
            "lookback_period": {
              "type": "string",
              "description": "Historical period to analyze"
            },
            "min_pattern_frequency": {
              "type": "integer",
              "default": 3,
              "description": "Minimum occurrences for pattern validity"
            },
            "confidence_threshold": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.0,
              "default": 0.8,
              "description": "Minimum confidence for pattern identification"
            }
          }
        },
        "permissions": ["pattern_recognition"],
        "rate_limit": {
          "requests_per_hour": 100,
          "burst_limit": 8
        }
      },

      "predict_outcomes": {
        "name": "predict_outcomes",
        "description": "Generate predictions using discovered patterns and AI models with confidence intervals",
        "inputSchema": {
          "type": "object",
          "required": ["target_variable", "prediction_horizon"],
          "properties": {
            "target_variable": {
              "type": "string",
              "description": "What to predict (e.g., 'BTC_price_1d', 'SPY_volatility')"
            },
            "prediction_horizon": {
              "type": "string", 
              "description": "Time horizon for prediction (e.g., '1D', '1W', '1M')"
            },
            "input_features": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Features to use for prediction"
            },
            "model_type": {
              "type": "string",
              "enum": ["neural_network", "random_forest", "xgboost", "lstm", "transformer"],
              "default": "neural_network",
              "description": "Model type for prediction"
            },
            "confidence_intervals": {
              "type": "boolean",
              "default": true,
              "description": "Include prediction confidence intervals"
            }
          }
        },
        "permissions": ["prediction_modeling"],
        "rate_limit": {
          "requests_per_hour": 100,
          "burst_limit": 5
        }
      },

      "watch_markets": {
        "name": "watch_markets",
        "description": "Set up real-time monitoring streams for specified markets or conditions with alerts",
        "inputSchema": {
          "type": "object",
          "required": ["watch_name", "conditions"],
          "properties": {
            "watch_name": {
              "type": "string",
              "description": "Name for this watch configuration"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "asset": {"type": "string"},
                  "condition_type": {
                    "type": "string",
                    "enum": ["price_change", "volume_spike", "volatility_change", "pattern_formation"]
                  },
                  "threshold": {"type": "number"},
                  "direction": {
                    "type": "string",
                    "enum": ["above", "below", "crosses_above", "crosses_below"]
                  }
                }
              },
              "description": "Conditions to monitor"
            },
            "notification_settings": {
              "type": "object",
              "properties": {
                "webhook_url": {"type": "string", "format": "uri"},
                "email": {"type": "string", "format": "email"},
                "push_notification": {"type": "boolean"},
                "priority": {
                  "type": "string",
                  "enum": ["low", "medium", "high", "critical"]
                }
              },
              "description": "Notification configuration"
            },
            "update_frequency": {
              "type": "string",
              "enum": ["realtime", "1min", "5min", "15min", "1hour"],
              "default": "realtime",
              "description": "Update frequency for monitoring"
            }
          }
        },
        "permissions": ["market_monitoring"],
        "rate_limit": {
          "requests_per_hour": 1000,
          "burst_limit": 50
        }
      },

      "track_performance": {
        "name": "track_performance",
        "description": "Track strategy and discovery performance with metrics including P&L, accuracy, and risk measures",
        "inputSchema": {
          "type": "object",
          "properties": {
            "strategy_id": {
              "type": "string",
              "description": "Specific strategy to track"
            },
            "timeframe": {
              "type": "string",
              "enum": ["1D", "1W", "1M", "3M", "6M", "1Y", "ALL"],
              "default": "1M",
              "description": "Time period for performance calculation"
            },
            "include_attribution": {
              "type": "boolean",
              "default": false,
              "description": "Include performance attribution analysis"
            }
          }
        },
        "permissions": ["performance_tracking"],
        "rate_limit": {
          "requests_per_hour": 1000,
          "burst_limit": 100
        }
      },

      "get_alerts": {
        "name": "get_alerts",
        "description": "Retrieve current alerts and notifications from monitoring systems",
        "inputSchema": {
          "type": "object",
          "properties": {
            "priority": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"],
              "description": "Filter by alert priority"
            },
            "status": {
              "type": "string", 
              "enum": ["active", "acknowledged", "resolved"],
              "description": "Filter by alert status"
            },
            "limit": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "description": "Maximum number of alerts to return"
            }
          }
        },
        "permissions": ["alert_access"],
        "rate_limit": {
          "requests_per_hour": 1000,
          "burst_limit": 200
        }
      },

      "view_discoveries": {
        "name": "view_discoveries",
        "description": "View recent discoveries and insights generated by the platform's AI systems",
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": ["correlations", "patterns", "anomalies", "opportunities", "risks"],
              "description": "Filter by discovery category"
            },
            "confidence_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.7,
              "description": "Minimum confidence threshold"
            },
            "timeframe": {
              "type": "string",
              "default": "1D",
              "description": "Time period for discoveries"
            }
          }
        },
        "permissions": ["discovery_access"],
        "rate_limit": {
          "requests_per_hour": 1000,
          "burst_limit": 100
        }
      },

      "create_strategy": {
        "name": "create_strategy",
        "description": "Create new trading strategy based on discovered patterns or rules with backtesting",
        "inputSchema": {
          "type": "object",
          "required": ["name", "strategy_type"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Strategy name"
            },
            "strategy_type": {
              "type": "string",
              "enum": ["pattern_based", "correlation", "mean_reversion", "momentum", "risk_parity"],
              "description": "Type of strategy"
            },
            "description": {
              "type": "string",
              "description": "Strategy description"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "type": {
                    "type": "string",
                    "enum": ["entry", "exit", "risk_management", "position_sizing"]
                  },
                  "conditions": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "actions": {
                    "type": "array", 
                    "items": {"type": "string"}
                  }
                }
              },
              "description": "Trading rules"
            },
            "risk_parameters": {
              "type": "object",
              "properties": {
                "max_position_size": {"type": "number"},
                "max_portfolio_risk": {"type": "number"},
                "stop_loss": {"type": "number"},
                "max_drawdown": {"type": "number"}
              },
              "description": "Risk management parameters"
            },
            "universe": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Assets the strategy can trade"
            }
          }
        },
        "permissions": ["strategy_creation"],
        "rate_limit": {
          "requests_per_hour": 500,
          "burst_limit": 20
        }
      },

      "deploy_rule": {
        "name": "deploy_rule",
        "description": "Deploy specific trading rule or signal generator based on discovered patterns",
        "inputSchema": {
          "type": "object",
          "required": ["rule_name", "rule_type", "conditions"],
          "properties": {
            "rule_name": {
              "type": "string",
              "description": "Name for the trading rule"
            },
            "rule_type": {
              "type": "string",
              "enum": ["entry", "exit", "risk_management", "rebalancing", "stop_loss"],
              "description": "Type of trading rule"
            },
            "conditions": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Conditions that trigger the rule"
            },
            "actions": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Actions to take when triggered"
            },
            "priority": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Rule priority (1-10)"
            },
            "active": {
              "type": "boolean",
              "default": true,
              "description": "Whether rule is active"
            }
          }
        },
        "permissions": ["rule_deployment"],
        "rate_limit": {
          "requests_per_hour": 500,
          "burst_limit": 30
        }
      },

      "execute_trade": {
        "name": "execute_trade",
        "description": "Execute trading order based on strategy signals or manual input with various order types",
        "inputSchema": {
          "type": "object",
          "required": ["asset", "side", "quantity"],
          "properties": {
            "asset": {
              "type": "string",
              "description": "Asset to trade"
            },
            "side": {
              "type": "string", 
              "enum": ["buy", "sell"],
              "description": "Order side"
            },
            "quantity": {
              "type": "number",
              "description": "Quantity to trade"
            },
            "order_type": {
              "type": "string",
              "enum": ["market", "limit", "stop", "stop_limit", "twap", "vwap"],
              "default": "market",
              "description": "Order type"
            },
            "limit_price": {
              "type": "number",
              "description": "Limit price for limit orders"
            },
            "stop_price": {
              "type": "number",
              "description": "Stop price for stop orders"
            },
            "time_in_force": {
              "type": "string",
              "enum": ["day", "gtc", "ioc", "fok"],
              "default": "day",
              "description": "Time in force"
            },
            "execution_algorithm": {
              "type": "string",
              "enum": ["aggressive", "passive", "stealth", "implementation_shortfall"],
              "default": "aggressive",
              "description": "Execution algorithm"
            }
          }
        },
        "permissions": ["trade_execution"],
        "rate_limit": {
          "requests_per_hour": 500,
          "burst_limit": 100
        }
      },

      "manage_portfolio": {
        "name": "manage_portfolio",
        "description": "Retrieve portfolio positions, performance, and optimization recommendations",
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_recommendations": {
              "type": "boolean",
              "default": false,
              "description": "Include optimization recommendations"
            },
            "risk_level": {
              "type": "string",
              "enum": ["conservative", "moderate", "aggressive"],
              "description": "Desired risk level for recommendations"
            }
          }
        },
        "permissions": ["portfolio_management"],
        "rate_limit": {
          "requests_per_hour": 500,
          "burst_limit": 50
        }
      },

      "configure_streams": {
        "name": "configure_streams",
        "description": "Configure real-time data streams and feeds for the platform",
        "inputSchema": {
          "type": "object",
          "required": ["stream_name", "data_source"],
          "properties": {
            "stream_name": {
              "type": "string",
              "description": "Name for the data stream"
            },
            "data_source": {
              "type": "string",
              "enum": ["market_data", "news", "social_sentiment", "economic", "alternative"],
              "description": "Type of data source"
            },
            "provider": {
              "type": "string",
              "description": "Data provider"
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true,
              "description": "Provider-specific configuration"
            },
            "update_frequency": {
              "type": "string",
              "enum": ["realtime", "1min", "5min", "15min", "1hour", "daily"],
              "description": "Update frequency"
            },
            "active": {
              "type": "boolean",
              "default": true,
              "description": "Whether stream is active"
            }
          }
        },
        "permissions": ["system_admin"],
        "rate_limit": {
          "requests_per_hour": 50,
          "burst_limit": 10
        }
      },

      "manage_domains": {
        "name": "manage_domains",
        "description": "Manage different discovery domains and their configurations",
        "inputSchema": {
          "type": "object",
          "required": ["domain_name", "action"],
          "properties": {
            "domain_name": {
              "type": "string",
              "enum": ["equities", "fixed_income", "commodities", "cryptocurrencies", "alternatives"],
              "description": "Domain to manage"
            },
            "action": {
              "type": "string",
              "enum": ["enable", "disable", "configure", "optimize"],
              "description": "Action to perform"
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true,
              "description": "Domain-specific configuration"
            }
          }
        },
        "permissions": ["domain_management"],
        "rate_limit": {
          "requests_per_hour": 50,
          "burst_limit": 10
        }
      },

      "set_parameters": {
        "name": "set_parameters",
        "description": "Update global system parameters for discovery algorithms, risk management, and execution",
        "inputSchema": {
          "type": "object",
          "properties": {
            "discovery_parameters": {
              "type": "object",
              "properties": {
                "sensitivity": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1.0
                },
                "confidence_threshold": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 0.99
                }
              },
              "description": "Discovery algorithm parameters"
            },
            "risk_parameters": {
              "type": "object",
              "properties": {
                "max_var": {"type": "number"},
                "max_drawdown": {"type": "number"},
                "concentration_limit": {"type": "number"}
              },
              "description": "Risk management parameters"
            },
            "execution_parameters": {
              "type": "object",
              "properties": {
                "slippage_tolerance": {"type": "number"},
                "market_impact_limit": {"type": "number"}
              },
              "description": "Execution system parameters"
            }
          }
        },
        "permissions": ["parameter_management"],
        "rate_limit": {
          "requests_per_hour": 50,
          "burst_limit": 5
        }
      },

      "control_scaling": {
        "name": "control_scaling",
        "description": "Control system scaling for handling increased load and computational requirements",
        "inputSchema": {
          "type": "object",
          "required": ["scaling_action"],
          "properties": {
            "scaling_action": {
              "type": "string",
              "enum": ["scale_up", "scale_down", "auto_scale", "manual_scale"],
              "description": "Scaling action to perform"
            },
            "target_capacity": {
              "type": "integer",
              "description": "Target processing capacity percentage"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["discovery_engine", "execution_engine", "data_processing", "monitoring"]
              },
              "description": "Components to scale"
            }
          }
        },
        "permissions": ["scaling_control"],
        "rate_limit": {
          "requests_per_hour": 50,
          "burst_limit": 5
        }
      }
    },

    "permissions": {
      "discovery_access": {
        "description": "Access to discovery and pattern recognition tools",
        "required_for": ["discover_market_connections", "view_discoveries"]
      },
      "hypothesis_testing": {
        "description": "Permission to test trading hypotheses",
        "required_for": ["test_hypothesis"]
      },
      "correlation_analysis": {
        "description": "Access to correlation analysis tools",
        "required_for": ["analyze_correlation"]
      },
      "pattern_recognition": {
        "description": "Access to pattern finding capabilities",
        "required_for": ["find_patterns"]
      },
      "prediction_modeling": {
        "description": "Access to prediction and forecasting models",
        "required_for": ["predict_outcomes"]
      },
      "market_monitoring": {
        "description": "Permission to set up market monitoring",
        "required_for": ["watch_markets"]
      },
      "performance_tracking": {
        "description": "Access to performance tracking data",
        "required_for": ["track_performance"]
      },
      "alert_access": {
        "description": "Access to system alerts and notifications",
        "required_for": ["get_alerts"]
      },
      "strategy_creation": {
        "description": "Permission to create trading strategies",
        "required_for": ["create_strategy"]
      },
      "rule_deployment": {
        "description": "Permission to deploy trading rules",
        "required_for": ["deploy_rule"]
      },
      "trade_execution": {
        "description": "Permission to execute trades",
        "required_for": ["execute_trade"]
      },
      "portfolio_management": {
        "description": "Access to portfolio management tools",
        "required_for": ["manage_portfolio"]
      },
      "system_admin": {
        "description": "Administrative access to system configuration",
        "required_for": ["configure_streams"]
      },
      "domain_management": {
        "description": "Permission to manage discovery domains",
        "required_for": ["manage_domains"]
      },
      "parameter_management": {
        "description": "Permission to modify system parameters",
        "required_for": ["set_parameters"]
      },
      "scaling_control": {
        "description": "Permission to control system scaling",
        "required_for": ["control_scaling"]
      }
    },

    "rate_limits": {
      "discovery_tools": {
        "requests_per_hour": 100,
        "burst_limit": 10,
        "tools": ["discover_market_connections", "test_hypothesis", "analyze_correlation", "find_patterns", "predict_outcomes"]
      },
      "monitoring_tools": {
        "requests_per_hour": 1000,
        "burst_limit": 100,
        "tools": ["watch_markets", "track_performance", "get_alerts", "view_discoveries"]
      },
      "execution_tools": {
        "requests_per_hour": 500,
        "burst_limit": 50,
        "tools": ["create_strategy", "deploy_rule", "execute_trade", "manage_portfolio"]
      },
      "system_tools": {
        "requests_per_hour": 50,
        "burst_limit": 10,
        "tools": ["configure_streams", "manage_domains", "set_parameters", "control_scaling"]
      }
    },

    "examples": {
      "claude_discovery": {
        "tool": "discover_market_connections",
        "input": {
          "query": "Find connections between crypto fear index and traditional equity volatility",
          "timeframe": "6M",
          "confidence_threshold": 0.75
        },
        "description": "Claude AI discovering market connections using natural language"
      },
      "human_correlation": {
        "tool": "analyze_correlation",
        "input": {
          "datasets": ["BTC", "SPY", "VIX", "GOLD"],
          "methods": ["pearson", "spearman", "mutual_info"],
          "time_window": 60
        },
        "description": "Human analyst performing detailed correlation analysis"
      },
      "hypothesis_test": {
        "tool": "test_hypothesis",
        "input": {
          "hypothesis": "RSI oversold signals in crypto provide 15%+ returns within 7 days",
          "test_period": "2Y",
          "parameters": {

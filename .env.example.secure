# Neural Trader Secure Environment Variables Template
# Copy this file to .env and update with your secure values
# IMPORTANT: Never commit .env files to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Connection (Production should use secrets management)
DATABASE_URL=postgresql://neural_trader:CHANGE_ME@localhost:5432/neural_trader_db
POSTGRES_USER=neural_trader
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=neural_trader_db

# Database Performance Tuning
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=200

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_REDIS_PASSWORD

# Redis Performance
REDIS_MAXMEMORY=4gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_TIMEOUT=300

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Logging Configuration
RUST_LOG=info
RUST_BACKTRACE=1
LOG_LEVEL=INFO
NODE_ENV=production

# Application Security
JWT_SECRET=CHANGE_ME_TO_64_CHARACTER_SECURE_KEY_GENERATE_WITH_OPENSSL_RAND
ENCRYPTION_KEY=CHANGE_ME_TO_32_CHARACTER_SECURE_KEY_FOR_DATA_ENCRYPTION

# =============================================================================
# API KEYS (Use secrets management in production)
# =============================================================================

# Market Data Providers
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE
POLYGON_API_KEY=YOUR_POLYGON_KEY_HERE
IEX_CLOUD_API_KEY=YOUR_IEX_CLOUD_KEY_HERE
YAHOO_FINANCE_API_KEY=YOUR_YAHOO_FINANCE_KEY_HERE

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Trading Mode (paper/live)
TRADING_MODE=paper
MAX_POSITION_SIZE=10000
RISK_LIMIT=0.02
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.10

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================

# Metrics
METRICS_PORT=3030
PROMETHEUS_RETENTION_DAYS=30

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_GRAFANA_PASSWORD
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_GRAFANA_PASSWORD

# =============================================================================
# EMAIL CONFIGURATION (For production alerts)
# =============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@yourdomain.com

# Alert Configuration
ALERT_EMAIL=alerts@yourdomain.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/neuraltrader.crt
SSL_KEY_PATH=/etc/ssl/private/neuraltrader.key
SSL_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# Network Security
ALLOWED_HOSTS=localhost,127.0.0.1,neuraltrader.com
CORS_ORIGINS=https://app.neuraltrader.com,https://dashboard.neuraltrader.com

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Compose
COMPOSE_PROJECT_NAME=neural_trader
DOCKER_CLIENT_TIMEOUT=120
COMPOSE_HTTP_TIMEOUT=120

# Container Resource Limits
POSTGRES_MEMORY_LIMIT=8g
REDIS_MEMORY_LIMIT=4g
APP_MEMORY_LIMIT=4g
INGESTION_MEMORY_LIMIT=2g

# =============================================================================
# ENVIRONMENT SPECIFIC OVERRIDES
# =============================================================================

# Environment
NODE_ENV=production
RUST_ENV=production
PYTHON_ENV=production

# Feature Flags
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_BACKTESTING=true
ENABLE_MONITORING=true
ENABLE_ALERTS=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_ENCRYPTION_KEY=CHANGE_ME_TO_SECURE_BACKUP_ENCRYPTION_KEY
BACKUP_STORAGE_PATH=/secure/backups

# S3 Backup (Optional)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=neural-trader-backups

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Application Performance
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30
CONNECTION_POOL_SIZE=20
CACHE_TTL=300

# Database Performance
DB_POOL_SIZE=20
DB_MAX_CONNECTIONS=100
DB_IDLE_TIMEOUT=300

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# Session Configuration
SESSION_SECRET=CHANGE_ME_TO_SECURE_SESSION_SECRET
SESSION_TIMEOUT=1800  # 30 minutes
SESSION_SECURE=true

# API Security
API_KEY_HEADER=X-API-Key
API_RATE_LIMIT=1000
API_RATE_WINDOW=3600  # 1 hour

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Metrics Configuration
METRICS_ENABLED=true
METRICS_INTERVAL=60
METRICS_RETENTION=7d

# =============================================================================
# DEVELOPMENT OVERRIDES (Comment out in production)
# =============================================================================

# Development Settings (Remove in production)
# RUST_LOG=debug
# RUST_BACKTRACE=full
# LOG_LEVEL=DEBUG
# PYTHONDEBUG=1
# ENABLE_DEBUG_ENDPOINTS=true

# =============================================================================
# COMMAND EXAMPLES FOR SECURE KEY GENERATION
# =============================================================================

# Generate secure passwords and keys:
# 
# JWT Secret (64 characters):
# openssl rand -base64 48 | tr -d '\n'
#
# Encryption Key (32 characters):
# openssl rand -base64 24 | tr -d '\n'
#
# Database Password (32 characters):
# openssl rand -base64 24 | tr -d '\n'
#
# Redis Password (32 characters):
# openssl rand -base64 24 | tr -d '\n'
#
# Session Secret (64 characters):
# openssl rand -base64 48 | tr -d '\n'
#
# Backup Encryption Key (32 characters):
# openssl rand -base64 24 | tr -d '\n'

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. NEVER commit .env files to version control
# 2. Use environment-specific files (.env.development, .env.production)
# 3. In production, use secrets management (Docker secrets, HashiCorp Vault, etc.)
# 4. Regularly rotate all passwords and API keys
# 5. Use strong, unique passwords for each service
# 6. Enable 2FA for all external services
# 7. Monitor for exposed secrets in logs
# 8. Implement proper access controls and network isolation
# 9. Regular security audits and penetration testing
# 10. Keep all dependencies and images updated
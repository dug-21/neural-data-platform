        <mxCell id="architecture-principles" value="UNIFIED ARCHITECTURE PRINCIPLES&#xa;&#xa;✓ SINGLE DATA ROUTE: No dual paths&#xa;✓ ML-OPS OWNS FEATURES: Only source of EventBus data&#xa;✓ TIMESCALE INTEGRATION: Historical context required&#xa;✓ NO RAW DATA BRIDGE: Trading gets only processed features&#xa;✓ NO FALLBACK CHANNELS: Simplified single-flow design&#xa;&#xa;ELIMINATED COMPLEXITY:&#xa;❌ Dual subscription management&#xa;❌ Raw data emergency channels&#xa;❌ Channel coordination logic&#xa;❌ Data consistency between multiple sources" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="620" width="300" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="performance-metrics" value="PERFORMANCE TARGETS&#xa;&#xa;Real-time processing: &lt; 50ms&#xa;ML feature generation: &lt; 100ms&#xa;EventBus delivery: &lt; 25ms&#xa;End-to-end latency: &lt; 200ms&#xa;TimescaleDB queries: &lt; 500ms&#xa;EventBus throughput: 5k events/sec&#xa;&#xa;FAST DATA: Redis (&lt; 1s)&#xa;SLOW DATA: TimescaleDB (&gt; 1s)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">

        <mxCell id="ml-ops-hub" value="Neural-ML-Ops Unified Data Hub&#xa;&#xa;CORE COMPONENTS:&#xa;• DataIngestionLayer (Redis)&#xa;• HistoricalDataClient (TimescaleDB)&#xa;• FeatureEngineeringEngine&#xa;• EventPublisher (EventBus)&#xa;• TrainingCoordinator&#xa;• ModelRegistry&#xa;&#xa;DATA FLOW:&#xa;Real-time + Historical → Features → EventBus" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="650" y="160" width="280" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="eventbus" value="EventBus&#xa;ML Features Channel ONLY&#xa;&#xa;• stream:ml:features:{symbol}&#xa;• stream:ml:internal:*&#xa;&#xa;Content:&#xa;• Technical indicators&#xa;• Market microstructure&#xa;• Risk metrics&#xa;• ML predictions&#xa;• Economic context&#xa;&#xa;Retention: 24h&#xa;Throughput: 5k events/sec" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">

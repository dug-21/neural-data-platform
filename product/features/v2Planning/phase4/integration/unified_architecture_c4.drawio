        <mxCell id="timescaledb" value="TimescaleDB&#xa;Historical Storage&#xa;&#xa;• OHLCV data (> 1h old)&#xa;• Economic indicators&#xa;• Reference data&#xa;• Training datasets&#xa;&#xa;Retention: Years&#xa;Query time: &lt; 500ms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">

        <!-- Diagram Title -->
        <mxCell id="component-title" value="ML Ops Platform - Detailed Component Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="550" y="10" width="600" height="30" as="geometry" />
        </mxCell>
        
        <!-- Technology Stack Box -->
        <mxCell id="tech-stack-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#F5F5F5;fontColor=#333333;align=left;arcSize=10;strokeColor=#CCCCCC;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="970" width="600" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="tech-title" value="Key Technologies Used" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="980" width="180" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="tech-content" value="• ruv-FANN: High-performance neural network training with genetic algorithms&#xa;• Redis Streams: Event-driven feature and model distribution&#xa;• TimescaleDB: Time-series data storage for features and metrics&#xa;• Protocol Buffers: Efficient serialization for network transmission&#xa;• Tokio: Async runtime for high-performance I/O operations&#xa;• Prometheus: Metrics collection and monitoring" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="1000" width="580" height="80" as="geometry" />
        </mxCell>
        
        <!-- Data Flow Direction Box -->
        <mxCell id="flow-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#F5F5F5;fontColor=#333333;align=left;arcSize=10;strokeColor=#CCCCCC;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="970" width="600" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-title" value="Data Flow Summary" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="980" width="180" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-content" value="1. Raw Data → Feature Extraction → Feature Store → Redis Streams&#xa;2. Training Data → ruv-FANN → Model Validation → Model Store → Redis Streams&#xa;3. Feedback Streams → Drift Detection → Retraining Triggers&#xa;4. All Components → Performance Monitoring → Health Dashboards&#xa;5. Configuration Store → Dynamic Parameter Updates → All Components&#xa;6. Redis Streams → Domain-specific subscribers (trading, healthcare, IoT)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="1000" width="580" height="80" as="geometry" />
        </mxCell>
        
        <!-- Performance Characteristics Box -->
        <mxCell id="perf-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#F5F5F5;fontColor=#333333;align=left;arcSize=10;strokeColor=#CCCCCC;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1360" y="970" width="360" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="perf-title" value="Performance Characteristics" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1370" y="980" width="200" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="perf-content" value="• Feature Extraction: ~10ms latency&#xa;• Model Training: Minutes to hours&#xa;• Model Inference: Sub-millisecond&#xa;• Event Publishing: ~1ms latency&#xa;• Drift Detection: Real-time streaming&#xa;• Storage: Horizontally scalable" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1000" width="340" height="80" as="geometry" />
        </mxCell>
      </root>

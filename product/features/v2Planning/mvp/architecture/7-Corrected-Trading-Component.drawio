          </mxCell>
        </object>

        <object placeholders="1" c4Name="Interface Contracts" c4Type="Note" c4Description="Data Ingestion: RegisterSource, StreamData, GetSchema&#10;Model Execution: LoadModel, Predict, GetMetrics&#10;Action Execution: ExecuteAction, ValidateAction, GetCapabilities&#10;All interfaces use standard gRPC with protobuf schemas&#10;Domain Registry manages interface discovery and validation" label="&lt;font style=&quot;font-size: 12px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size: 10px&quot;&gt;%c4Description%&lt;/div&gt;" id="contracts-note">

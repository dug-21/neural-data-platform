        <object placeholders="1" c4Name="[Component] Trading Domain - Interface Implementation" c4Type="ComponentDiagramTitle" c4Description="Shows how trading domain implements standard interfaces while maintaining domain-specific logic" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;%c4Description%&lt;/div&gt;" id="title">

# Simple Dockerfile for testing async fix
FROM rust:latest as builder

WORKDIR /app

# Copy everything
COPY . .

# Build
RUN cargo build --release --bin neural-trader

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    libssl3 \
    libpq5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/neural-trader /usr/local/bin/neural-trader
COPY --from=builder /app/config /config

ENV RUST_LOG=info
ENV RUST_BACKTRACE=1

# Enable Phase 2 & 3 Features
ENV ENABLE_AUTONOMOUS_TRAINING=true
ENV ENABLE_SECTOR_MODELS=true
ENV ENABLE_REALTIME_ADAPTATION=true
ENV ENABLE_DATA_DISCOVERY=true

# Configuration Paths
ENV SECTOR_CONFIG_PATH=/config/sector_models.toml
ENV AUTONOMOUS_TRAINING_CONFIG=/config/autonomous_training.toml
ENV DATA_REQUIREMENTS_CONFIG=/config/data_requirements.toml

EXPOSE 8080

CMD ["neural-trader"]
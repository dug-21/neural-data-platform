{
  "$schema": "../../../../schemas/manifest.schema.json",
  "version": "1.0",
  "description": "Smoke testbed: full rebuild + minimal validation (tools, containers, 1 stream, silver, domain)",
  "changes": [
    {"type": "container", "target": "air-quality-app", "action": "build", "no_cache": true},

    {"type": "tool", "id": "ndp-cli", "action": "build"},
    {"type": "tool", "id": "ndp-validate", "action": "build"},
    {"type": "tool", "id": "ndp-gold-ddl", "action": "build"},

    {"type": "stream", "id": "air-quality", "action": "update"},

    {"type": "silver-table", "stream_id": "air-quality", "action": "sync"},

    {"type": "dictionary", "action": "sync"},

    {"type": "domain", "domain_id": "indoor-air-quality", "action": "sync"},

    {"type": "container", "target": "air-quality-app", "action": "restart"}
  ]
}

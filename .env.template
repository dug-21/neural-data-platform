# Neural Trader Environment Configuration Template
# Copy this file to .env and customize for your environment
#
# Available Environment Files:
# - .env.dev    (Development with debug settings)
# - .env.test   (Testing with isolated database)
# - .env.prod   (Production with secure defaults)

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================

# CONFIG_ENV: Environment identifier (dev|test|prod)
# Used by the application to determine configuration profile
CONFIG_ENV=dev

# LOG_LEVEL: Application logging level (debug|info|warn|error)
# debug: Verbose logging for development
# info: Standard operational logging
# warn: Warnings and errors only
# error: Errors only
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# POSTGRES_PASSWORD: PostgreSQL database password
# Use strong passwords in production
POSTGRES_PASSWORD=your_secure_password

# DATABASE_URL: Full PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Dev/Test: localhost:5432
# Prod: Use container names (timescaledb:5432)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/neural_trader

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

# REDIS_URL: Redis connection string for caching and real-time data
# Format: redis://host:port
# Dev/Test: localhost:6379
# Prod: Use container name (redis:6379)
REDIS_URL=redis://localhost:6379

# ==============================================================================
# CONFIG STORE
# ==============================================================================

# CONFIG_REPO_URL: Git repository for external configuration management
# Store trading strategies, model parameters, and environment-specific configs
CONFIG_REPO_URL=https://github.com/your-org/neural-trader-configs.git

# CONFIG_BRANCH: Git branch for configuration
# main: Development configs
# test: Testing configs  
# production: Production configs
CONFIG_BRANCH=main

# ==============================================================================
# API KEYS & EXTERNAL SERVICES
# ==============================================================================

# POLYGON_API_KEY: Polygon.io API key for market data
# Get from: https://polygon.io/
# Use test keys in development
POLYGON_API_KEY=your_polygon_api_key

# ALPHA_VANTAGE_API_KEY: Alpha Vantage API key for additional market data
# Get from: https://www.alphavantage.co/
# Free tier available for development
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# ==============================================================================
# HOME ASSISTANT CONFIGURATION
# ==============================================================================

# HASS_URL: Home Assistant REST API base URL
# Format: http://host:port (no trailing slash)
# Examples:
#   - http://homeassistant.local:8123 (mDNS)
#   - http://192.168.1.100:8123 (direct IP)
#   - https://your-ha.duckdns.org (external with SSL)
HASS_URL=http://homeassistant.local:8123

# HASS_ACCESS_TOKEN: Long-lived access token for Home Assistant API
# Generate from: HA Profile -> Security -> Long-lived Access Tokens
# Keep this secure and never commit to version control
HASS_ACCESS_TOKEN=your_long_lived_access_token

# ==============================================================================
# BROKER CONFIGURATION
# ==============================================================================

# BROKER_ENDPOINT: Trading broker API endpoint
# Paper Trading: https://paper-api.alpaca.markets
# Live Trading: https://api.alpaca.markets
BROKER_ENDPOINT=https://paper-api.alpaca.markets

# BROKER_API_KEY: Broker API key
# Get from your broker's developer portal
BROKER_API_KEY=your_broker_api_key

# BROKER_API_SECRET: Broker API secret
# Keep this secure and never commit to version control
BROKER_API_SECRET=your_broker_api_secret

# ==============================================================================
# TRADING CONFIGURATION
# ==============================================================================

# TRADING_MODE: Trading execution mode (paper|live)
# paper: Simulated trading with fake money
# live: Real trading with real money (USE WITH CAUTION!)
TRADING_MODE=paper

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# GRAFANA_USER: Grafana dashboard username
# Default admin user for development
GRAFANA_USER=admin

# GRAFANA_PASSWORD: Grafana dashboard password
# Use secure password in production
GRAFANA_PASSWORD=admin

# ==============================================================================
# TESTING CONFIGURATION (Test Environment Only)
# ==============================================================================

# TEST_TYPE: Type of tests to run (unit|integration|e2e|all)
# all: Run complete test suite
# unit: Unit tests only
# integration: Integration tests only
# e2e: End-to-end tests only
TEST_TYPE=all

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
#
# 1. NEVER commit .env files to version control
# 2. Use strong, unique passwords for production
# 3. Rotate API keys regularly
# 4. Use paper trading mode during development
# 5. Store production secrets in secure vaults (AWS Secrets Manager, etc.)
# 6. Enable 2FA on all broker and API accounts
# 7. Monitor API key usage for unusual activity
#
# ==============================================================================
# ENVIRONMENT SETUP
# ==============================================================================
#
# Development:
# 1. Copy .env.dev to .env
# 2. Update API keys with your test keys
# 3. Start local PostgreSQL and Redis
# 4. Run: docker-compose -f docker-compose.dev.yml up
#
# Testing:
# 1. Copy .env.test to .env
# 2. Ensure test database is isolated
# 3. Run: npm run test
#
# Production:
# 1. Copy .env.prod to .env
# 2. Update ALL placeholder values
# 3. Use secure password management
# 4. Run: docker-compose -f docker-compose.prod.yml up
#
# ==============================================================================
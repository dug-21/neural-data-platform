{
  "name": "Neural Trader Development - Podman",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bullseye",
  
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.checkOnSave.command": "clippy",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "files.watcherExclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/.git/**": true
        }
      }
    }
  },

  "forwardPorts": [
    3030,  // Neural Trader API
    5432,  // PostgreSQL/TimescaleDB
    6379,  // Redis
    3000,  // Grafana Dashboard
    8001,  // Data Ingestion Metrics
    9090,  // Prometheus
    8081,  // Redis Commander
    8082   // pgAdmin
  ],
  
  "portsAttributes": {
    "3030": { "label": "Neural Trader API", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL/TimescaleDB", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" },
    "3000": { "label": "Grafana Dashboard", "onAutoForward": "openBrowser" },
    "8001": { "label": "Data Ingestion Metrics", "onAutoForward": "notify" },
    "9090": { "label": "Prometheus Metrics", "onAutoForward": "notify" },
    "8081": { "label": "Redis Commander", "onAutoForward": "notify" },
    "8082": { "label": "pgAdmin", "onAutoForward": "notify" }
  },
  
  "postCreateCommand": "chmod +x .devcontainer/setup-minimal.sh && .devcontainer/setup-minimal.sh",
  "postStartCommand": "chmod +x .devcontainer/post-start-minimal.sh && .devcontainer/post-start-minimal.sh",
  
  "remoteUser": "vscode",
  
  // Podman-specific settings
  "runArgs": [
    "--userns=keep-id",
    "--memory=4g",
    "--cpus=2"
  ],
  
  // Mount the workspace
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  
  // Mount Claude config as volume for persistence across rebuilds
  "mounts": [
    "source=claude-neural-trader,target=/home/vscode/.claude,type=volume"
  ],
  
  "containerEnv": {
    "RUST_LOG": "info",
    "RUST_BACKTRACE": "1",
    "DATABASE_URL": "postgresql://postgres:dev_password@localhost:5432/neural_trader",
    "REDIS_URL": "redis://localhost:6379"
  }
}
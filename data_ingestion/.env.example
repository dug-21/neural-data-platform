# Data Provider API Keys
# Get free API keys from:
# - Alpha Vantage: https://www.alphavantage.co/support/#api-key
# - Finnhub: https://finnhub.io/register
# - IEX Cloud: https://iexcloud.io/console/tokens
# - Polygon: https://polygon.io/dashboard/api-keys

IEX_CLOUD_API_KEY=your_iex_cloud_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
POLYGON_API_KEY=your_polygon_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# Database Configuration
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=neural_trader
TIMESCALE_USER=trader
TIMESCALE_PASSWORD=secure_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password
REDIS_DB=0

# Service Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=10

# Data Processing
BATCH_SIZE=1000
PROCESSING_INTERVAL_SECONDS=60

# Grafana (for docker-compose)
GRAFANA_PASSWORD=secure_grafana_password
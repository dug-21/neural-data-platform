# Simple Dockerfile for data ingestion service
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY data_ingestion/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all data_ingestion contents directly into /app
COPY data_ingestion/ .

# Create non-root user
RUN useradd -m -u 1000 trader && chown -R trader:trader /app
USER trader

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

EXPOSE 8001 9090

# Already in /app directory
ENTRYPOINT ["python", "main.py", "start"]
# Default symbols - can be overridden at runtime
CMD ["--symbols", "AAPL", "--symbols", "MSFT", "--symbols", "GOOGL", "--symbols", "TSLA"]
# Neural Trader Stock Trading Simulation Configuration
# This file references environment variables - set actual values in your shell
# Example: export FINNHUB_API_KEY="your_actual_key"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Using secure generated passwords from .env.generated
POSTGRES_USER=neural_trader
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=neural_trader_db
DATABASE_URL=postgresql://neural_trader:${POSTGRES_PASSWORD}@localhost:5432/neural_trader_db

# Connection pool settings
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_TIMEOUT_SECONDS=30

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
REDIS_MAX_CONNECTIONS=100
REDIS_TIMEOUT_SECONDS=10

# =============================================================================
# STOCK TRADING MODE
# =============================================================================
TRADING_MODE=paper
TRADING_STYLE=day_trading
TRADING_ASSET_CLASS=stocks
MARKET_TIMEZONE=America/New_York

# =============================================================================
# TRADING CONFIGURATION FOR STOCKS
# =============================================================================
# Initial capital and limits
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE=2500          # 25% of capital per position
MIN_POSITION_SIZE=500           # Minimum $500 per trade
MAX_OPEN_POSITIONS=4            # Maximum concurrent positions
MAX_DAILY_TRADES=10             # Day trading limit

# Risk management
RISK_PER_TRADE=0.01             # 1% risk per trade
DAILY_LOSS_LIMIT=0.03           # 3% daily stop
PROFIT_TARGET=0.02              # 2% daily profit target
STOP_LOSS_PERCENTAGE=0.02       # 2% stop loss
TAKE_PROFIT_PERCENTAGE=0.03     # 3% take profit

# Stock-specific filters
MIN_STOCK_PRICE=10.0            # Avoid penny stocks
MAX_STOCK_PRICE=1000.0          # Avoid extremely high-priced stocks
MIN_DAILY_VOLUME=1000000        # Minimum 1M daily volume
MIN_AVG_VOLUME=500000           # Minimum 500K average volume

# =============================================================================
# PRIMARY DATA PROVIDER
# =============================================================================
# Set PRIMARY_PROVIDER to one of: finnhub, alpha_vantage, iex_cloud, polygon
PRIMARY_PROVIDER=${PRIMARY_PROVIDER:-finnhub}

# =============================================================================
# API KEYS - REFERENCE ENVIRONMENT VARIABLES
# =============================================================================
# Set these in your environment before running:
# export FINNHUB_API_KEY="your_actual_key"
# export ALPHA_VANTAGE_API_KEY="your_actual_key"
# export IEX_CLOUD_API_KEY="your_actual_key"

FINNHUB_API_KEY=${FINNHUB_API_KEY}
ALPHA_VANTAGE_API_KEY=${ALPHA_VANTAGE_API_KEY}
IEX_CLOUD_API_KEY=${IEX_CLOUD_API_KEY}
POLYGON_API_KEY=${POLYGON_API_KEY}

# Optional providers
FRED_API_KEY=${FRED_API_KEY}
NEWSAPI_KEY=${NEWSAPI_KEY}
YAHOO_API_KEY=${YAHOO_API_KEY}
NASDAQ_API_KEY=${NASDAQ_API_KEY}
REDDIT_CLIENT_ID=${REDDIT_CLIENT_ID}
REDDIT_CLIENT_SECRET=${REDDIT_CLIENT_SECRET}
QUANDL_API_KEY=${QUANDL_API_KEY}

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_FINNHUB_CALLS_PER_MINUTE=${RATE_LIMIT_FINNHUB_CALLS_PER_MINUTE:-60}
RATE_LIMIT_ALPHA_VANTAGE_CALLS_PER_MINUTE=${RATE_LIMIT_ALPHA_VANTAGE_CALLS_PER_MINUTE:-5}
RATE_LIMIT_ALPHA_VANTAGE_CALLS_PER_DAY=${RATE_LIMIT_ALPHA_VANTAGE_CALLS_PER_DAY:-500}
RATE_LIMIT_POLYGON_CALLS_PER_MINUTE=${RATE_LIMIT_POLYGON_CALLS_PER_MINUTE:-5}
RATE_LIMIT_NEWSAPI_CALLS_PER_DAY=${RATE_LIMIT_NEWSAPI_CALLS_PER_DAY:-100}
RATE_LIMIT_FRED_CALLS_PER_MINUTE=${RATE_LIMIT_FRED_CALLS_PER_MINUTE:-120}
RATE_LIMIT_REDDIT_CALLS_PER_MINUTE=${RATE_LIMIT_REDDIT_CALLS_PER_MINUTE:-60}
RATE_LIMIT_NASDAQ_CALLS_PER_DAY=${RATE_LIMIT_NASDAQ_CALLS_PER_DAY:-50000}
RATE_LIMIT_YAHOO_CALLS_PER_DAY=${RATE_LIMIT_YAHOO_CALLS_PER_DAY:-1000}

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
RUST_LOG=${RUST_LOG:-info}
RUST_BACKTRACE=1
LOG_LEVEL=${LOG_LEVEL:-INFO}
LOG_FORMAT=json

# Application ports
APP_PORT=3030
METRICS_PORT=3031

# =============================================================================
# STOCK SYMBOLS TO TRADE
# =============================================================================
TRADING_SYMBOLS_PRIMARY=AAPL,MSFT,GOOGL,AMZN,META,NVDA
TRADING_SYMBOLS_ETFS=SPY,QQQ,DIA,IWM
TRADING_SYMBOLS_SECONDARY=TSLA,AMD,CRM,NFLX,ADBE,PYPL

# =============================================================================
# TRADING HOURS (US Market - Eastern Time)
# =============================================================================
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00
TRADING_START_TIME=09:35
TRADING_END_TIME=15:45
AVOID_LUNCH_HOUR=true

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana credentials
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
SESSION_SECRET=${SESSION_SECRET}

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=neural_trader_stocks
DOCKER_CLIENT_TIMEOUT=120
COMPOSE_HTTP_TIMEOUT=120

# Container resource limits
POSTGRES_MEMORY_LIMIT=4g
REDIS_MEMORY_LIMIT=2g
APP_MEMORY_LIMIT=2g

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
WORKER_THREADS=4
MAX_CONCURRENT_TRADES=10
CACHE_TTL_SECONDS=60
BATCH_SIZE=100
PROCESSING_INTERVAL_SECONDS=1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_MACHINE_LEARNING=true
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_BACKTESTING=true
ENABLE_WEBSOCKET_STREAMING=true
ENABLE_ADVANCED_ANALYTICS=true

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================
TZ=UTC
LOCALE=en_US.UTF-8
MARKET_TIMEZONE=America/New_York

# =============================================================================
# COMMISSION AND FEES
# =============================================================================
COMMISSION_PER_SHARE=0.005
MIN_COMMISSION=1.00
COMMISSION_TYPE=per_share

# =============================================================================
# MARKET DATA CONFIGURATION
# =============================================================================
USE_REAL_TIME_DATA=true
FALLBACK_TO_DELAYED=true
HISTORICAL_DATA_DAYS=30

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
NOTIFICATIONS_ENABLED=false
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
ALERT_EMAIL=${ALERT_EMAIL}

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
{
  "version": "1.0",
  "release_version": "1.0.0",
  "description": "Release v1.0.0: Declarative deployment with hot-reload support",
  "changes": [
    {
      "type": "container",
      "target": "air-quality-app",
      "action": "build"
    },
    {
      "type": "stream",

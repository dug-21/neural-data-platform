# Minimal environment for testing Neural Trader
# This uses your existing test containers

# Database (using your test containers)
DATABASE_URL=postgresql://neural_trader:testpass123@localhost:5432/neural_trader_db
POSTGRES_PASSWORD=testpass123
POSTGRES_USER=neural_trader
POSTGRES_DB=neural_trader_db

# Redis (using your test container)
REDIS_URL=redis://:testredis123@localhost:6379
REDIS_PASSWORD=testredis123

# Minimal API Keys for Testing
ALPHA_VANTAGE_API_KEY=demo  # Free demo mode
YAHOO_API_KEY=not_required   # Yahoo doesn't need a key

# Optional - get free keys from:
# FINNHUB_API_KEY=your_key_here      # https://finnhub.io/register
# FRED_API_KEY=your_key_here         # https://fred.stlouisfed.org/docs/api/api_key.html
# NEWSAPI_KEY=your_key_here          # https://newsapi.org/register

# Security placeholders (not actively used yet)
JWT_SECRET=test_jwt_secret_32_chars_minimum_len
ENCRYPTION_KEY=test_encryption_key_32_chars_min
SESSION_SECRET=test_session_secret_32_chars_min

# Basic settings
NODE_ENV=development
RUST_LOG=info
TRADING_MODE=paper
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pg_stat_database_tup_returned{datname=\"neural_trader_db\"} / pg_stat_database_tup_fetched{datname=\"neural_trader_db\"} * 100",
          "interval": "30s",
          "legendFormat": "Cache Hit Ratio %",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pg_stat_activity_count{datname=\"neural_trader_db\",state=\"active\"}",
          "interval": "30s",
          "legendFormat": "Active Connections",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(pg_stat_database_blk_read_time{datname=\"neural_trader_db\"}[5m])",
          "interval": "30s",
          "legendFormat": "Avg Query Time",
          "refId": "C"
        }
      ],
      "title": "Database Performance",
      "type": "timeseries"
    },

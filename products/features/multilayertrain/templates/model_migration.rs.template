/// Main model migration orchestrator
pub struct ModelMigrationManager {
    config: MigrationConfig,
    persistence_service: Arc<ModelPersistenceService>,
    
    // Migration state management
    active_migrations: Arc<RwLock<HashMap<String, MigrationState>>>,
    migration_history: Arc<RwLock<VecDeque<MigrationRecord>>>,
    
    // Model registry and versioning
    model_registry: ModelRegistry,
    version_manager: VersionManager,
    
    // Migration execution components
    deployment_orchestrator: DeploymentOrchestrator,
    validation_engine: ValidationEngine,
    rollback_manager: RollbackManager,
    
    // Monitoring and alerting
    migration_monitor: MigrationMonitor,
    alert_manager: AlertManager,
}

impl ModelMigrationManager {
    /// Create new migration manager
    pub fn new(
        config: MigrationConfig,
        persistence_service: Arc<ModelPersistenceService>,
    ) -> Self {
        let active_migrations = Arc::new(RwLock::new(HashMap::new()));
        let migration_history = Arc::new(RwLock::new(VecDeque::new()));
        
        let model_registry = ModelRegistry::new();
        let version_manager = VersionManager::new();
        let deployment_orchestrator = DeploymentOrchestrator::new(&config);
        let validation_engine = ValidationEngine::new(&config);
        let rollback_manager = RollbackManager::new(&config);
        let migration_monitor = MigrationMonitor::new(&config);
        let alert_manager = AlertManager::new();

        Self {
            config,
            persistence_service,
            active_migrations,
            migration_history,
            model_registry,
            version_manager,
            deployment_orchestrator,
            validation_engine,
            rollback_manager,
            migration_monitor,
            alert_manager,
        }
    }

    /// Plan a new model migration
    #[instrument(skip(self, from_version, to_version))]
    pub async fn plan_migration(
        &self,
        from_version: &ModelVersion,
        to_version: &ModelVersion,
        strategy: Option<MigrationStrategy>,
    ) -> Result<MigrationPlan> {
        info!("Planning migration from {} to {}", from_version.version_id, to_version.version_id);

        // Validate compatibility
        let compatibility_result = self.validate_compatibility(from_version, to_version).await?;
        if !compatibility_result.is_compatible {
            return Err(crate::error::Error::IncompatibleModels(
                format!("Models are incompatible: {:?}", compatibility_result.issues)
            ));
        }

        // Assess migration risk
        let risk_assessment = self.assess_migration_risk(from_version, to_version).await?;
        
        // Select appropriate strategy
        let migration_strategy = strategy.unwrap_or_else(|| {
            self.select_optimal_strategy(&risk_assessment, from_version, to_version)
        });

        // Generate migration steps
        let steps = self.generate_migration_steps(
            from_version,
            to_version,
            &migration_strategy,
        ).await?;

        // Create validation criteria
        let validation_criteria = self.create_validation_criteria(
            from_version,
            to_version,
            &risk_assessment,
        ).await?;

        // Plan rollback strategy
        let rollback_plan = self.create_rollback_plan(
            from_version,
            to_version,
            &migration_strategy,
        ).await?;

        // Estimate duration
        let estimated_duration = self.estimate_migration_duration(&steps).await;

        let migration_plan = MigrationPlan {
            migration_id: format!("migration_{}_{}", from_version.version_id, to_version.version_id),
            from_version: from_version.clone(),
            to_version: to_version.clone(),
            strategy: migration_strategy,
            steps,
            validation_criteria,
            rollback_plan,
            estimated_duration,
            risk_assessment,
        };

        info!("Migration plan created: {}", migration_plan.migration_id);
        Ok(migration_plan)
    }

    /// Execute a planned migration
    #[instrument(skip(self, plan))]
    pub async fn execute_migration(&self, plan: MigrationPlan) -> Result<MigrationResult> {
        info!("Starting migration execution: {}", plan.migration_id);

        // Check for concurrent migration limits
        {
            let active = self.active_migrations.read().await;
            if active.len() >= self.config.max_concurrent_migrations {
                return Err(crate::error::Error::TooManyConcurrentMigrations);
            }
        }

        // Initialize migration state
        let mut migration_state = MigrationState {
            migration_id: plan.migration_id.clone(),
            status: MigrationStatus::InProgress,
            current_step: None,
            progress_percentage: 0.0,
            start_time: Utc::now(),
            estimated_completion: Some(Utc::now() + plan.estimated_duration),
            validation_results: Vec::new(),
            performance_metrics: MigrationMetrics::default(),
            error_log: Vec::new(),
        };

        // Register active migration
        {
            let mut active = self.active_migrations.write().await;
            active.insert(plan.migration_id.clone(), migration_state.clone());
        }

        // Start migration monitoring
        let monitor_handle = self.migration_monitor.start_monitoring(&plan).await;

        // Execute migration steps
        let mut step_results = Vec::new();
        for (i, step) in plan.steps.iter().enumerate() {
            migration_state.current_step = Some(step.step_id.clone());
            migration_state.progress_percentage = (i as f64 / plan.steps.len() as f64) * 100.0;
            
            // Update state
            self.update_migration_state(&migration_state).await;

            info!("Executing migration step: {}", step.description);
            
            // Execute step with timeout
            let step_result = tokio::time::timeout(
                step.duration_estimate * 2, // Allow 2x estimated time
                self.execute_migration_step(&plan, step, &migration_state),
            ).await;

            match step_result {
                Ok(Ok(result)) => {
                    step_results.push(result);
                    info!("Migration step completed: {}", step.step_id);
                }
                Ok(Err(e)) => {
                    error!("Migration step failed: {} - {}", step.step_id, e);
                    migration_state.status = MigrationStatus::Failed;
                    migration_state.error_log.push(MigrationError {
                        step_id: step.step_id.clone(),
                        error_message: e.to_string(),
                        timestamp: Utc::now(),
                    });
                    
                    // Trigger rollback if enabled
                    if self.config.auto_rollback {
                        warn!("Auto-triggering rollback due to step failure");
                        return self.rollback_migration(&plan, &migration_state).await;
                    } else {
                        migration_state.status = MigrationStatus::Failed;
                        self.update_migration_state(&migration_state).await;
                        return Err(e);
                    }
                }
                Err(_) => {
                    error!("Migration step timed out: {}", step.step_id);
                    migration_state.status = MigrationStatus::Failed;
                    
                    if self.config.auto_rollback {
                        return self.rollback_migration(&plan, &migration_state).await;
                    } else {
                        return Err(crate::error::Error::MigrationTimeout);
                    }
                }
            }

            // Check rollback conditions after each step
            if self.should_trigger_rollback(&migration_state, &plan).await {
                warn!("Rollback conditions met, triggering rollback");
                return self.rollback_migration(&plan, &migration_state).await;
            }
        }

        // Final validation
        migration_state.status = MigrationStatus::Validating;
        self.update_migration_state(&migration_state).await;

        let final_validation = self.perform_final_validation(&plan).await?;
        migration_state.validation_results.push(final_validation.clone());

        if final_validation.passed {
            migration_state.status = MigrationStatus::Completed;
            migration_state.progress_percentage = 100.0;
            info!("Migration completed successfully: {}", plan.migration_id);
        } else {
            migration_state.status = MigrationStatus::Failed;
            if self.config.auto_rollback {
                return self.rollback_migration(&plan, &migration_state).await;
            }
        }

        // Stop monitoring
        self.migration_monitor.stop_monitoring(&monitor_handle).await;

        // Update final state and record history
        self.update_migration_state(&migration_state).await;
        self.record_migration_history(&plan, &migration_state).await;

        // Clean up old models if successful
        if migration_state.status == MigrationStatus::Completed {
            self.cleanup_old_models(&plan).await?;
        }

        Ok(MigrationResult {
            migration_id: plan.migration_id,
            status: migration_state.status,
            step_results,
            validation_results: migration_state.validation_results,
            performance_metrics: migration_state.performance_metrics,
            duration: Utc::now() - migration_state.start_time,
        })
    }

    /// Execute a single migration step
    async fn execute_migration_step(
        &self,
        plan: &MigrationPlan,
        step: &MigrationStep,
        state: &MigrationState,
    ) -> Result<StepResult> {
        match step.step_type {
            MigrationStepType::BackupModel => {
                self.backup_current_model(&plan.from_version).await
            }
            MigrationStepType::ValidateNewModel => {
                self.validate_new_model(&plan.to_version).await
            }
            MigrationStepType::PrepareDeployment => {
                self.prepare_deployment(plan, step).await
            }
            MigrationStepType::PartialDeployment => {
                self.deploy_partial(&plan.to_version, step.traffic_percentage).await
            }
            MigrationStepType::ValidationPhase => {
                self.run_validation_phase(plan, step).await
            }
            MigrationStepType::FullDeployment => {
                self.deploy_full(&plan.to_version).await
            }
            MigrationStepType::CleanupOldModel => {
                self.cleanup_old_model(&plan.from_version).await
            }
            MigrationStepType::FinalValidation => {
                self.run_final_validation(plan).await
            }
        }
    }

    /// Rollback a failed migration
    async fn rollback_migration(
        &self,
        plan: &MigrationPlan,
        state: &MigrationState,
    ) -> Result<MigrationResult> {
        warn!("Rolling back migration: {}", plan.migration_id);
        
        let rollback_result = self.rollback_manager.execute_rollback(
            &plan.rollback_plan,
            &plan.from_version,
        ).await?;

        let mut final_state = state.clone();
        final_state.status = MigrationStatus::RolledBack;
        self.update_migration_state(&final_state).await;

        Ok(MigrationResult {
            migration_id: plan.migration_id.clone(),
            status: MigrationStatus::RolledBack,
            step_results: vec![rollback_result],
            validation_results: state.validation_results.clone(),
            performance_metrics: state.performance_metrics.clone(),
            duration: Utc::now() - state.start_time,
        })
    }


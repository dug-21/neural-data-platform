/// Migration configuration and strategy
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct MigrationConfig {
    /// Migration strategy type
    pub strategy: MigrationStrategy,
    /// Backup retention policy (days)
    pub backup_retention_days: u32,
    /// Progressive deployment percentage steps
    pub deployment_steps: Vec<f64>,
    /// Validation threshold for successful migration
    pub validation_threshold: f64,
    /// Rollback trigger conditions
    pub rollback_conditions: RollbackConditions,
    /// Migration timeout (minutes)
    pub migration_timeout_minutes: u32,
    /// Health check interval during migration (seconds)
    pub health_check_interval_secs: u32,
    /// Enable automatic rollback on failure
    pub auto_rollback: bool,
    /// Maximum concurrent migrations
    pub max_concurrent_migrations: usize,
}

impl Default for MigrationConfig {
    fn default() -> Self {
        Self {
            strategy: MigrationStrategy::BlueGreen,
            backup_retention_days: 30,
            deployment_steps: vec![0.1, 0.25, 0.5, 0.75, 1.0],
            validation_threshold: 0.95,
            rollback_conditions: RollbackConditions::default(),
            migration_timeout_minutes: 60,
            health_check_interval_secs: 30,
            auto_rollback: true,
            max_concurrent_migrations: 2,
        }
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub enum MigrationStrategy {
    /// Blue-green deployment (instant switch)
    BlueGreen,
    /// Rolling deployment (gradual replacement)
    Rolling,
    /// Canary deployment (progressive testing)
    Canary,
    /// A/B testing (parallel evaluation)
    ABTesting,
    /// Shadow deployment (parallel validation)
    Shadow,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct RollbackConditions {
    /// Maximum acceptable error rate increase
    pub max_error_rate_increase: f64,
    /// Maximum acceptable latency increase (ms)
    pub max_latency_increase_ms: f64,
    /// Minimum accuracy threshold
    pub min_accuracy_threshold: f64,
    /// Maximum memory usage increase (MB)
    pub max_memory_increase_mb: f64,
}

impl Default for RollbackConditions {
    fn default() -> Self {
        Self {
            max_error_rate_increase: 0.05, // 5%
            max_latency_increase_ms: 100.0,
            min_accuracy_threshold: 0.90,
            max_memory_increase_mb: 512.0,
        }
    }
}


    /// Select optimal migration strategy based on risk and models
    fn select_optimal_strategy(
        &self,
        risk: &RiskAssessment,
        from: &ModelVersion,
        to: &ModelVersion,
    ) -> MigrationStrategy {
        match risk {
            RiskAssessment::Low => MigrationStrategy::BlueGreen,
            RiskAssessment::Medium => MigrationStrategy::Canary,
            RiskAssessment::High => MigrationStrategy::Shadow,
            RiskAssessment::Critical => MigrationStrategy::ABTesting,
        }
    }


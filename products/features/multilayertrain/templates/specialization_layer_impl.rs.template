/// Configuration for specialization layer
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct SpecializationConfig {
    /// Number of expert networks per layer
    pub num_experts: usize,
    /// Expert network hidden dimensions
    pub expert_hidden_dims: Vec<usize>,
    /// Gating network dimensions
    pub gate_hidden_dims: Vec<usize>,
    /// Minimum expert utilization threshold (for load balancing)
    pub min_expert_utilization: f64,
    /// Temperature for softmax gating (higher = more exploration)
    pub gating_temperature: f64,
    /// Enable gradient-based routing updates
    pub adaptive_routing: bool,
    /// Meta-learning rate for cross-task transfer
    pub meta_learning_rate: f64,
    /// Expert capacity factor (for capacity-based routing)
    pub expert_capacity_factor: f64,
    /// Enable uncertainty estimation in routing
    pub uncertainty_routing: bool,
}

impl Default for SpecializationConfig {
    fn default() -> Self {
        Self {
            num_experts: 8,
            expert_hidden_dims: vec![256, 128, 64],
            gate_hidden_dims: vec![128, 64],
            min_expert_utilization: 0.1,
            gating_temperature: 1.0,
            adaptive_routing: true,
            meta_learning_rate: 0.001,
            expert_capacity_factor: 1.25,
            uncertainty_routing: true,
        }
    }
}


pub struct ComponentMonitor {
    component_id: String,
    component_type: ComponentType,
    metrics_history: VecDeque<PerformanceMetrics>,
    last_update: DateTime<Utc>,
}

impl ComponentMonitor {
    pub fn new(component_id: String, component_type: ComponentType) -> Self {
        Self {
            component_id,
            component_type,
            metrics_history: VecDeque::new(),
            last_update: Utc::now(),
        }
    }

    pub async fn update_metrics(&mut self, metrics: PerformanceMetrics) {
        self.metrics_history.push_back(metrics);
        self.last_update = Utc::now();
        
        // Maintain history size
        if self.metrics_history.len() > 100 {
            self.metrics_history.pop_front();
        }
    }
}


/// Performance monitoring configuration
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct PerformanceMonitorConfig {
    /// Metrics collection interval (seconds)
    pub collection_interval_secs: u64,
    /// Historical data retention period (days)
    pub retention_days: u32,
    /// Performance alert thresholds
    pub alert_thresholds: AlertThresholds,
    /// Enable detailed profiling (higher overhead)
    pub enable_detailed_profiling: bool,
    /// Metrics aggregation window sizes
    pub aggregation_windows: Vec<Duration>,
    /// Maximum number of metrics to store per component
    pub max_metrics_per_component: usize,
    /// Enable predictive alerting
    pub enable_predictive_alerts: bool,
    /// Anomaly detection sensitivity (0.0-1.0)
    pub anomaly_detection_sensitivity: f64,
}

impl Default for PerformanceMonitorConfig {
    fn default() -> Self {
        Self {
            collection_interval_secs: 30,
            retention_days: 7,
            alert_thresholds: AlertThresholds::default(),
            enable_detailed_profiling: false,
            aggregation_windows: vec![
                Duration::from_secs(60),    // 1 minute
                Duration::from_secs(300),   // 5 minutes
                Duration::from_secs(3600),  // 1 hour
                Duration::from_secs(86400), // 1 day
            ],
            max_metrics_per_component: 10000,
            enable_predictive_alerts: true,
            anomaly_detection_sensitivity: 0.8,
        }
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct AlertThresholds {
    /// Maximum acceptable prediction latency (ms)
    pub max_prediction_latency_ms: f64,
    /// Maximum acceptable error rate (0.0-1.0)
    pub max_error_rate: f64,
    /// Minimum acceptable accuracy
    pub min_accuracy: f64,
    /// Maximum acceptable memory usage (MB)
    pub max_memory_usage_mb: f64,
    /// Maximum acceptable CPU usage (0.0-1.0)
    pub max_cpu_usage: f64,
    /// Maximum acceptable model disagreement
    pub max_model_disagreement: f64,
    /// Minimum acceptable ensemble diversity
    pub min_ensemble_diversity: f64,
}

impl Default for AlertThresholds {
    fn default() -> Self {
        Self {
            max_prediction_latency_ms: 1000.0,
            max_error_rate: 0.05,
            min_accuracy: 0.85,
            max_memory_usage_mb: 4096.0,
            max_cpu_usage: 0.8,
            max_model_disagreement: 0.3,
            min_ensemble_diversity: 0.1,
        }
    }
}


impl EnsemblePredictor {
    /// Create new ensemble predictor with configuration
    pub async fn new(
        config: EnsembleConfig,
        model_registry: &ModelRegistry,
    ) -> Result<Self> {
        info!("Initializing ensemble predictor with {} max models", config.max_base_models);

        // Load base models from registry
        let base_models = Self::load_base_models(&config, model_registry).await?;
        
        // Initialize specialization layers
        let specialization_layers = Self::initialize_specialization_layers(&config).await?;
        
        // Load or create meta-ensemble
        let meta_ensemble = Self::load_meta_ensemble(&config, model_registry).await?;
        
        // Initialize fallback model
        let fallback_model = Self::create_fallback_model().await?;
        
        // Initialize optimization and monitoring components
        let weight_optimizer = WeightOptimizer::new(config.weight_learning_rate);
        let performance_tracker = PerformanceTracker::new(config.performance_window);
        let health_monitor = HealthMonitor::new(config.health_check_interval);
        let uncertainty_aggregator = UncertaintyAggregator::new();
        let diversity_enforcer = DiversityEnforcer::new(config.enforce_diversity);
        
        // Initialize caching and metrics
        let prediction_cache = Arc::new(RwLock::new(PredictionCache::new()));
        let ensemble_metrics = Arc::new(RwLock::new(EnsembleMetrics::default()));

        Ok(Self {
            config,
            base_models,
            specialization_layers,
            meta_ensemble,
            fallback_model,
            weight_optimizer,
            performance_tracker,
            health_monitor,
            uncertainty_aggregator,
            diversity_enforcer,
            prediction_cache,
            ensemble_metrics,
        })
    }

    /// Make ensemble prediction with full orchestration
    #[instrument(skip(self, features, context))]
    pub async fn predict(
        &self,
        features: &DVector<f64>,
        context: &PredictionContext,
    ) -> Result<EnsemblePrediction> {
        let start_time = std::time::Instant::now();
        let prediction_time = Utc::now();
        
        // Check cache first
        if let Some(cached) = self.check_prediction_cache(features, context).await {
            debug!("Returning cached prediction");
            return Ok(cached);
        }

        // Detect market regime for adaptive behavior
        let market_regime = self.detect_market_regime(features, context).await?;
        
        // Get healthy models for prediction
        let healthy_models = self.select_healthy_models(&market_regime).await;
        
        if healthy_models.is_empty() {
            warn!("No healthy models available, using fallback");
            return self.fallback_prediction(features, context, start_time, prediction_time).await;
        }

        // Collect predictions from all model layers
        let predictions = self.collect_layered_predictions(
            features,
            context,
            &healthy_models,
            &market_regime,
        ).await?;

        // Apply voting strategy
        let ensemble_result = self.apply_voting_strategy(&predictions, &market_regime).await?;
        
        // Aggregate uncertainty across models
        let aggregated_uncertainty = if self.config.uncertainty_aggregation {
            self.uncertainty_aggregator.aggregate(&predictions).await
        } else {
            ensemble_result.uncertainty
        };

        // Compute diversity metrics
        let diversity_metrics = self.compute_diversity_metrics(&predictions).await;
        
        // Enforce diversity if configured
        let final_prediction = if self.config.enforce_diversity {
            self.diversity_enforcer.adjust_prediction(
                ensemble_result,
                &diversity_metrics,
            ).await
        } else {
            ensemble_result
        };

        // Compute prediction interval
        let prediction_interval = self.compute_prediction_interval(
            final_prediction.value,
            aggregated_uncertainty,
        ).await;

        // Update performance tracking and weights
        self.update_model_weights(&predictions, &final_prediction).await;
        
        let processing_time = start_time.elapsed().as_millis() as u64;
        
        // Prepare model contributions
        let model_contributions = predictions.into_iter()
            .map(|p| ModelContribution {
                model_id: p.model_id,
                prediction: p.prediction.value,
                confidence: p.prediction.confidence,
                weight: p.weight,
                model_type: p.model_type,
                sector_specialization: p.sector_specialization,
            })
            .collect();

        let ensemble_prediction = EnsemblePrediction {
            prediction: final_prediction.value,
            confidence: final_prediction.confidence,
            uncertainty: aggregated_uncertainty,
            prediction_interval,
            model_contributions,
            diversity_metrics,
            metadata: PredictionMetadata {
                prediction_time,
                processing_time_ms: processing_time,
                models_used: healthy_models.len(),
                models_failed: self.base_models.len() - healthy_models.len(),
                fallback_used: false,
                market_regime,
            },
        };

        // Cache the result
        self.cache_prediction(features, context, &ensemble_prediction).await;
        
        // Update ensemble metrics
        self.update_ensemble_metrics(&ensemble_prediction).await;

        Ok(ensemble_prediction)
    }

    /// Collect predictions from all ensemble layers
    #[instrument(skip(self, features, context, healthy_models))]
    async fn collect_layered_predictions(
        &self,
        features: &DVector<f64>,
        context: &PredictionContext,
        healthy_models: &[&EnsembleModel],
        market_regime: &MarketRegime,
    ) -> Result<Vec<WeightedPrediction>> {
        let mut all_predictions = Vec::new();
        
        // Base model predictions
        let base_predictions = self.collect_base_predictions(
            features,
            context,
            healthy_models,
        ).await?;
        all_predictions.extend(base_predictions);
        
        // Specialization layer predictions
        for (layer_idx, layer) in self.specialization_layers.iter().enumerate() {
            match layer.predict(features, context).await {
                Ok(specialized_pred) => {
                    let weight = self.get_layer_weight(layer_idx, market_regime).await;
                    all_predictions.push(WeightedPrediction {
                        model_id: format!("specialization_layer_{}", layer_idx),
                        prediction: ModelPrediction {
                            value: specialized_pred.value,
                            confidence: specialized_pred.confidence,
                            uncertainty: specialized_pred.uncertainty,
                            processing_time: std::time::Duration::from_millis(10), // Estimate
                        },
                        weight,
                        model_type: ModelType::SpecializationLayer(layer_idx),
                        sector_specialization: Some(context.sector),
                    });
                }
                Err(e) => {
                    warn!("Specialization layer {} failed: {}", layer_idx, e);
                }
            }
        }
        
        // Meta-ensemble prediction if available
        if let Some(meta_model) = &self.meta_ensemble {
            // TODO: Implement meta-ensemble prediction
            // This would typically take base predictions as input
        }

        Ok(all_predictions)
    }

    /// Collect predictions from base models with parallel execution
    async fn collect_base_predictions(
        &self,
        features: &DVector<f64>,
        context: &PredictionContext,
        healthy_models: &[&EnsembleModel],
    ) -> Result<Vec<WeightedPrediction>> {
        // Execute predictions in parallel with timeout
        let prediction_futures = healthy_models.iter().map(|model| {
            let features = features.clone();
            let context = context.clone();
            async move {
                let start_time = std::time::Instant::now();
                
                // Apply timeout for individual predictions
                let result = tokio::time::timeout(
                    std::time::Duration::from_millis(self.config.fallback_timeout_ms),
                    model.model_adapter.predict(&features, &context),
                ).await;
                
                match result {
                    Ok(Ok(prediction)) => {
                        let weight = *model.dynamic_weight.read().await;
                        Some(WeightedPrediction {
                            model_id: model.id.clone(),
                            prediction,
                            weight,
                            model_type: model.model_type.clone(),
                            sector_specialization: model.sector_specialization,
                        })
                    }
                    Ok(Err(e)) => {
                        warn!("Model {} prediction failed: {}", model.id, e);
                        None
                    }
                    Err(_) => {
                        warn!("Model {} prediction timed out", model.id);
                        None
                    }
                }
            }
        });

        let results = futures::future::join_all(prediction_futures).await;
        Ok(results.into_iter().filter_map(|r| r).collect())
    }

    /// Apply configured voting strategy to combine predictions
    async fn apply_voting_strategy(
        &self,
        predictions: &[WeightedPrediction],
        market_regime: &MarketRegime,
    ) -> Result<ModelPrediction> {
        match self.config.voting_strategy {
            VotingStrategy::SimpleAverage => {
                self.simple_average_voting(predictions).await
            }
            VotingStrategy::WeightedAverage => {
                self.weighted_average_voting(predictions).await
            }
            VotingStrategy::Median => {
                self.median_voting(predictions).await
            }
            VotingStrategy::ConfidenceWeighted => {
                self.confidence_weighted_voting(predictions).await
            }
            VotingStrategy::BayesianAveraging => {
                self.bayesian_averaging(predictions).await
            }
            VotingStrategy::StackedEnsemble => {
                self.stacked_ensemble_voting(predictions).await
            }
        }
    }

    /// Simple average voting strategy
    async fn simple_average_voting(&self, predictions: &[WeightedPrediction]) -> Result<ModelPrediction> {
        let values: Vec<f64> = predictions.iter().map(|p| p.prediction.value).collect();
        let confidences: Vec<f64> = predictions.iter().map(|p| p.prediction.confidence).collect();
        let uncertainties: Vec<f64> = predictions.iter().map(|p| p.prediction.uncertainty).collect();
        
        let avg_value = values.iter().sum::<f64>() / values.len() as f64;
        let avg_confidence = confidences.iter().sum::<f64>() / confidences.len() as f64;
        let avg_uncertainty = uncertainties.iter().sum::<f64>() / uncertainties.len() as f64;
        
        Ok(ModelPrediction {
            value: avg_value,
            confidence: avg_confidence,
            uncertainty: avg_uncertainty,
            processing_time: std::time::Duration::from_millis(1),
        })
    }

    /// Weighted average voting strategy
    async fn weighted_average_voting(&self, predictions: &[WeightedPrediction]) -> Result<ModelPrediction> {
        let total_weight: f64 = predictions.iter().map(|p| p.weight).sum();
        
        if total_weight == 0.0 {
            return self.simple_average_voting(predictions).await;
        }
        
        let weighted_value = predictions.iter()
            .map(|p| p.prediction.value * p.weight)
            .sum::<f64>() / total_weight;
            
        let weighted_confidence = predictions.iter()
            .map(|p| p.prediction.confidence * p.weight)
            .sum::<f64>() / total_weight;
            
        // Uncertainty should increase with disagreement
        let disagreement = self.compute_prediction_disagreement(predictions).await;
        let weighted_uncertainty = predictions.iter()
            .map(|p| p.prediction.uncertainty * p.weight)
            .sum::<f64>() / total_weight + disagreement;
        
        Ok(ModelPrediction {
            value: weighted_value,
            confidence: weighted_confidence,
            uncertainty: weighted_uncertainty,
            processing_time: std::time::Duration::from_millis(1),
        })
    }


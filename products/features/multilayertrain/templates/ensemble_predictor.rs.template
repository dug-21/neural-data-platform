/// Configuration for ensemble prediction
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct EnsembleConfig {
    /// Maximum number of base models in ensemble
    pub max_base_models: usize,
    /// Number of specialization layers
    pub num_specialization_layers: usize,
    /// Meta-ensemble voting strategy
    pub voting_strategy: VotingStrategy,
    /// Model health check interval (seconds)
    pub health_check_interval: u64,
    /// Performance window for model weighting (predictions)
    pub performance_window: usize,
    /// Minimum model confidence threshold
    pub min_confidence_threshold: f64,
    /// Enable uncertainty aggregation
    pub uncertainty_aggregation: bool,
    /// Fallback model timeout (milliseconds)
    pub fallback_timeout_ms: u64,
    /// Dynamic weight adjustment learning rate
    pub weight_learning_rate: f64,
    /// Enable ensemble diversity enforcement
    pub enforce_diversity: bool,
}

impl Default for EnsembleConfig {
    fn default() -> Self {
        Self {
            max_base_models: 12,
            num_specialization_layers: 3,
            voting_strategy: VotingStrategy::WeightedAverage,
            health_check_interval: 60,
            performance_window: 1000,
            min_confidence_threshold: 0.3,
            uncertainty_aggregation: true,
            fallback_timeout_ms: 5000,
            weight_learning_rate: 0.01,
            enforce_diversity: true,
        }
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub enum VotingStrategy {
    /// Simple average of all predictions
    SimpleAverage,
    /// Weighted average based on historical performance
    WeightedAverage,
    /// Median of predictions (robust to outliers)
    Median,
    /// Confidence-weighted voting
    ConfidenceWeighted,
    /// Bayesian model averaging
    BayesianAveraging,
    /// Stacked ensemble with meta-learner
    StackedEnsemble,
}


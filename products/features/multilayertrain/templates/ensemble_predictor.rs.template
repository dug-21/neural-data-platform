    /// Fallback prediction when all models fail
    async fn fallback_prediction(
        &self,
        features: &DVector<f64>,
        context: &PredictionContext,
        start_time: std::time::Instant,
        prediction_time: DateTime<Utc>,
    ) -> Result<EnsemblePrediction> {
        warn!("Using fallback model for prediction");
        
        let fallback_pred = self.fallback_model.predict(features, context).await?;
        let processing_time = start_time.elapsed().as_millis() as u64;
        
        Ok(EnsemblePrediction {
            prediction: fallback_pred.value,
            confidence: fallback_pred.confidence * 0.5, // Reduce confidence for fallback
            uncertainty: fallback_pred.uncertainty * 2.0, // Increase uncertainty
            prediction_interval: PredictionInterval {
                lower: fallback_pred.value - 2.0 * fallback_pred.uncertainty,
                upper: fallback_pred.value + 2.0 * fallback_pred.uncertainty,
                confidence_level: 0.95,
            },
            model_contributions: vec![ModelContribution {
                model_id: "fallback".to_string(),
                prediction: fallback_pred.value,
                confidence: fallback_pred.confidence,
                weight: 1.0,
                model_type: ModelType::FallbackModel,
                sector_specialization: None,
            }],
            diversity_metrics: DiversityMetrics {
                disagreement: 0.0,
                average_correlation: 1.0,
                prediction_entropy: 0.0,
            },
            metadata: PredictionMetadata {
                prediction_time,
                processing_time_ms: processing_time,
                models_used: 1,
                models_failed: self.base_models.len(),
                fallback_used: true,
                market_regime: MarketRegime::Unknown,
            },
        })
    }


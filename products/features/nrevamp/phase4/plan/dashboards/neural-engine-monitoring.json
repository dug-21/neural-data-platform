        "filterValues": {
          "le": 1e-9
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false
        }
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "neural_model_data_type_utilization{model_type=~\"$model_type\"} * 100",
          "format": "time_series",
          "interval": "1m",
          "legendFormat": "{{model_type}} - {{data_type}}",
          "refId": "A"
        }
      ],
      "title": "Data Type Utilization Matrix",

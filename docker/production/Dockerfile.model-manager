# Model Manager Service Dockerfile
# Week 3 Implementation: Dedicated service for model persistence and management

# Build stage
FROM rust:1.70-bullseye as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    cmake \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy dependency files
COPY Cargo.toml Cargo.lock ./

# Create dummy binary for model manager
RUN mkdir -p src/bin && \
    echo "fn main() { println!(\"Model Manager\"); }" > src/bin/model-manager.rs && \
    mkdir -p src && echo "fn main() {}" > src/main.rs

# Build dependencies
RUN cargo build --release --bin model-manager
RUN rm -rf src target/release/deps/model_manager*

# Copy actual source code
COPY src/ ./src/

# Create the model manager binary
COPY << 'EOF' src/bin/model-manager.rs
//! Model Manager Service Binary
//! 
//! Dedicated service for handling model persistence, versioning, and rollback operations.

use anyhow::Result;
use tokio::net::TcpListener;
use tracing::{info, error};
use std::sync::Arc;
use neural_trader::integration::{
    ModelPersistenceService, ModelPersistenceConfig,
    TrainingDataService, TrainingDataConfig
};

#[tokio::main]
async fn main() -> Result<()> {
    // Initialize logging
    tracing_subscriber::fmt::init();
    
    info!("Starting Neural Trader Model Manager Service");

    // Load configuration
    let persistence_config = ModelPersistenceConfig {
        model_storage_path: std::env::var("MODEL_STORAGE_PATH")
            .unwrap_or_else(|_| "/opt/neural-trader/models".to_string())
            .into(),
        enable_auto_checkpointing: std::env::var("ENABLE_AUTO_CHECKPOINTING")
            .unwrap_or_else(|_| "true".to_string())
            .parse()
            .unwrap_or(true),
        checkpoint_frequency: std::env::var("CHECKPOINT_FREQUENCY")
            .unwrap_or_else(|_| "100".to_string())
            .parse()
            .unwrap_or(100),
        max_concurrent_operations: std::env::var("MAX_CONCURRENT_OPERATIONS")
            .unwrap_or_else(|_| "4".to_string())
            .parse()
            .unwrap_or(4),
        ..Default::default()
    };

    // Initialize training data service
    let training_config = TrainingDataConfig {
        db_url: std::env::var("DATABASE_URL")
            .unwrap_or_else(|_| "postgresql://localhost/neural_trader".to_string()),
        cache_url: Some(std::env::var("REDIS_URL")
            .unwrap_or_else(|_| "redis://localhost:6379".to_string())),
        batch_size: 1000,
        validation_split: 0.2,
        enable_caching: true,
        cache_ttl_seconds: 300,
        max_concurrent_requests: 10,
        enable_preprocessing: true,
        feature_engineering_enabled: true,
        enable_feature_caching: true,
    };

    let training_service = Arc::new(
        TrainingDataService::new(training_config).await
            .map_err(|e| {
                error!("Failed to initialize training service: {}", e);
                e
            })?
    );

    // Initialize model persistence service
    let persistence_service = ModelPersistenceService::new(
        persistence_config,
        training_service,
    ).await?;

    info!("Model persistence service initialized");

    // Start HTTP server for model management API
    let listener = TcpListener::bind("0.0.0.0:8081").await?;
    info!("Model Manager API listening on http://0.0.0.0:8081");

    loop {
        match listener.accept().await {
            Ok((stream, addr)) => {
                info!("New connection from: {}", addr);
                // Handle connection (simplified for this example)
                tokio::spawn(async move {
                    // In a real implementation, this would handle HTTP requests
                    // for model management operations like save, load, rollback, etc.
                    tokio::time::sleep(std::time::Duration::from_secs(1)).await;
                });
            }
            Err(e) => {
                error!("Failed to accept connection: {}", e);
            }
        }
    }
}
EOF

# Build the model manager
RUN cargo build --release --bin model-manager

# Runtime stage
FROM debian:bullseye-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl1.1 \
    libpq5 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create neural-trader user
RUN groupadd -r neural && useradd -r -g neural neural

# Create necessary directories
RUN mkdir -p /opt/neural-trader/{models,backup,exports,logs} \
    && chown -R neural:neural /opt/neural-trader

# Copy the binary
COPY --from=builder /app/target/release/model-manager /usr/local/bin/model-manager

# Set ownership and permissions
RUN chown neural:neural /usr/local/bin/model-manager \
    && chmod +x /usr/local/bin/model-manager

# Switch to non-root user
USER neural

# Set working directory
WORKDIR /opt/neural-trader

# Environment variables
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

# Expose port
EXPOSE 8081

# Command to run the model manager
CMD ["model-manager"]
# PostgreSQL/TimescaleDB Configuration
POSTGRES_USER=neural_trader
POSTGRES_DB=neural_trader_db
POSTGRES_PASSWORD=your_secure_password_here

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here

# Application Configuration
LOG_LEVEL=info

# Data Provider API Keys (obtain from respective providers)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
ALPACA_WS_ENABLED=false

FINNHUB_API_KEY=your_finnhub_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
ALPHA_ADVANTAGE_API_KEY=your_alpha_advantage_api_key
IEX_CLOUD_API_KEY=your_iex_cloud_api_key
POLYGON_API_KEY=your_polygon_api_key
QUANDL_API_KEY=your_quandl_api_key
FRED_API_KEY=your_fred_api_key
NASDAQ_API_KEY=your_nasdaq_api_key
NEWSAPI_KEY=your_newsapi_key

# Reddit API (for sentiment analysis)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Trading Configuration
PRIMARY_PROVIDER=alpaca
USE_SIMPLE_MODE=false
TRADING_SYMBOLS_PRIMARY=AAPL,MSFT,GOOGL,AMZN,NVDA,DDOG
UPDATE_INTERVAL=60s

# Optional: Override default values
# MCP_PORT=8080
# TIMESCALE_HOST=timescaledb
# TIMESCALE_PORT=5432
# REDIS_HOST=redis
# REDIS_PORT=6379
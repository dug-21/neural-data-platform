          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_prices AS (\n  SELECT DISTINCT ON (symbol)\n    symbol,\n    close,\n    open,\n    volume,\n    time\n  FROM market_data\n  ORDER BY symbol, time DESC\n)\nSELECT \n  symbol,\n  close as current_price,\n  volume,\n  ROUND(((close - open) / open * 100)::numeric, 2) as change_pct,\n  time as last_update\nFROM latest_prices\nORDER BY symbol",
          "refId": "A"
        }
      ],
      "title": "Current Market Snapshot",
      "type": "table"

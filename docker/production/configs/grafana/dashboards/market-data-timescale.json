        {
          "datasource": "TimescaleDB",
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH latest_prices AS (\n  SELECT DISTINCT ON (symbol)\n    symbol,\n    close,\n    metadata->>'52_week_high' as high_52w,\n    metadata->>'52_week_low' as low_52w\n  FROM market_data\n  ORDER BY symbol, time DESC\n)\nSELECT \n  symbol,\n  close as current_price,\n  ROUND(((close - low_52w::numeric) / (high_52w::numeric - low_52w::numeric) * 100)::numeric, 2) as position_in_range\nFROM latest_prices\nWHERE high_52w IS NOT NULL AND low_52w IS NOT NULL",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
      "title": "52-Week Range Position",
      "type": "table"

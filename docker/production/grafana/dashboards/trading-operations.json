        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "neural_trader_positions_long",
          "interval": "5s",
          "legendFormat": "Long Positions",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "neural_trader_positions_short",
          "interval": "5s",
          "legendFormat": "Short Positions",
          "refId": "B"

          "expr": "rate(neural_trader_trades_executed_total[5m]) * 60",
          "interval": "10s",
          "legendFormat": "Trades/min",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(neural_trader_orders_filled_total[5m]) * 60",
          "interval": "10s",
          "legendFormat": "Orders Filled/min",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "neural_trader_trade_success_rate * 100",
          "interval": "10s",
          "legendFormat": "Success Rate",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "neural_trader_avg_fill_time_seconds",
          "interval": "10s",
          "legendFormat": "Avg Fill Time (s)",
          "refId": "D"
        }
      ],

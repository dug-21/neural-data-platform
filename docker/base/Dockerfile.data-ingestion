# Multi-stage Dockerfile for Data Ingestion Service
# Optimized for Python microservice with async capabilities

# ============================================================================
# Stage 1: Python Build Environment
# ============================================================================
FROM python:3.11-slim AS python-builder

# Install system build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libssl-dev \
    libffi-dev \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Upgrade pip and install wheel
RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy requirements first for better layer caching
COPY data_ingestion/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --user -r requirements.txt

# ============================================================================
# Stage 2: Runtime Environment
# ============================================================================
FROM python:3.11-slim AS runtime-base

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libpq5 \
    libssl3 \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r data-ingestion && useradd -r -g data-ingestion data-ingestion

# Create application directories
RUN mkdir -p /opt/data-ingestion/{config,logs,data,cache} \
    && mkdir -p /var/log/data-ingestion \
    && chown -R data-ingestion:data-ingestion /opt/data-ingestion /var/log/data-ingestion

# ============================================================================
# Stage 3: Production Image
# ============================================================================
FROM runtime-base AS production

# Copy installed packages from builder
COPY --from=python-builder /root/.local /home/data-ingestion/.local

# Add local bin to PATH
ENV PATH="/home/data-ingestion/.local/bin:$PATH"

# Copy application code
COPY data_ingestion/ /opt/data-ingestion/src/
COPY docker/base/scripts/data-ingestion-entrypoint.sh /usr/local/bin/entrypoint.sh

# Set permissions
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && chown -R data-ingestion:data-ingestion /opt/data-ingestion

# Switch to non-root user
USER data-ingestion

# Set working directory
WORKDIR /opt/data-ingestion

# Python environment variables
ENV PYTHONPATH=/opt/data-ingestion/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Application environment variables
ENV LOG_LEVEL=info \
    CONFIG_PATH=/opt/data-ingestion/config \
    DATA_PATH=/opt/data-ingestion/data \
    CACHE_PATH=/opt/data-ingestion/cache

# Expose ports
EXPOSE 8001 9091

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8001/health')" || exit 1

# Volume mounts
VOLUME ["/opt/data-ingestion/data", "/opt/data-ingestion/cache", "/var/log/data-ingestion"]

# Entry point
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "-m", "data_ingestion.main"]

# ============================================================================
# Stage 4: Development Image
# ============================================================================
FROM python-builder AS development

# Install development dependencies
RUN pip install --no-cache-dir --user \
    pytest \
    pytest-asyncio \
    pytest-cov \
    black \
    flake8 \
    mypy \
    isort \
    jupyter \
    ipython

# Install debugging tools
RUN apt-get update && apt-get install -y \
    postgresql-client \
    redis-tools \
    vim \
    less \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create development user
RUN groupadd -r developer && useradd -r -g developer developer

# Set up development environment
ENV FLASK_DEBUG=1 \
    PYTHONPATH=/app \
    PATH="/home/developer/.local/bin:$PATH"

# Development volumes
VOLUME ["/app", "/home/developer/.cache"]

# Switch to development user
USER developer

WORKDIR /app

# Development entry point with auto-reload
ENTRYPOINT ["python", "-m", "flask", "run", "--reload", "--host=0.0.0.0"]

# ============================================================================
# Stage 5: Test Image
# ============================================================================
FROM python-builder AS test

# Install test dependencies
RUN pip install --no-cache-dir --user \
    pytest \
    pytest-asyncio \
    pytest-cov \
    pytest-mock \
    coverage \
    factory-boy

# Install test tools
RUN apt-get update && apt-get install -y \
    postgresql-client \
    redis-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy test files
COPY data_ingestion/tests/ /build/tests/
COPY data_ingestion/pytest.ini /build/

# Set test environment
ENV PYTHONPATH=/build \
    DATABASE_URL=postgresql://test:test@timescaledb-test:5432/test_db \
    REDIS_URL=redis://redis-test:6379/1 \
    TESTING=true

WORKDIR /build

# Test entry point
ENTRYPOINT ["python", "-m", "pytest"]
CMD ["-v", "--cov=data_ingestion", "--cov-report=html", "--cov-report=term"]
# Multi-stage Dockerfile for Model Manager Service
# Handles ML model lifecycle, storage, and serving

# ============================================================================
# Stage 1: Rust Build Environment with ML Libraries
# ============================================================================
FROM rust:1.75-slim AS ml-builder

# Install ML and system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    libclang-dev \
    cmake \
    build-essential \
    curl \
    libblas-dev \
    liblapack-dev \
    libopenblas-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy dependency files
COPY Cargo.toml Cargo.lock ./
COPY vendor/ vendor/

# Create a minimal model manager binary project structure
RUN mkdir -p src/bin && echo 'fn main() { println!("Model Manager"); }' > src/bin/model-manager.rs

# Build dependencies
RUN cargo build --release --bin model-manager
RUN rm src/bin/model-manager.rs

# Copy source code for model manager
COPY src/adapters/model_storage.rs src/adapters/
COPY src/neural/ src/neural/
COPY src/integration/model_persistence_service.rs src/integration/
COPY src/bin/model-manager.rs src/bin/

# Build the model manager binary
RUN cargo build --release --bin model-manager

# Strip debug symbols
RUN strip target/release/model-manager

# ============================================================================
# Stage 2: Python ML Runtime (for Python model support)
# ============================================================================
FROM python:3.11-slim AS python-ml-runtime

# Install ML libraries and dependencies
RUN apt-get update && apt-get install -y \
    libgomp1 \
    libblas3 \
    liblapack3 \
    libopenblas0-pthread \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python ML dependencies
RUN pip install --no-cache-dir \
    numpy==1.24.3 \
    scikit-learn==1.3.0 \
    torch==2.0.1 \
    onnx==1.14.1 \
    onnxruntime==1.15.1 \
    joblib==1.3.2 \
    && pip cache purge

# ============================================================================
# Stage 3: Runtime Base
# ============================================================================
FROM debian:12-slim AS runtime-base

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    libblas3 \
    liblapack3 \
    libopenblas0-pthread \
    python3 \
    python3-distutils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r model-manager && useradd -r -g model-manager model-manager

# Create application directories
RUN mkdir -p /opt/model-manager/{models,config,logs,cache,temp} \
    && mkdir -p /var/log/model-manager \
    && chown -R model-manager:model-manager /opt/model-manager /var/log/model-manager

# ============================================================================
# Stage 4: Production Image
# ============================================================================
FROM runtime-base AS production

# Copy Rust binary
COPY --from=ml-builder /build/target/release/model-manager /usr/local/bin/model-manager

# Copy Python runtime and ML libraries
COPY --from=python-ml-runtime /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=python-ml-runtime /usr/local/bin/python3.11 /usr/local/bin/

# Create symlinks for Python
RUN ln -s /usr/local/bin/python3.11 /usr/local/bin/python3 \
    && ln -s /usr/local/bin/python3.11 /usr/local/bin/python

# Copy configuration and scripts
COPY neural-trader-config/ /opt/model-manager/config/
COPY docker/base/scripts/model-manager-entrypoint.sh /usr/local/bin/entrypoint.sh

# Set permissions
RUN chmod +x /usr/local/bin/model-manager /usr/local/bin/entrypoint.sh \
    && chown model-manager:model-manager /usr/local/bin/model-manager

# Switch to non-root user
USER model-manager

# Set working directory
WORKDIR /opt/model-manager

# Environment variables
ENV RUST_LOG=info \
    RUST_BACKTRACE=1 \
    PYTHONPATH=/usr/local/lib/python3.11/site-packages \
    CONFIG_PATH=/opt/model-manager/config \
    MODEL_STORAGE_PATH=/opt/model-manager/models \
    CACHE_PATH=/opt/model-manager/cache \
    TEMP_PATH=/opt/model-manager/temp

# Expose ports
EXPOSE 8002 9093

# Health check
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:9093/health || exit 1

# Volume mounts for model storage
VOLUME ["/opt/model-manager/models", "/opt/model-manager/cache", "/var/log/model-manager"]

# Entry point
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["model-manager"]

# ============================================================================
# Stage 5: Development Image
# ============================================================================
FROM ml-builder AS development

# Install development tools
RUN cargo install cargo-watch sccache

# Install Python development tools
RUN pip install --no-cache-dir \
    jupyter \
    matplotlib \
    seaborn \
    plotly \
    tensorboard \
    mlflow

# Install debugging tools
RUN apt-get update && apt-get install -y \
    gdb \
    valgrind \
    htop \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create development user
RUN groupadd -r developer && useradd -r -g developer developer

# Set up development environment
ENV RUSTC_WRAPPER=sccache \
    SCCACHE_DIR=/sccache \
    JUPYTER_ENABLE_LAB=yes

# Development volumes
VOLUME ["/build/src", "/build/target", "/sccache", "/notebooks"]

# Switch to development user
USER developer

WORKDIR /build

# Development entry point
ENTRYPOINT ["cargo", "watch", "-x", "run", "--bin", "model-manager"]

# ============================================================================
# Stage 6: Model Training Image
# ============================================================================
FROM python-ml-runtime AS training

# Install additional training dependencies
RUN pip install --no-cache-dir \
    wandb \
    tensorboard \
    optuna \
    hyperopt \
    ray[tune] \
    && pip cache purge

# Install system dependencies for training
RUN apt-get update && apt-get install -y \
    git \
    wget \
    unzip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create training user
RUN groupadd -r trainer && useradd -r -g trainer trainer

# Create training directories
RUN mkdir -p /opt/training/{data,models,experiments,logs} \
    && chown -R trainer:trainer /opt/training

# Switch to training user
USER trainer

WORKDIR /opt/training

# Training environment variables
ENV PYTHONUNBUFFERED=1 \
    WANDB_DIR=/opt/training/experiments \
    MLFLOW_TRACKING_URI=/opt/training/experiments/mlflow

# Volume for training data and outputs
VOLUME ["/opt/training/data", "/opt/training/models", "/opt/training/experiments"]

# Training entry point
ENTRYPOINT ["python", "-m", "neural_trader.training"]
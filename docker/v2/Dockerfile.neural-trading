# Neural Trading Service - Trading Signal Generation and Execution
FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY services/neural-trading ./services/neural-trading
COPY protos ./protos

# Build the service
WORKDIR /build/services/neural-trading
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

# Copy binary
COPY --from=builder /build/target/release/neural-trading /usr/local/bin/neural-trading

# Create working directories
RUN mkdir -p /app/strategies /app/signals /app/cache && \
    chown -R appuser:appuser /app

USER appuser
WORKDIR /app

# Environment variables
ENV RUST_LOG=info
ENV NEURAL_TRADING_PORT=50054
ENV WEBSOCKET_PORT=8080
ENV STRATEGY_PATH=/app/strategies
ENV SIGNAL_PATH=/app/signals
ENV CACHE_DIR=/app/cache
ENV RISK_MANAGEMENT=true
ENV MAX_POSITION_SIZE=10000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/neural-trading", "health"]

EXPOSE 50054 8080

ENTRYPOINT ["/usr/local/bin/neural-trading"]
CMD ["serve"]
# Neural ML-Ops Service - Machine Learning Operations
FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY services/neural-ml-ops ./services/neural-ml-ops
COPY protos ./protos

# Build the service
WORKDIR /build/services/neural-ml-ops
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies including Python for ML models
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    python3-minimal \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Python ML dependencies
RUN pip3 install --no-cache-dir \
    numpy==1.24.3 \
    pandas==2.0.3 \
    scikit-learn==1.3.0 \
    torch==2.0.1 --index-url https://download.pytorch.org/whl/cpu

# Create non-root user
RUN useradd -m -u 1000 appuser

# Copy binary
COPY --from=builder /build/target/release/neural-ml-ops /usr/local/bin/neural-ml-ops

# Create working directories
RUN mkdir -p /app/models /app/data /app/cache && \
    chown -R appuser:appuser /app

USER appuser
WORKDIR /app

# Environment variables
ENV RUST_LOG=info
ENV NEURAL_ML_OPS_PORT=50053
ENV MODEL_PATH=/app/models
ENV DATA_PATH=/app/data
ENV CACHE_DIR=/app/cache
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/usr/local/bin/neural-ml-ops", "health"]

EXPOSE 50053

ENTRYPOINT ["/usr/local/bin/neural-ml-ops"]
CMD ["serve"]
# Data Staging Service - Data Processing and Feature Engineering
FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY services/data-staging ./services/data-staging
COPY protos ./protos

# Build the service
WORKDIR /build/services/data-staging
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

# Copy binary
COPY --from=builder /build/target/release/data-staging /usr/local/bin/data-staging

# Create working directories
RUN mkdir -p /app/data /app/cache && \
    chown -R appuser:appuser /app

USER appuser
WORKDIR /app

# Environment variables
ENV RUST_LOG=info
ENV DATA_STAGING_PORT=50052
ENV REDIS_URL=redis://redis:6379
ENV TIMESCALE_URL=postgresql://postgres:postgres@timescaledb:5432/trading
ENV CACHE_DIR=/app/cache

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/data-staging", "health"]

EXPOSE 50052

ENTRYPOINT ["/usr/local/bin/data-staging"]
CMD ["serve"]
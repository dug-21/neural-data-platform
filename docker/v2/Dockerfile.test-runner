# Test Runner - Automated Testing Container
FROM rust:1.75-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    python3-pip \
    python3-venv \
    git \
    curl \
    jq \
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Python test dependencies
RUN pip3 install --no-cache-dir \
    pytest==7.4.0 \
    pytest-cov==4.1.0 \
    pytest-asyncio==0.21.1 \
    pytest-timeout==2.1.0 \
    grpcio==1.56.0 \
    grpcio-tools==1.56.0 \
    redis==4.6.0 \
    psycopg2-binary==2.9.6 \
    pyyaml==6.0.1 \
    jsonschema==4.19.0

# Install cargo test tools
RUN cargo install cargo-nextest cargo-llvm-cov

# Create test user
RUN useradd -m -u 1000 testuser

# Create test directories
RUN mkdir -p /tests /reports /fixtures && \
    chown -R testuser:testuser /tests /reports /fixtures

USER testuser
WORKDIR /tests

# Environment for testing
ENV RUST_LOG=debug
ENV TEST_TIMEOUT=300
ENV COVERAGE_THRESHOLD=70
ENV REPORT_PATH=/reports

# Entry point for test execution
COPY --chown=testuser:testuser scripts/v2/run-tests.sh /usr/local/bin/run-tests
RUN chmod +x /usr/local/bin/run-tests

ENTRYPOINT ["/usr/local/bin/run-tests"]
CMD ["all"]
# Data Ingestion Service - Python-based Market Data Collection
FROM python:3.11-slim as runtime

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash appuser

# Create app directory
WORKDIR /app

# Copy requirements first for better caching
COPY data_ingestion/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY data_ingestion/ ./

# Copy startup script
COPY scripts/v2/start-data-ingestion.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/start-data-ingestion.sh

# Create necessary directories
RUN mkdir -p /var/log/data-ingestion /var/lib/data-ingestion /app/cache && \
    chown -R appuser:appuser /app /var/log/data-ingestion /var/lib/data-ingestion

# Switch to non-root user
USER appuser

# Environment variables (defaults)
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV LOG_LEVEL=INFO
ENV UPDATE_INTERVAL=60
ENV BATCH_SIZE=100

# Health check port
ENV HEALTH_PORT=8081

# Expose ports
EXPOSE 8081 9091

# Health check - using the health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8081/health', timeout=5).raise_for_status()" || exit 1

# Use wrapper script to handle symbols and providers from environment
ENTRYPOINT ["/usr/local/bin/start-data-ingestion.sh"]
CMD []
# Mock Config-Store Service for Integration Testing
FROM python:3.11-slim

LABEL maintainer="Neural Trader Team"
LABEL description="Mock Config-Store Service for Integration Testing"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create non-root user for security
RUN groupadd -r configstore && useradd -r -g configstore configstore
RUN chown -R configstore:configstore /app

# Switch to non-root user
USER configstore

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start command
CMD ["python", "app.py"]
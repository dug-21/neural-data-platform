# Neural Trader Environment Configuration Template
# Copy this file to .env and update with your secure values
# NEVER commit .env files with real credentials to version control

# =============================================================================
# SECURITY NOTICE
# =============================================================================
# This file contains placeholder values. Replace ALL values with secure
# credentials before deployment. Use strong, unique passwords and keys.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL/TimescaleDB settings
DATABASE_URL=postgresql://neural_trader:CHANGE_THIS_PASSWORD@localhost:5432/neural_trader_db
POSTGRES_USER=neural_trader
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=neural_trader_db

# Database connection pool settings
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_TIMEOUT_SECONDS=30

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection settings
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_MAX_CONNECTIONS=100
REDIS_TIMEOUT_SECONDS=10

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment and logging
NODE_ENV=development
RUST_LOG=info
RUST_BACKTRACE=1
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application ports
APP_PORT=3030
METRICS_PORT=3031

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT and encryption keys (generate strong random values)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_and_random
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=your_encryption_key_32_characters_long_and_random
SESSION_SECRET=your_session_secret_key_minimum_32_characters_long

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=20

# =============================================================================
# API KEYS (EXTERNAL SERVICES)
# =============================================================================
# Financial data providers - get free API keys from:
# - Alpha Vantage: https://www.alphavantage.co/support/#api-key
# - Finnhub: https://finnhub.io/register
# - IEX Cloud: https://iexcloud.io/console/tokens
# - Polygon: https://polygon.io/dashboard/api-keys
# - Alpaca: https://alpaca.markets/

# Alpha Vantage Configuration
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub Configuration  
FINNHUB_API_KEY=your_finnhub_api_key_here

# Polygon.io Configuration (WebSocket Enhanced)
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_USE_DELAYED=false
POLYGON_WEBSOCKET_ENABLED=true

# IEX Cloud Configuration
IEX_CLOUD_API_KEY=your_iex_cloud_api_key_here
IEX_CLOUD_VERSION=stable
IEX_CLOUD_SANDBOX=false

# Alpaca Markets Configuration
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_SUBSCRIPTION_LEVEL=basic
ALPACA_WS_ENABLED=true
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_WS_RECONNECT_DELAY=5
ALPACA_WS_MAX_RECONNECT_ATTEMPTS=3

# Yahoo Finance Configuration
YAHOO_FINANCE_ENABLED=true

# Data Provider Settings
DEFAULT_PROVIDER=polygon
FALLBACK_PROVIDERS=["alpaca"]
ACTIVE_PROVIDERS=["polygon","alpaca"]

# API rate limiting
API_RATE_LIMIT_PER_MINUTE=60
API_CONCURRENT_REQUESTS=10
MAX_REQUESTS_PER_MINUTE=60

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Trading mode: paper, live, simulation
TRADING_MODE=paper
MAX_POSITION_SIZE=10000
RISK_LIMIT=0.02
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.10

# Portfolio management
INITIAL_BALANCE=100000
MAX_DAILY_LOSS=1000
MAX_OPEN_POSITIONS=5

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana configuration
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000

# Health check endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Email notifications for alerts
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDRESS=noreply@neuraltrader.com

# Alert email addresses
ALERT_EMAIL_CRITICAL=alerts@yourdomain.com
ALERT_EMAIL_WARNING=warnings@yourdomain.com
ALERT_EMAIL_INFO=info@yourdomain.com

# Slack notifications (optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#trading-alerts

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Backup configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_32_characters_long

# Cloud storage (optional)
AWS_S3_BACKUP_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker Compose project settings
COMPOSE_PROJECT_NAME=neural_trader
DOCKER_CLIENT_TIMEOUT=120
COMPOSE_HTTP_TIMEOUT=120

# Container resource limits
POSTGRES_MEMORY_LIMIT=4g
REDIS_MEMORY_LIMIT=2g
APP_MEMORY_LIMIT=2g

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development-specific settings (only for development environment)
DEBUG_MODE=false
DEVELOPMENT_MODE=false
HOT_RELOAD=false
MOCK_TRADING=true

# Testing configuration
TEST_DATABASE_URL=postgresql://neural_trader_test:test_password@localhost:5433/neural_trader_test
TEST_REDIS_URL=redis://localhost:6380/1

# =============================================================================
# TIMEZONE AND LOCALE
# =============================================================================
# Application timezone and locale settings
TZ=UTC
LOCALE=en_US.UTF-8
MARKET_TIMEZONE=America/New_York

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature toggles for experimental features
ENABLE_MACHINE_LEARNING=true
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_BACKTESTING=true
ENABLE_WEBSOCKET_STREAMING=true
ENABLE_ADVANCED_ANALYTICS=true

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Application performance settings
WORKER_THREADS=4
MAX_CONCURRENT_TRADES=10
CACHE_TTL_SECONDS=300
BATCH_SIZE=1000
PROCESSING_INTERVAL_SECONDS=60

# Database performance
DATABASE_POOL_SIZE=20
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_IDLE_TIMEOUT_SECONDS=600

# Redis performance
REDIS_POOL_SIZE=10
REDIS_COMMAND_TIMEOUT_SECONDS=5

# =============================================================================
# SECURITY HEADERS AND POLICIES
# =============================================================================
# Security policy configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CSRF_PROTECTION=true
SECURE_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'

# Session configuration
SESSION_TIMEOUT_MINUTES=30
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Detailed logging configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_DATABASE=WARN
LOG_LEVEL_TRADING=INFO
LOG_LEVEL_API=INFO
LOG_LEVEL_SECURITY=WARN

# Log file settings
LOG_FILE_PATH=/app/logs/neural_trader.log
LOG_FILE_MAX_SIZE=100MB
LOG_FILE_MAX_FILES=10
LOG_ROTATION_ENABLED=true

# =============================================================================
# EXTERNAL DRIVE MOUNTING CONFIGURATION
# =============================================================================
# Configuration for mounting external drives containing historical data
# Set EXTERNAL_DATA_ENABLED=true to enable external drive mounting
EXTERNAL_DATA_ENABLED=false

# Host system path to the external drive/directory
# Examples:
# - USB drive on Linux: /media/username/drive-name
# - USB drive on macOS: /Volumes/drive-name
# - Network share: /mnt/network-share
# - Local directory: /home/username/trading-data
EXTERNAL_MOUNT_PATH=/mnt/external

# Container path where the external data will be mounted
# This path will be accessible inside the container
EXTERNAL_DATA_PATH=/mnt/external-data

# Mount options (optional)
# Set to 'ro' for read-only access (recommended for safety)
# Set to 'rw' for read-write access (use with caution)
EXTERNAL_MOUNT_MODE=ro

# File permissions for mounted data (optional)
# User ID that should own the mounted files inside container
EXTERNAL_DATA_UID=1000
# Group ID that should own the mounted files inside container
EXTERNAL_DATA_GID=1000

# =============================================================================
# SAMPLE SECURE VALUE GENERATION
# =============================================================================
# Use these commands to generate secure values:
#
# Strong passwords (32 characters):
# openssl rand -base64 32
#
# JWT secrets (64 characters):
# openssl rand -base64 64
#
# Encryption keys (32 bytes for AES-256):
# openssl rand -hex 32
#
# UUIDs for session secrets:
# uuidgen
#
# Random alphanumeric strings:
# openssl rand -base64 48 | tr -d "=+/" | cut -c1-32
# Neural Trader Environment Configuration
# Copy this to .env and customize for your environment

# ==============================================================================
# GITOPS CONFIGURATION (Portable across all environments)
# ==============================================================================

# Option 1: Use embedded configs (fastest for development)
CONFIG_MODE=embedded

# Option 2: Use external Git repository (recommended for staging/production)
# CONFIG_MODE=gitops
# CONFIG_REPO_URL=https://github.com/your-org/neural-trader-configs.git
# CONFIG_BRANCH=main
# CONFIG_SYNC_INTERVAL=60s

# Option 3: Use local Git daemon (for local development with Git workflow)
# CONFIG_MODE=gitops  
# CONFIG_REPO_URL=git://host.docker.internal:9418/neural-trader
# CONFIG_BRANCH=dev

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

ENABLE_AUTONOMOUS_TRAINING=true
ENABLE_SECTOR_MODELS=true
ENABLE_REALTIME_ADAPTATION=true
ENABLE_DATA_DISCOVERY=true

# ==============================================================================
# CONFIGURATION PATHS
# ==============================================================================

SECTOR_CONFIG_PATH=config/sector_models.toml
AUTONOMOUS_TRAINING_CONFIG=config/autonomous_training.toml
DATA_REQUIREMENTS_CONFIG=config/data_requirements.toml

# ==============================================================================
# ENVIRONMENT SETTINGS
# ==============================================================================

CONFIG_ENV=dev
BUILD_ID=latest
RUST_LOG=info
LOG_LEVEL=info

# ==============================================================================
# DATABASE SETTINGS
# ==============================================================================

# Primary Database
DATABASE_URL=postgres://postgres:postgres@timescaledb:5432/neural_trader
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=neural_trader

# Redis Cache
REDIS_URL=redis://redis:6379

# ==============================================================================
# API KEYS (Required for trading)
# ==============================================================================

# Alpaca Trading API
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Polygon.io Market Data
POLYGON_API_KEY=

# IEX Cloud
IEX_TOKEN=

# ==============================================================================
# SERVICE SETTINGS
# ==============================================================================

# Trading Mode
TRADING_MODE=paper  # paper, live, backtest

# Service Ports (change if conflicts exist)
CONFIG_STORE_PORT=50051
DATA_INGESTION_PORT=50052
DATA_STAGING_PORT=50053
ML_OPS_PORT=50054
TRADING_PORT=50055

# ==============================================================================
# MONITORING
# ==============================================================================

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
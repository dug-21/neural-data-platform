{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config Store Configuration Schema",
  "type": "object",
  "required": ["service", "server"],
  "properties": {
    "service": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "server": {
      "type": "object",
      "required": ["grpc"],
      "properties": {
        "grpc": {
          "type": "object",
          "required": ["port"],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "max_connections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "health": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/.*$"
            }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "sync_interval": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "branch": {
          "type": "string"
        },
        "shallow_clone": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "db": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "cache_ttl": {
          "type": "integer",
          "minimum": 0
        },
        "key_prefix": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "strict_mode": {
          "type": "boolean"
        }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"]
        },
        "format": {
          "type": "string",
          "enum": ["json", "text", "pretty"]
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          }
        }
      }
    }
  }
}
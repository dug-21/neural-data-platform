{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-data-platform.local/schemas/manifest.schema.json",
  "title": "Deployment Manifest",
  "description": "Declarative deployment manifest for Neural Data Platform. Supports stream sync, Silver table DDL, migrations, dimensions, dictionary, and container operations.",
  "type": "object",
  "required": ["version", "changes"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Manifest schema version"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this deployment manifest"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/declaration"
      },
      "description": "Ordered list of deployment changes to execute"
    }
  },
  "$defs": {
    "declaration": {
      "description": "A single deployment declaration. Type determines required and optional properties.",
      "oneOf": [
        { "$ref": "#/$defs/stream_declaration" },
        { "$ref": "#/$defs/silver_table_declaration" },
        { "$ref": "#/$defs/migration_declaration" },
        { "$ref": "#/$defs/dimensions_declaration" },
        { "$ref": "#/$defs/dictionary_declaration" },
        { "$ref": "#/$defs/container_declaration" }
      ]
    },
    "stream_declaration": {
      "type": "object",
      "description": "Sync stream configuration to etcd registry",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "stream",
          "description": "Declaration type: stream configuration sync"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stream identifier (kebab-case, starts with letter)"
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "validate-only"],
          "default": "update",
          "description": "Action to perform: create (fail if exists), update (upsert), validate-only (dry run)"
        },
        "reload": {
          "type": "string",
          "enum": ["sources", "full", "none"],
          "default": "none",
          "description": "Reload behavior after sync: sources (hot-reload sources), full (restart app), none (no reload)"
        }
      }
    },
    "silver_table_declaration": {
      "type": "object",
      "description": "Generate and apply Silver table DDL from stream config",
      "required": ["type", "stream_id"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "silver-table",
          "description": "Declaration type: Silver table DDL generation"
        },
        "stream_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stream identifier to generate Silver DDL from"
        },
        "action": {
          "type": "string",
          "enum": ["sync", "validate-only"],
          "default": "sync",
          "description": "Action to perform: sync (apply DDL), validate-only (dry run)"
        }
      }
    },
    "migration_declaration": {
      "type": "object",
      "description": "Execute SQL migration file",
      "required": ["type", "file"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "migration",
          "description": "Declaration type: SQL migration execution"
        },
        "file": {
          "type": "string",
          "pattern": "^migrations/.*\\.sql$",
          "description": "Path to migration SQL file (must be in migrations/ directory)"
        }
      }
    },
    "dimensions_declaration": {
      "type": "object",
      "description": "Sync dimension CSV files to Silver layer",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "dimensions",
          "description": "Declaration type: dimension table sync"
        },
        "action": {
          "type": "string",
          "enum": ["sync"],
          "default": "sync",
          "description": "Action to perform: sync (upsert dimension data)"
        }
      }
    },
    "dictionary_declaration": {
      "type": "object",
      "description": "Sync data dictionary from stream configurations",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "dictionary",
          "description": "Declaration type: data dictionary sync"
        },
        "action": {
          "type": "string",
          "enum": ["sync"],
          "default": "sync",
          "description": "Action to perform: sync (generate dictionary from configs)"
        }
      }
    },
    "container_declaration": {
      "type": "object",
      "description": "Build or restart Docker container",
      "required": ["type", "target", "action"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "container",
          "description": "Declaration type: container operation"
        },
        "target": {
          "type": "string",
          "enum": ["air-quality-app", "ndp-mcp-server", "silver-etl", "grafana"],
          "description": "Container target to operate on"
        },
        "action": {
          "type": "string",
          "enum": ["build", "restart"],
          "description": "Action to perform: build (rebuild image), restart (restart container)"
        },
        "no_cache": {
          "type": "boolean",
          "default": false,
          "description": "If true, build without Docker cache (only applies to build action)"
        }
      }
    }
  }
}

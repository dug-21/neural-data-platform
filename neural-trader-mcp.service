[Unit]
Description=Neural Trader MCP Server
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=neural-trader
WorkingDirectory=/opt/neural-trader
Environment="DATABASE_URL=postgresql://neural_trader:${POSTGRES_PASSWORD}@localhost:5432/neural_trader_db"
Environment="REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379"
ExecStart=/opt/neural-trader/target/release/mcp_server_simple
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
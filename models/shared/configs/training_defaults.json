{
  "default_training_config": {
    "learning_rate": 0.7,
    "max_epochs": 1000,
    "desired_error": 0.001,
    "training_algorithm": "RPROP",
    "activation_functions": {
      "hidden": "SIGMOID_SYMMETRIC",
      "output": "LINEAR"
    },
    "validation_split": 0.2,
    "test_split": 0.1,
    "early_stopping": {
      "enabled": true,
      "patience": 50,
      "min_delta": 0.0001
    }
  },
  "model_architectures": {
    "prediction": {
      "input_neurons": 10,
      "hidden_layers": [20, 10],
      "output_neurons": 1
    },
    "momentum": {
      "input_neurons": 15,
      "hidden_layers": [30, 15],
      "output_neurons": 3
    },
    "reversal": {
      "input_neurons": 12,
      "hidden_layers": [25, 12],
      "output_neurons": 2
    }
  },
  "feature_sets": {
    "prediction": [
      "price_change_5m",
      "volume_ratio",
      "rsi_14",
      "macd_signal",
      "bollinger_position",
      "momentum_10",
      "volatility_20", 
      "support_resistance",
      "market_regime",
      "time_of_day"
    ],
    "momentum": [
      "price_momentum_1m",
      "price_momentum_5m",
      "price_momentum_15m",
      "volume_momentum",
      "rsi_momentum",
      "macd_momentum",
      "volatility_momentum",
      "market_breadth",
      "sector_momentum",
      "correlation_spy",
      "vix_level",
      "time_weighted_momentum",
      "acceleration",
      "momentum_divergence",
      "regime_momentum"
    ],
    "reversal": [
      "overbought_oversold",
      "divergence_indicators",
      "support_resistance_touch",
      "volume_spike",
      "volatility_expansion",
      "mean_reversion_signal",
      "fibonacci_levels",
      "pattern_recognition",
      "sentiment_extremes",
      "options_flow",
      "institutional_activity",
      "reversal_confirmation"
    ]
  }
}
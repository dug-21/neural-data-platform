# Ignore model binary files
*.rvf
*.rvf.sig
*.rvf.bak

# Ignore checkpoint files
checkpoints/

# Ignore large artifacts
artifacts/*.png
artifacts/*.jpg
artifacts/*.pdf
artifacts/*.h5

# Ignore backup directory contents
.backups/

# Ignore cache
.cache/
*.cache

# Ignore temporary files
*.tmp
*.temp
*.log

# Ignore compression files
*.tar
*.tar.gz
*.tar.zst
*.zip

# Keep directory structure
!.gitkeep
!*/
!.templates/
!.metadata/

# Keep documentation and configuration
!*.md
!*.json
!*.yaml
!*.toml

# Ignore sensitive files
*.key
*.pem
*.cert
*.crt
{
  "manifest_version": "1.0",
  "symbol": "{{ symbol }}",
  "model_type": "{{ model_type }}",
  "version": "{{ version }}",
  "created_at": "{{ timestamp }}",
  "files": {
    "model": {
      "filename": "model.rvf",
      "size_bytes": {{ model_size }},
      "checksum": "{{ model_checksum }}",
      "compression": "{{ compression_type }}",
      "format": "ruv-fann"
    },
    "metadata": {
      "filename": "metadata.json",
      "size_bytes": {{ metadata_size }},
      "checksum": "{{ metadata_checksum }}"
    },
    "config": {
      "filename": "config.json",
      "size_bytes": {{ config_size }},
      "checksum": "{{ config_checksum }}"
    },
    "performance": {
      "filename": "performance.json",
      "size_bytes": {{ performance_size }},
      "checksum": "{{ performance_checksum }}"
    },
    "features": {
      "filename": "features.json", 
      "size_bytes": {{ features_size }},
      "checksum": "{{ features_checksum }}"
    }
  },
  "checkpoints": [
    {
      "epoch": {{ epoch }},
      "filename": "checkpoints/checkpoint_{{ epoch }}.rvf",
      "size_bytes": {{ checkpoint_size }},
      "checksum": "{{ checkpoint_checksum }},
      "metrics": {
        "loss": {{ checkpoint_loss }},
        "val_loss": {{ checkpoint_val_loss }}
      }
    }
  ],
  "artifacts": [
    {
      "type": "training_log",
      "filename": "artifacts/training_log.jsonl",
      "size_bytes": {{ log_size }},
      "checksum": "{{ log_checksum }}"
    },
    {
      "type": "validation_curves",
      "filename": "artifacts/validation_curves.png",
      "size_bytes": {{ curves_size }},
      "checksum": "{{ curves_checksum }}"
    },
    {
      "type": "feature_importance", 
      "filename": "artifacts/feature_importance.json",
      "size_bytes": {{ importance_size }},
      "checksum": "{{ importance_checksum }}"
    }
  ],
  "dependencies": {
    "parent_model": "{{ parent_version }}",
    "shared_components": [
      {
        "type": "feature_extractor",
        "path": "shared/feature_extractors/{{ extractor_version }}",
        "checksum": "{{ extractor_checksum }}"
      }
    ]
  },
  "validation": {
    "validated_at": "{{ validation_timestamp }}",
    "validation_passed": {{ validation_passed }},
    "validation_report": "{{ validation_report_path }}"
  },
  "deployment_readiness": {
    "production_ready": {{ production_ready }},
    "requirements_met": {
      "performance_threshold": {{ performance_met }},
      "stability_tests": {{ stability_met }},
      "integration_tests": {{ integration_met }}
    },
    "blockers": {{ blockers }}
  },
  "changelog": [
    {
      "version": "{{ version }}",
      "date": "{{ date }}",
      "changes": {{ changes }},
      "author": "{{ author }}"
    }
  ]
}
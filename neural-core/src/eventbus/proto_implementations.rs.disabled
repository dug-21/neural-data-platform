//! ProtoMessage implementations for generated protobuf types
//!
//! This module provides ProtoMessage trait implementations for all
//! generated protobuf types used in the EventBus system.

use crate::eventbus::types::ProtoMessage;
use crate::eventbus::error::EventBusError;

// Import the generated proto types
use crate::proto::EventEnvelope;

/// Implementation of ProtoMessage for EventEnvelope
impl ProtoMessage for EventEnvelope {
    fn proto_type_name() -> &'static str {
        "neural_trader.interfaces.ingestion.EventEnvelope"
    }
    
    fn validate(&self) -> Result<(), EventBusError> {
        // Validate required fields
        if self.message_id.is_empty() {
            return Err(EventBusError::schema_validation("message_id is required"));
        }
        
        if self.source.is_empty() {
            return Err(EventBusError::schema_validation("source is required"));
        }
        
        if self.domain.is_empty() {
            return Err(EventBusError::schema_validation("domain is required"));
        }
        
        if self.event_type.is_empty() {
            return Err(EventBusError::schema_validation("event_type is required"));
        }
        
        // Validate timestamps
        if let Some(created_at) = &self.created_at {
            if created_at.seconds < 0 {
                return Err(EventBusError::schema_validation("created_at must be positive"));
            }
        }
        
        // Validate quality metadata if present
        if let Some(quality) = &self.quality {
            if quality.completeness < 0.0 || quality.completeness > 100.0 {
                return Err(EventBusError::schema_validation("completeness must be 0-100"));
            }
            
            if quality.quality_score < 0.0 || quality.quality_score > 100.0 {
                return Err(EventBusError::schema_validation("quality_score must be 0-100"));
            }
        }
        
        // Validate routing metadata if present
        if let Some(routing) = &self.routing {
            if routing.priority < 0 || routing.priority > 9 {
                return Err(EventBusError::schema_validation("priority must be 0-9"));
            }
            
            if routing.ttl_seconds < 0 {
                return Err(EventBusError::schema_validation("ttl_seconds must be non-negative"));
            }
        }
        
        Ok(())
    }
}


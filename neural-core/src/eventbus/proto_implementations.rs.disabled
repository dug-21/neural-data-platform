#[cfg(test)]
mod tests {
    use super::*;
    use prost_types::Timestamp;
    use crate::proto::{QualityMetadata, RoutingMetadata};
    
    #[test]
    fn test_event_envelope_validation() {
        let mut envelope = EventEnvelope {
            message_id: "test-123".to_string(),
            correlation_id: "corr-456".to_string(),
            source: "test-source".to_string(),
            domain: "test-domain".to_string(),
            event_type: "TestEvent".to_string(),
            schema_version: "1.0".to_string(),
            created_at: Some(Timestamp { seconds: 1693843200, nanos: 0 }),
            ingested_at: None,
            routing: None,
            quality: None,
            payload: None,
            headers: std::collections::HashMap::new(),
            tracing: None,
        };
        
        // Valid envelope should pass
        assert!(envelope.validate().is_ok());
        
        // Empty message_id should fail
        envelope.message_id = "".to_string();
        assert!(envelope.validate().is_err());
        envelope.message_id = "test-123".to_string();
        
        // Invalid quality metadata should fail
        envelope.quality = Some(QualityMetadata {
            completeness: 150.0, // Invalid - should be 0-100
            latency_ms: 100,
            validation_status: 0,
            quality_score: 80.0,
            anomalies: vec![],
        });
        assert!(envelope.validate().is_err());
        
        // Fix quality and test routing
        envelope.quality = Some(QualityMetadata {
            completeness: 95.0,
            latency_ms: 100,
            validation_status: 1,
            quality_score: 80.0,
            anomalies: vec![],
        });
        
        envelope.routing = Some(RoutingMetadata {
            topic: "test-topic".to_string(),
            partition_key: "test-key".to_string(),
            priority: 15, // Invalid - should be 0-9
            ttl_seconds: 3600,
            tags: vec![],
            retry_policy: None,
        });
        assert!(envelope.validate().is_err());
    }
    
    #[test]
    fn test_proto_type_name() {
        assert_eq!(EventEnvelope::proto_type_name(), "neural_trader.interfaces.ingestion.EventEnvelope");
    }
}